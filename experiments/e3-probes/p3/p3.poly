module p3

enum St { Idle, Fetching, Done, Failed }

machine Tool {
  state { st : St = Idle }
  terminal st in { Done, Failed }
  action Go()
  action Got()
  action Lost()
  on Go { require st == Idle else reject "not-idle"  st' = Fetching  emit fetch() }
  on Got { require st == Fetching else reject "not-fetching"  st' = Done }
  on Lost { require st == Fetching else reject "not-fetching"  st' = Failed }
  effect fetch() {
    kind "harness.fetch"
    labels { egress:external }
    targets { egress: exact "https://example.com/data" }
    ok -> Got()
    failed -> Lost()
  }
}
