module p1

enum Stop { End, Tool, Length }
enum St { Idle, Thinking, Observing, Done, Failed }

machine Session {
  state { st : St = Idle  reprompts : 0..2 = 0  stop : Stop = End }
  terminal st in { Done, Failed }
  action Go(task: Content)
  action Stepped(calls: Content, conf: Conf)
  action Metered(s: Stop)
  action Lost()
  action Ran()
  on Go(task) {
    require st == Idle else reject "not-idle"
    st' = Thinking
    decide agent(task)
  }
  on Metered(s) {
    require st == Thinking else reject "not-thinking"
    stop' = s
  }
  on Stepped(calls, conf) {
    require st == Thinking else reject "not-thinking"
    st' = Observing
    emit run(calls: calls)
  }
  on Ran {
    require st == Observing else reject "not-observing"
    st' = Done
    emit endStep()
  }
  on Lost {
    require st == Thinking else reject "not-thinking"
    st' = Failed
  }
  decision agent(task: Content) -> Content {
    provider "main"
    prices "prices/main.json" max input tokens 2000 max tokens 4000 budget task
    labels { egress:external, read:private }
    timeout 2s
    ok(r) -> Stepped(calls: r.answer, conf: r.conf)
    failed -> Lost()
  }
  effect run(calls: Content) {
    kind "harness.run"
    labels { read:private }
    ok -> Ran()
    failed -> Lost()
  }
  effect endStep() {
    kind "harness.endStep"
    labels { read:private }
    ok -> Ran()
    failed -> Lost()
  }
  never cutoff-recovers: emit endStep() while stop == Length && reprompts < 1
}

budget task {
  cap usd 1 per run
  cap usd 25 per month per scope
}
