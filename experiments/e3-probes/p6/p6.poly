module p6
enum M { Working, Compacting }
machine C {
  state { mode : M = Working  fin : bool = false  ctx : 0..6 = 0  n : 0..2 = 0 }
  action Grew(by: 0..2)
  action Fin()
  action Measured(context: Content)
  action Summarised(text: Content, conf: Conf, margin: Conf)
  action Failed()
  on Grew(by) { require mode is Working else reject "w"  if ctx + by > 6 { ctx' = 6 } else { ctx' = ctx + by } }
  on Fin { require mode is Working && !fin else reject "w"  fin' = true }
  on Measured(context) {
    require mode is Working else reject "w"
    if fin && ctx > 2 {
      mode' = Compacting
      decide summarise(context: context)
    } else {
      n' = 1
    }
  }
  on Summarised(text, conf, margin) { require mode is Compacting else reject "c"  mode' = Working  ctx' = 2 }
  on Failed { require mode is Compacting else reject "c"  mode' = Working }
  decision summarise(context: Content) -> Content {
    provider "main"
    prices "prices/main.json" max input tokens 1000 max tokens 400 budget b
    labels { egress:external, read:private }
    timeout 60s
    ok(r) -> Summarised(text: r.answer, conf: r.conf, margin: r.margin)
    failed -> Failed()
  }
  never gate: emit summarise() while !fin && ctx < 5
}
budget b { cap usd 1 per run }
