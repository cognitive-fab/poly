// P1, book loans: one Book machine per book id, created by add.
module library

enum Status { unadded, available, lent, retired }

machine Book {
  state {
    status : Status = unadded
    loans  : 0..3   = 0
    renewed : bool  = false
  }
  terminal status == retired

  action Add()
  action Lend()
  action GiveBack()
  action Retire()
  action Renew()

  on Add {
    require status == unadded else reject "exists"
    status' = available
  }
  on Lend {
    require status == available else reject "not-available"
    require loans < 3 else reject "loan-limit"
    status' = lent
    loans' = loans + 1
  }
  on GiveBack {
    require status == lent else reject "not-lent"
    status' = available
    renewed' = false
  }
  on Renew {
    require status == lent else reject "not-lent"
    require !renewed else reject "already-renewed"
    renewed' = true
  }
  on Retire {
    require status == available else reject "not-available"
    status' = retired
  }

  invariant unadded-never-lent: status == unadded implies loans == 0
}
