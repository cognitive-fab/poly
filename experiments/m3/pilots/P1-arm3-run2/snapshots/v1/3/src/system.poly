// Book loans: one Book instance per book id, created by add.
module loans

type Status = fresh | available | lent | retired

machine Book {
  state {
    status : Status = fresh
    loans  : 0..3   = 0
    renewed : bool  = false
  }
  action Add()
  action Lend()
  action GiveBack()
  action Retire()
  action Renew()

  on Add {
    require status is fresh else reject "already-exists"
    status' = available
  }
  on Lend {
    require status is available else reject "not-available"
    require loans < 3 else reject "loan-limit-reached"
    status' = lent
    loans' = loans + 1
  }
  on GiveBack {
    require status is lent else reject "not-lent"
    status' = available
    renewed' = false
  }
  on Renew {
    require status is lent else reject "not-lent"
    require not renewed else reject "already-renewed"
    renewed' = true
  }
  on Retire {
    require status is available else reject "not-available"
    status' = retired
  }

  terminal status is retired

  invariant fresh-has-no-loans: status is fresh implies loans == 0
  invariant lent-was-loaned: status is lent implies loans >= 1
}
