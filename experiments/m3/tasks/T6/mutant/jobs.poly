// T6 mutant: a job whose last try failed is queued again, which the brief rules out.
module jobs

enum Status { unset, queued, running, cancelling, succeeded, failed, cancelled }

machine Job {
  state {
    status   : Status = unset
    tries    : 0..3 = 0
    maxTries : 0..3 = 0
  }
  terminal status in { succeeded, failed, cancelled }

  action Submit(maxTries: int check { 1, 2, 3 } strict)
  action Claim()
  action Succeed()
  action Fail()
  action Cancel()

  on Submit(maxTries) {
    require status == unset else reject "exists"
    status' = queued
    maxTries' = maxTries
  }
  on Claim {
    require status == queued else reject "not-queued"
    status' = running
    tries' = tries + 1
  }
  on Succeed {
    require status in { running, cancelling } else reject "not-running"
    status' = succeeded
  }
  on Fail {
    require status in { running, cancelling } else reject "not-running"
    if status == cancelling {
      status' = cancelled
    } else {
      if tries <= maxTries {
        status' = queued
      } else {
        status' = failed
      }
    }
  }
  on Cancel {
    require status in { queued, running } else reject "not-cancellable"
    if status == queued {
      status' = cancelled
    } else {
      status' = cancelling
    }
  }

  invariant tries-within-limit: tries <= maxTries
  invariant failed-only-after-the-last-try: status == failed implies tries == maxTries
  invariant queued-jobs-have-a-try-left: status == queued implies tries < maxTries
  invariant succeeded-was-tried: status == succeeded implies tries >= 1
}
