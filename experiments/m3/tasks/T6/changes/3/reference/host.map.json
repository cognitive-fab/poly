{
  "module": "jobs",
  "instances": {
    "job": {
      "machine": "Job",
      "createdBy": "submit",
      "keyArgument": "job"
    }
  },
  "methods": {
    "submit": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Submit",
      "params": {
        "maxTries": "$arg:maxTries"
      }
    },
    "claim": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Claim"
    },
    "succeed": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Succeed"
    },
    "fail": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Fail"
    },
    "lost": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Fail"
    },
    "cancel": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Cancel"
    },
    "hold": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Hold"
    },
    "release": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Release"
    },
    "failPermanently": {
      "instance": "job",
      "key": "$arg:job",
      "action": "FailPermanently"
    },
    "resubmit": {
      "instance": "job",
      "key": "$arg:job",
      "action": "Resubmit"
    }
  },
  "queries": {
    "job": {
      "instance": "job",
      "key": "$arg:job",
      "fields": {
        "status": "status",
        "tries": "tries",
        "maxTries": "maxTries"
      }
    }
  }
}
