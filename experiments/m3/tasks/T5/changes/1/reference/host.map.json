{
  "module": "runs",
  "instances": {
    "run": {
      "machine": "Run",
      "createdBy": "start",
      "keyArgument": "run"
    }
  },
  "methods": {
    "start": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Start"
    },
    "taskStarted": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Report",
      "params": {
        "task": "$arg:task",
        "status": "running"
      }
    },
    "taskCompleted": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Report",
      "params": {
        "task": "$arg:task",
        "status": "completed"
      }
    },
    "taskFailed": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Report",
      "params": {
        "task": "$arg:task",
        "status": "failed"
      }
    },
    "taskEvicted": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Report",
      "params": {
        "task": "$arg:task",
        "status": "evicted"
      }
    },
    "taskRequeued": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Report",
      "params": {
        "task": "$arg:task",
        "status": "queued"
      }
    },
    "cancel": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Cancel"
    },
    "taskRetried": {
      "instance": "run",
      "key": "$arg:run",
      "action": "Retry",
      "params": {
        "task": "$arg:task"
      }
    }
  },
  "queries": {
    "run": {
      "instance": "run",
      "key": "$arg:run",
      "fields": {
        "status": "derived",
        "task0": "t0",
        "task1": "t1",
        "task2": "t2"
      }
    }
  }
}
