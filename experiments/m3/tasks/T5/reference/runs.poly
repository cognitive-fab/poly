// T5 reference: a workflow run's status derived from its three tasks, as hatchet derives it.
module runs

enum Status { unset, queued, running, evicted, completed, failed, cancelled }

machine Run {
  state {
    derived : Status = unset
    t0      : Status = unset
    t1      : Status = unset
    t2      : Status = unset
  }
  terminal derived in { completed, failed, cancelled }

  action Start()
  action Report(task: 0..2, status: Status)
  action Cancel()

  on Start {
    require derived == unset else reject "exists"
    derived' = queued
    t0' = queued
    t1' = queued
    t2' = queued
  }

  // The new statuses are the old ones with task `task` set to `status`. Expressions read the pre-state
  // (PS2.3), so the new status of task i is `status` when `task == i`, and ti otherwise.
  on Report(task, status) {
    require derived != unset else reject "unknown"
    let was = task == 0 && t0 == running || task == 1 && t1 == running || task == 2 && t2 == running
    let wasQueued = task == 0 && t0 == queued || task == 1 && t1 == queued || task == 2 && t2 == queued
    let wasEvicted = task == 0 && t0 == evicted || task == 1 && t1 == evicted || task == 2 && t2 == evicted
    require status == running && wasQueued || status in { completed, failed, evicted } && was || status == queued && wasEvicted else reject "bad-transition"
    let uniform = (task == 0 || t0 == status) && (task == 1 || t1 == status) && (task == 2 || t2 == status)
    let anyFailed = status == failed || task != 0 && t0 == failed || task != 1 && t1 == failed || task != 2 && t2 == failed
    let anyInFlight = status in { queued, running, evicted } || task != 0 && t0 in { queued, running, evicted } || task != 1 && t1 in { queued, running, evicted } || task != 2 && t2 in { queued, running, evicted }
    if uniform {
      derived' = status
    } else {
      if anyFailed {
        derived' = failed
      } else {
        if anyInFlight {
          derived' = running
        } else {
          derived' = cancelled
        }
      }
    }
    if task == 0 {
      t0' = status
    } else {
      if task == 1 {
        t1' = status
      } else {
        t2' = status
      }
    }
  }

  on Cancel {
    require derived != unset else reject "unknown"
    require t0 in { queued, running, evicted } || t1 in { queued, running, evicted } || t2 in { queued, running, evicted } else reject "nothing-in-flight"
    if t0 in { queued, running, evicted } { t0' = cancelled }
    if t1 in { queued, running, evicted } { t1' = cancelled }
    if t2 in { queued, running, evicted } { t2' = cancelled }
    if t0 == failed || t1 == failed || t2 == failed {
      derived' = failed
    } else {
      derived' = cancelled
    }
  }

  invariant completed-only-when-every-task-completed: derived == completed implies t0 == completed && t1 == completed && t2 == completed
  invariant failed-whenever-a-task-failed: t0 == failed || t1 == failed || t2 == failed implies derived == failed
  invariant final-only-when-nothing-in-flight: derived in { completed, cancelled } implies !(t0 in { queued, running, evicted } || t1 in { queued, running, evicted } || t2 in { queued, running, evicted })
}
