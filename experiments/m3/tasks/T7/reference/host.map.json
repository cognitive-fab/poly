{
  "module": "workflow",
  "instances": {
    "run": { "machine": "Run", "init": { "w0": "worker0", "w1": "worker1" } },
    "worker0": { "machine": "Worker", "init": { "run": "run", "task": 0 } },
    "worker1": { "machine": "Worker", "init": { "run": "run", "task": 1 } }
  },
  "methods": {
    "start": { "instance": "run", "action": "Start" },
    "cancel": { "instance": "run", "action": "Cancel" },
    "workDone": { "instance": "$arg:worker", "machine": "Worker", "action": "WorkDone" },
    "workFailed": { "instance": "$arg:worker", "machine": "Worker", "action": "WorkFailed" }
  },
  "queries": {
    "run": { "instance": "run", "fields": { "status": "status", "task0": "t0", "task1": "t1" } },
    "worker": { "instance": "$arg:worker", "machine": "Worker", "fields": { "status": "status" } }
  }
}
