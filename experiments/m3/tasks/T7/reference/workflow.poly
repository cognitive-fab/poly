// T7 reference: a run whose two tasks are done by two workers, which report by message.
module workflow

enum Status { idle, busy, running, cancelling, assigned, completed, failed, cancelled }

machine Run {
  state {
    status : Status = idle
    t0     : Status = idle
    t1     : Status = idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
  }
  terminal status in { completed, failed, cancelled }

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: Status)

  on Start {
    require status == idle else reject "started"
    status' = running
    t0' = assigned
    t1' = assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }
  on Cancel {
    require status == running else reject "not-running"
    status' = cancelling
    if t0 == assigned {
      send w0 <- Abort()
    }
    if t1 == assigned {
      send w1 <- Abort()
    }
  }
  // The new task statuses are the old ones with the reporting worker's task set to `outcome` (PS2.3).
  on Report(task, outcome) {
    require status in { running, cancelling } else reject "closed"
    require outcome in { completed, failed, cancelled } else reject "bad-outcome"
    let first = task == 0 && t0 == assigned
    let second = task == 1 && t1 == assigned
    require first || second else reject "unexpected"
    let both = (first || t0 != assigned) && (second || t1 != assigned)
    let allCompleted = outcome == completed && (first || t0 == completed) && (second || t1 == completed)
    let anyFailed = outcome == failed || t0 == failed || t1 == failed
    if first {
      t0' = outcome
    } else {
      t1' = outcome
    }
    if both {
      if allCompleted {
        status' = completed
      } else {
        if anyFailed {
          status' = failed
        } else {
          status' = cancelled
        }
      }
    }
  }

  invariant completed-only-when-both-completed: status == completed implies t0 == completed && t1 == completed
  invariant ended-only-when-both-reported: status in { completed, failed, cancelled } implies t0 != assigned && t1 != assigned
}

service machine Worker {
  state {
    status : Status = idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }
  action Assign()
  action Abort()
  action WorkDone()
  action WorkFailed()

  on Assign {
    require status == idle else reject "busy"
    status' = busy
  }
  on Abort {
    require status == busy else reject "idle"
    status' = idle
    send run <- Report(task: task, outcome: cancelled)
  }
  on WorkDone {
    require status == busy else reject "idle"
    status' = idle
    send run <- Report(task: task, outcome: completed)
  }
  on WorkFailed {
    require status == busy else reject "idle"
    status' = idle
    send run <- Report(task: task, outcome: failed)
  }

  invariant a-worker-is-idle-or-busy: status in { idle, busy }
}

configuration flow {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { run: run }
  worker1 : Worker { run: run, task: 1 }
  inputs  { run.Start, run.Cancel, worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 4 }
  invariant completed-only-when-both-workers-completed: run.status == completed implies run.t0 == completed && run.t1 == completed
  invariant busy-workers-have-assigned-tasks: worker0.status == busy implies run.t0 == assigned
}
