// T8 reference: one consensus node's role and term, as the raft field study has them, with terms up to 3.
module node

enum Role { follower, candidate, leader, shutdown }

machine Node {
  state {
    role : Role = follower
    term : 0..3 = 0
  }
  terminal role == shutdown

  action ElectionTimeout()
  action ElectionWon()
  action NewerTermSeen(term: 1..3)
  action QuorumLost()
  action Shutdown()

  on ElectionTimeout {
    require role in { follower, candidate } else reject "leader"
    require pre.term < 3 else reject "term-limit"
    role' = candidate
    term' = pre.term + 1
  }
  on ElectionWon {
    require role == candidate else reject "not-candidate"
    role' = leader
  }
  on NewerTermSeen(term) {
    require term > pre.term else reject "stale-term"
    role' = follower
    term' = term
  }
  on QuorumLost {
    require role == leader else reject "not-leader"
    role' = follower
  }
  on Shutdown {
    role' = shutdown
  }

  step property term-never-decreases: post.term >= pre.term
  step property leader-was-candidate: post.role == leader implies pre.role == leader || pre.role == candidate
  invariant leaders-were-elected: role == leader implies term >= 1
}
