// T2 mutant after change 2: a closed inventory still reserves units, which the brief rules out.
module shop

service machine Inventory {
  state {
    available : 0..3 = 1
    reserved  : 0..3 = 0
    open      : bool = true
  }
  action Restock()
  action Close()
  action Open()
  action Reserve(from: Ref<Order>, qty: 1..2)
  action Release(qty: 1..2)

  on Close {
    require open else reject "closed"
    open' = false
  }
  on Open {
    require !open else reject "open"
    open' = true
  }
  on Restock {
    require open else reject "closed"
    require available + reserved < 3 else reject "full"
    available' = available + 1
  }
  on Reserve(from, qty) {
    if available >= qty {
      available' = available - qty
      reserved' = reserved + qty
      send from <- Reserved()
    } else {
      send from <- OutOfStock()
    }
  }
  on Release(qty) {
    require reserved >= qty else reject "not-reserved"
    reserved' = reserved - qty
    available' = available + qty
  }

  invariant within-capacity: available + reserved <= 3
}

type Status = unset | pending | confirmed | rejected | cancelling | cancelled | expired

machine Order {
  state {
    status : Status = unset
    qty    : 0..2 = 0
    inv    : Ref<Inventory> = none
  }
  terminal status is rejected | cancelled | expired

  action Place(qty: int check { 1, 2 } strict)
  action Cancel()
  action Expire()
  action Reserved()
  action OutOfStock()

  on Place(qty) {
    require status is unset else reject "exists"
    status' = pending
    qty' = qty
    send inv <- Reserve(from: self, qty: qty)
  }
  on Cancel {
    require status is pending | confirmed else reject "closed"
    if status is confirmed {
      status' = cancelled
      send inv <- Release(qty: qty)
    } else {
      status' = cancelling
    }
  }
  on Expire {
    require status is confirmed else reject "not-confirmed"
    status' = expired
    send inv <- Release(qty: qty)
  }
  on Reserved {
    require status is pending | cancelling else reject "unexpected"
    if status is pending {
      status' = confirmed
    } else {
      status' = cancelled
      send inv <- Release(qty: qty)
    }
  }
  on OutOfStock {
    require status is pending | cancelling else reject "unexpected"
    if status is pending {
      status' = rejected
    } else {
      status' = cancelled
    }
  }

  invariant placed-orders-have-a-quantity: !(status is unset) implies qty >= 1
}

configuration shop {
  inventory : Inventory
  order[2]  : Order { inv: inventory }
  inputs    { order[*].Place, order[*].Cancel, order[*].Expire, inventory.Restock, inventory.Close, inventory.Open }
  bounds    { transit 4 }
  invariant reserved-covers-confirmed: inventory.reserved >= count(order[*] is confirmed)
  liveness  settle: forall i in order: order[i] is cancelling leads to order[i] is cancelled
}
