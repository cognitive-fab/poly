{
  "module": "shop",
  "instances": {
    "inventory": {
      "machine": "Inventory"
    },
    "order": {
      "machine": "Order",
      "createdBy": "place",
      "keyArgument": "order",
      "init": {
        "inv": "inventory"
      }
    }
  },
  "methods": {
    "place": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Place",
      "params": {
        "qty": "$arg:qty"
      }
    },
    "cancel": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Cancel"
    },
    "restock": {
      "instance": "inventory",
      "action": "Restock"
    },
    "expire": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Expire"
    }
  },
  "queries": {
    "order": {
      "instance": "order",
      "key": "$arg:order",
      "fields": {
        "status": "status",
        "qty": "qty"
      }
    },
    "stock": {
      "instance": "inventory",
      "fields": {
        "available": "available",
        "reserved": "reserved"
      }
    }
  }
}
