// T4 mutant after change 3: a charge that goes through after the cart gave up is not refunded, which the brief rules out.
module checkout

service machine Inventory {
  state {
    available : 0..2 = 2
    reserved  : 0..2 = 0
  }
  action Reserve(from: Ref<Cart>, qty: 1..2)
  action Release(qty: 1..2)

  on Reserve(from, qty) {
    if available >= qty {
      available' = available - qty
      reserved' = reserved + qty
      send from <- Reserved()
    } else {
      send from <- OutOfStock()
    }
  }
  on Release(qty) {
    require reserved >= qty else reject "not-reserved"
    reserved' = reserved - qty
    available' = available + qty
  }

  invariant units-conserved: available + reserved == 2
}

service machine Payments {
  state {
    charged   : 0..4 = 0
    declining : bool = false
  }
  action Charge(from: Ref<Cart>, amount: 1..2)
  action DeclineCards()
  action AcceptCards()
  action Refund(amount: 1..2)

  on Charge(from, amount) {
    if declining || charged + amount > 4 {
      send from <- Declined()
    } else {
      charged' = charged + amount
      send from <- Charged()
    }
  }
  on Refund(amount) {
    require charged >= amount else reject "not-charged"
    charged' = charged - amount
  }
  on DeclineCards {
    require !declining else reject "declining"
    declining' = true
  }
  on AcceptCards {
    require declining else reject "accepting"
    declining' = false
  }
}

type Status = unset | open | reserving | paying | paid | failed | cancelling | cancelled | returned | declined | abandoning

machine Cart {
  state {
    status : Status = unset
    items  : 0..2 = 0
    inv    : Ref<Inventory> = none
    pay    : Ref<Payments> = none
  }
  terminal status is failed | cancelled | returned

  action Open()
  action Add()
  action Checkout()
  action Cancel()
  action Return()
  action Retry()
  action Abandon()
  action PaymentTimeout()
  action Reserved()
  action OutOfStock()
  action Charged()
  action Declined()

  on Open {
    require status is unset else reject "exists"
    status' = open
  }
  on Add {
    require status is open else reject "not-open"
    require items < 2 else reject "full"
    items' = items + 1
  }
  on Checkout {
    require status is open else reject "not-open"
    require items >= 1 else reject "empty"
    status' = reserving
    send inv <- Reserve(from: self, qty: items)
  }
  on Cancel {
    require status is open | reserving else reject "closed"
    if status is open {
      status' = cancelled
    } else {
      status' = cancelling
    }
  }
  on Return {
    require status is paid else reject "not-paid"
    status' = returned
    send pay <- Refund(amount: items)
    send inv <- Release(qty: items)
  }
  on Reserved {
    require status is reserving | cancelling else reject "unexpected"
    if status is reserving {
      status' = paying
      send pay <- Charge(from: self, amount: items)
    } else {
      status' = cancelled
      send inv <- Release(qty: items)
    }
  }
  on OutOfStock {
    require status is reserving | cancelling else reject "unexpected"
    if status is reserving {
      status' = failed
    } else {
      status' = cancelled
    }
  }
  on Charged {
    require status is paying | abandoning else reject "unexpected"
    if status is paying {
      status' = paid
    } else {
      status' = failed
    }
  }
  on PaymentTimeout {
    require status is paying else reject "not-paying"
    status' = abandoning
    send inv <- Release(qty: items)
  }
  on Declined {
    require status is paying | abandoning else reject "unexpected"
    if status is paying {
      status' = declined
    } else {
      status' = failed
    }
  }
  on Retry {
    require status is declined else reject "not-declined"
    status' = paying
    send pay <- Charge(from: self, amount: items)
  }
  on Abandon {
    require status is declined else reject "not-declined"
    status' = failed
    send inv <- Release(qty: items)
  }

  invariant checked-out-carts-hold-items: !(status is unset | open) implies items >= 1 || status is cancelled
}

configuration shop {
  inventory : Inventory
  payments  : Payments
  cart[2]   : Cart { inv: inventory, pay: payments }
  inputs    { cart[*].Open, cart[*].Add, cart[*].Checkout, cart[*].Cancel, cart[*].Return, cart[*].Retry, cart[*].Abandon, cart[*].PaymentTimeout, payments.DeclineCards, payments.AcceptCards }
  bounds    { transit 4 }
  invariant reserved-covers-paid: inventory.reserved >= count(cart[*] is paid)
  liveness  settle: forall i in cart: cart[i] is cancelling | reserving | paying | abandoning leads to cart[i] is paid | failed | cancelled | returned | declined
}
