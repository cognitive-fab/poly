{
  "module": "checkout",
  "instances": {
    "inventory": { "machine": "Inventory" },
    "payments": { "machine": "Payments" },
    "cart": { "machine": "Cart", "createdBy": "open", "keyArgument": "cart", "init": { "inv": "inventory", "pay": "payments" } }
  },
  "methods": {
    "open": { "instance": "cart", "key": "$arg:cart", "action": "Open" },
    "add": { "instance": "cart", "key": "$arg:cart", "action": "Add" },
    "checkout": { "instance": "cart", "key": "$arg:cart", "action": "Checkout" },
    "cancel": { "instance": "cart", "key": "$arg:cart", "action": "Cancel" },
    "declineCards": { "instance": "payments", "action": "DeclineCards" },
    "acceptCards": { "instance": "payments", "action": "AcceptCards" }
  },
  "queries": {
    "cart": { "instance": "cart", "key": "$arg:cart", "fields": { "status": "status", "items": "items" } },
    "stock": { "instance": "inventory", "fields": { "available": "available", "reserved": "reserved" } },
    "payments": { "instance": "payments", "fields": { "charged": "charged", "declining": "declining" } }
  }
}
