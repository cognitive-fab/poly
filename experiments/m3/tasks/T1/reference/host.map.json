{
  "module": "orders",
  "instances": {
    "order": {
      "machine": "Order",
      "createdBy": "create",
      "keyArgument": "order"
    }
  },
  "methods": {
    "create": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Create"
    },
    "addItem": {
      "instance": "order",
      "key": "$arg:order",
      "action": "AddItem"
    },
    "removeItem": {
      "instance": "order",
      "key": "$arg:order",
      "action": "RemoveItem"
    },
    "place": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Place"
    },
    "ship": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Ship"
    },
    "cancel": {
      "instance": "order",
      "key": "$arg:order",
      "action": "Cancel"
    }
  },
  "queries": {
    "order": {
      "instance": "order",
      "key": "$arg:order",
      "fields": {
        "status": "status",
        "items": "items",
        "charges": "charges",
        "refunds": "refunds"
      }
    }
  }
}
