// T3 reference after change 3: a payment can be captured in parts until it is refunded.
module payments

enum Status { unset, authorizing, authorized, declined, failed, captured, voided, refunded, expired }

machine Payment {
  state {
    status   : Status = unset
    held     : 0..3 = 0
    taken    : 0..3 = 0
    returned : 0..3 = 0
    requests : 0..3 = 0
  }
  terminal status in { declined, failed, voided, refunded, expired }

  action Authorize(amount: int check { 1, 2 } strict)
  action Approved()
  action Declined()
  action TimedOut()
  action Capture(amount: int check { 1, 2, 3 } strict)
  action Void()
  action Increase()
  action Expire()
  action Refund(amount: int check { 1, 2 } strict)

  on Authorize(amount) {
    require status == unset else reject "exists"
    status' = authorizing
    held' = amount
    requests' = 1
    emit authorizeCard(amount: amount)
  }
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorizeCard(amount: held)
    } else {
      status' = failed
    }
  }
  on Capture(amount) {
    require status in { authorized, captured } else reject "not-authorized"
    require returned == 0 else reject "refunded"
    require taken + amount <= held else reject "over-authorized"
    status' = captured
    taken' = taken + amount
  }
  on Increase {
    require status == authorized else reject "not-authorized"
    require held < 3 else reject "at-limit"
    held' = held + 1
  }
  on Expire {
    require status == authorized else reject "not-authorized"
    status' = expired
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require returned + amount <= taken else reject "over-captured"
    returned' = returned + amount
    if returned + amount == taken {
      status' = refunded
    }
  }

  invariant capture-within-authorization: taken <= held
  invariant refund-within-capture: returned <= taken
  invariant voided-captured-nothing: status == voided implies taken == 0
  invariant expired-captured-nothing: status == expired implies taken == 0
  invariant refunded-means-all-returned: status == refunded implies returned == taken && taken >= 1
  invariant at-most-three-requests: requests <= 3
  invariant authorized-at-most-three: held <= 3
  path property at-most-three-authorisation-requests: count("card.authorize") <= 3

  effect authorizeCard(amount: 1..2) {
    kind "card.authorize"
    labels { egress:external }
    retry { attempts 1, base 100ms, timeout 5s }
    ok -> Approved()
    failed -> Declined()
  }
}
