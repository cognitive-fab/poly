// P1 reference after change 1: a loan can be renewed once.
module loans

enum Status { unset, available, lent, retired }

machine Book {
  state {
    status : Status = unset
    loans  : 0..3 = 0
    renewed : bool = false
  }
  terminal status == retired

  action Add()
  action Lend()
  action GiveBack()
  action Retire()
  action Renew()

  on Add {
    require status == unset else reject "exists"
    status' = available
  }
  on Lend {
    require status == available else reject "not-available"
    require loans < 3 else reject "worn-out"
    status' = lent
    loans' = loans + 1
  }
  on GiveBack {
    require status == lent else reject "not-lent"
    status' = available
    renewed' = false
  }
  on Renew {
    require status == lent else reject "not-lent"
    require !renewed else reject "renewed"
    renewed' = true
  }
  on Retire {
    require status == available else reject "not-available"
    status' = retired
  }

  invariant lent-books-were-lent: status == lent implies loans >= 1
  invariant only-loans-are-renewed: renewed implies status == lent
}
