module payments

// Status names are the host interface's own, since the query returns them verbatim.
// `idle` is never observed: a refused authorize leaves no payment behind.
enum Status { idle, authorizing, authorized, declined, failed, captured, voided, refunded }

machine Payment {
  state {
    status     : Status = idle
    authorized : 0..2 = 0
    captured   : 0..2 = 0
    refunded   : 0..2 = 0
    requests   : 0..3 = 0
  }
  terminal status in { declined, failed, voided, refunded }

  action Authorize(amount: int check { 1, 2 })
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2 })
  action Void()
  action Refund(amount: int check { 1, 2 })

  on Authorize(amount) {
    require status == idle else reject "exists"
    status' = authorizing
    authorized' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(authorized)
    } else {
      status' = failed
    }
  }
  // The first answer decides; a later answer finds the payment no longer authorizing.
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized else reject "not-authorized"
    require amount <= authorized else reject "exceeds-authorized"
    status' = captured
    captured' = amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require refunded + amount <= captured else reject "exceeds-captured"
    refunded' = refunded + amount
    if refunded + amount == captured { status' = refunded }
  }

  effect authorize(amount: 1..2) {
    kind "card.authorize"
    labels { egress:external }
    class compensable
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: captured <= authorized
  invariant refunded-within-captured: refunded <= captured
  invariant voided-captured-nothing: status == voided implies captured == 0
  path property at-most-three-requests: count("card.authorize") <= 3
}
