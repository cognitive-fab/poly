module payments

// Status names are the host interface's own, since the query returns them verbatim.
// `idle` is never observed: a refused authorize leaves no payment behind.
enum Status { idle, authorizing, authorized, declined, failed, captured, voided, refunded, expired }

machine Payment {
  state {
    status   : Status = idle
    held     : 0..3 = 0   // the amount authorised so far
    taken    : 0..3 = 0   // captured so far
    returned : 0..3 = 0   // refunded so far
    requests : 0..3 = 0   // authorisation requests sent
  }
  terminal status in { declined, failed, voided, refunded, expired }

  action Authorize(amount: int check { 1, 2 })
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2, 3 })
  action Void()
  action Increase()
  action Expire()
  action Refund(amount: int check { 1, 2 })

  on Authorize(amount) {
    require status == idle else reject "exists"
    status' = authorizing
    held' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(held)
    } else {
      status' = failed
    }
  }
  // The first answer decides; a later answer finds the payment no longer authorizing.
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    // A first capture, or a further part while nothing has been refunded.
    require status == authorized || (status == captured && returned == 0) else reject "not-capturable"
    require taken + amount <= held else reject "exceeds-authorized"
    status' = captured
    taken' = taken + amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Increase {
    require status == authorized else reject "not-authorized"
    require held < 3 else reject "at-most-3"
    held' = held + 1
  }
  on Expire {
    require status == authorized else reject "not-authorized"
    status' = expired
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require returned + amount <= taken else reject "exceeds-captured"
    returned' = returned + amount
    if returned + amount == taken { status' = refunded }
  }

  effect authorize(amount: 1..2) {
    kind "card.authorize"
    labels { egress:external }
    class compensable
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: taken <= held
  invariant refunded-within-captured: returned <= taken
  invariant voided-captured-nothing: status == voided implies taken == 0
  path property at-most-three-requests: count("card.authorize") <= 3
}
