{
  "module": "shop",
  "instances": {
    "inventory": { "machine": "Inventory" },
    "orders": { "machine": "Order", "createdBy": "place", "keyArgument": "order", "init": { "inv": "inventory" } }
  },
  "methods": {
    "place": { "instance": "orders", "key": "$arg:order", "action": "Place", "params": { "qty": "$arg:qty" } },
    "cancel": { "instance": "orders", "key": "$arg:order", "action": "Cancel" },
    "restock": { "instance": "inventory", "action": "Restock" }
  },
  "queries": {
    "order": { "instance": "orders", "key": "$arg:order", "fields": { "status": "status", "qty": "qty" } },
    "stock": { "instance": "inventory", "fields": { "available": "available", "reserved": "reserved" } }
  }
}
