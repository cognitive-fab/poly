// Card payments: one Payment machine per payment id, authorised, captured and refunded.
module payments

type Status = New | Authorizing | Authorized | Declined | Failed | Captured | Voided | Refunded

machine Payment {
  state {
    status     : Status = New
    authorized : 0..2 = 0
    captured   : 0..2 = 0
    refunded   : 0..2 = 0
    requests   : 0..3 = 0
  }
  terminal status is Declined | Failed | Voided | Refunded

  action Authorize(amount: int check { 1, 2 })
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2 })
  action Void()
  action Refund(amount: int check { 1, 2 })

  on Authorize(amount) {
    require status is New else reject "exists"
    status' = Authorizing
    authorized' = amount
    requests' = 1
    emit cardAuthorize(amount)
  }
  on TimedOut {
    require status is Authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit cardAuthorize(authorized)
    } else {
      status' = Failed
    }
  }
  on Approved {
    require status is Authorizing else reject "not-authorizing"
    status' = Authorized
  }
  on Declined {
    require status is Authorizing else reject "not-authorizing"
    status' = Status.Declined
  }
  on Capture(amount) {
    require status is Authorized else reject "not-authorized"
    require amount <= authorized else reject "over-authorized"
    status' = Captured
    captured' = amount
  }
  on Void {
    require status is Authorized else reject "not-authorized"
    status' = Voided
  }
  on Refund(amount) {
    require status is Captured else reject "not-captured"
    require refunded + amount <= captured else reject "over-captured"
    refunded' = refunded + amount
    if refunded + amount == captured { status' = Refunded }
  }

  effect cardAuthorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class compensable
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: captured <= authorized
  invariant refunded-within-captured: refunded <= captured
  invariant voided-captured-nothing: status is Voided implies captured == 0
  invariant requests-bounded: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3
}
