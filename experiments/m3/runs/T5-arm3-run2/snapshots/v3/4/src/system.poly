// Workflow run status: one Run instance per run id, three tasks, and the run's status derived from them
// after every command that takes effect. A completed or cancelled run is terminal, so the runtime refuses
// every command on it. A failed task may be retried, so a failed run is not final.
module workflow

type Status = queued | running | evicted | completed | failed | cancelled

machine Run {
  state {
    status  : Status = queued
    t0      : Status = queued
    t1      : Status = queued
    t2      : Status = queued
    started : bool   = false
    paused  : bool   = false
  }
  terminal status in { completed, cancelled }

  action Start()
  action TaskStarted(task: int check { 0, 1, 2 } strict)
  action TaskCompleted(task: int check { 0, 1, 2 } strict)
  action TaskFailed(task: int check { 0, 1, 2 } strict)
  action TaskEvicted(task: int check { 0, 1, 2 } strict)
  action TaskRequeued(task: int check { 0, 1, 2 } strict)
  action TaskRetried(task: int check { 0, 1, 2 } strict)
  action Cancel()
  action CancelTask(task: int check { 0, 1, 2 } strict)
  action Pause()
  action Resume()

  on Start {
    require !started else reject "run-exists"
    started' = true
  }

  // A paused run starts no queued task; pausing leaves the status as it is.
  on Pause {
    require started else reject "unknown-run"
    require !paused else reject "run-paused"
    paused' = true
  }
  on Resume {
    require started else reject "unknown-run"
    require paused else reject "run-not-paused"
    paused' = false
  }

  // queued -> running. After it, a task is in flight, so the run is running unless another task failed.
  on TaskStarted(task) {
    require started else reject "unknown-run"
    require !paused else reject "run-paused"
    if task == 0 {
      require t0 == queued else reject "task-not-queued"
      t0' = running
    } else {
      if task == 1 {
        require t1 == queued else reject "task-not-queued"
        t1' = running
      } else {
        require t2 == queued else reject "task-not-queued"
        t2' = running
      }
    }
    if (task != 0 && t0 == failed) || (task != 1 && t1 == failed) || (task != 2 && t2 == failed) {
      status' = failed
    } else {
      status' = running
    }
  }

  // running -> completed.
  on TaskCompleted(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require t0 == running else reject "task-not-running"
      t0' = completed
    } else {
      if task == 1 {
        require t1 == running else reject "task-not-running"
        t1' = completed
      } else {
        require t2 == running else reject "task-not-running"
        t2' = completed
      }
    }
    if (task == 0 || t0 == completed) && (task == 1 || t1 == completed) && (task == 2 || t2 == completed) {
      status' = completed
    } else {
      if (task != 0 && t0 == failed) || (task != 1 && t1 == failed) || (task != 2 && t2 == failed) {
        status' = failed
      } else {
        if (task != 0 && t0 in { queued, running, evicted })
           || (task != 1 && t1 in { queued, running, evicted })
           || (task != 2 && t2 in { queued, running, evicted }) {
          status' = running
        } else {
          status' = cancelled
        }
      }
    }
  }

  // running -> failed. A failed task makes the run failed, whether or not every task failed.
  on TaskFailed(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require t0 == running else reject "task-not-running"
      t0' = failed
    } else {
      if task == 1 {
        require t1 == running else reject "task-not-running"
        t1' = failed
      } else {
        require t2 == running else reject "task-not-running"
        t2' = failed
      }
    }
    status' = failed
  }

  // running -> evicted. The evicted task is in flight.
  on TaskEvicted(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require t0 == running else reject "task-not-running"
      t0' = evicted
    } else {
      if task == 1 {
        require t1 == running else reject "task-not-running"
        t1' = evicted
      } else {
        require t2 == running else reject "task-not-running"
        t2' = evicted
      }
    }
    if (task == 0 || t0 == evicted) && (task == 1 || t1 == evicted) && (task == 2 || t2 == evicted) {
      status' = evicted
    } else {
      if (task != 0 && t0 == failed) || (task != 1 && t1 == failed) || (task != 2 && t2 == failed) {
        status' = failed
      } else {
        status' = running
      }
    }
  }

  // evicted -> queued. The queued task is in flight.
  on TaskRequeued(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require t0 == evicted else reject "task-not-evicted"
      t0' = queued
    } else {
      if task == 1 {
        require t1 == evicted else reject "task-not-evicted"
        t1' = queued
      } else {
        require t2 == evicted else reject "task-not-evicted"
        t2' = queued
      }
    }
    if (task == 0 || t0 == queued) && (task == 1 || t1 == queued) && (task == 2 || t2 == queued) {
      status' = queued
    } else {
      if (task != 0 && t0 == failed) || (task != 1 && t1 == failed) || (task != 2 && t2 == failed) {
        status' = failed
      } else {
        status' = running
      }
    }
  }

  // failed -> queued. The queued task is in flight.
  on TaskRetried(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require t0 == failed else reject "task-not-failed"
      t0' = queued
    } else {
      if task == 1 {
        require t1 == failed else reject "task-not-failed"
        t1' = queued
      } else {
        require t2 == failed else reject "task-not-failed"
        t2' = queued
      }
    }
    if (task == 0 || t0 == queued) && (task == 1 || t1 == queued) && (task == 2 || t2 == queued) {
      status' = queued
    } else {
      if (task != 0 && t0 == failed) || (task != 1 && t1 == failed) || (task != 2 && t2 == failed) {
        status' = failed
      } else {
        status' = running
      }
    }
  }

  // Every task in flight becomes cancelled; none is in flight after it.
  on Cancel {
    require started else reject "unknown-run"
    require t0 in { queued, running, evicted } || t1 in { queued, running, evicted } || t2 in { queued, running, evicted }
      else reject "nothing-in-flight"
    if t0 in { queued, running, evicted } { t0' = cancelled }
    if t1 in { queued, running, evicted } { t1' = cancelled }
    if t2 in { queued, running, evicted } { t2' = cancelled }
    if t0 == failed || t1 == failed || t2 == failed {
      status' = failed
    } else {
      status' = cancelled
    }
  }

  // One task in flight becomes cancelled; the run's status is derived again.
  on CancelTask(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require t0 in { queued, running, evicted } else reject "task-is-final"
      t0' = cancelled
    } else {
      if task == 1 {
        require t1 in { queued, running, evicted } else reject "task-is-final"
        t1' = cancelled
      } else {
        require t2 in { queued, running, evicted } else reject "task-is-final"
        t2' = cancelled
      }
    }
    if (task == 0 || t0 == cancelled) && (task == 1 || t1 == cancelled) && (task == 2 || t2 == cancelled) {
      status' = cancelled
    } else {
      if (task != 0 && t0 == failed) || (task != 1 && t1 == failed) || (task != 2 && t2 == failed) {
        status' = failed
      } else {
        if (task != 0 && t0 in { queued, running, evicted })
           || (task != 1 && t1 in { queued, running, evicted })
           || (task != 2 && t2 in { queued, running, evicted }) {
          status' = running
        } else {
          status' = cancelled
        }
      }
    }
  }

  invariant completed-only-when-all-completed:
    status == completed implies (t0 == completed && t1 == completed && t2 == completed)
  invariant failed-whenever-a-task-failed:
    (t0 == failed || t1 == failed || t2 == failed) implies status == failed
  invariant not-done-while-in-flight:
    status in { completed, cancelled }
      implies !(t0 in { queued, running, evicted } || t1 in { queued, running, evicted } || t2 in { queued, running, evicted })
  invariant some-task-in-flight-when-running:
    status in { queued, running, evicted }
      implies (t0 in { queued, running, evicted } || t1 in { queued, running, evicted } || t2 in { queued, running, evicted })
}
