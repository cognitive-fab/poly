// T8: a consensus node's role and term.
module consensus

type Role = follower | candidate | leader | shutdown
type Vote = nobody | itself | n1 | n2

machine Node {
  state {
    role : Role = follower
    term : 0..3 = 0
    wasCandidate : bool = false   // the node was a candidate in its current term
    votedFor : Vote = nobody      // the node's vote in its current term
  }
  action ElectionTimeout()
  action ElectionWon()
  action ElectionLost()
  action NewerTermSeen(t: int check { 0, 1, 2, 3, 4 })
  action QuorumLost()
  action Shutdown()
  action VoteRequested(c: string check { "n1", "n2", "n3" }, t: int check { 0, 1, 2, 3, 4 })

  terminal role is shutdown

  on ElectionTimeout {
    require role != shutdown else reject "shut-down"
    require role != leader else reject "is-leader"
    require term < 3 else reject "last-term"
    role' = candidate
    term' = term + 1
    wasCandidate' = true
    votedFor' = itself
  }
  on ElectionWon {
    require role != shutdown else reject "shut-down"
    require role is candidate else reject "not-candidate"
    role' = leader
  }
  on ElectionLost {
    require role != shutdown else reject "shut-down"
    require role is candidate else reject "not-candidate"
    role' = follower                // keeps its vote for itself
  }
  on NewerTermSeen(t) {
    require role != shutdown else reject "shut-down"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t > term else reject "term-not-newer"
    role' = follower
    term' = t
    wasCandidate' = false
    votedFor' = nobody
  }
  on QuorumLost {
    require role != shutdown else reject "shut-down"
    require role is leader else reject "not-leader"
    role' = follower
  }
  on VoteRequested(c, t) {
    require role != shutdown else reject "shut-down"
    require c == "n1" || c == "n2" else reject "unknown-candidate"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t >= term else reject "term-older"
    require t > term || (role is follower && (votedFor is nobody
      || (c == "n1" && votedFor is n1) || (c == "n2" && votedFor is n2))) else reject "already-voted"
    role' = follower
    term' = t
    if t > term { wasCandidate' = false }
    if c == "n1" { votedFor' = n1 } else { votedFor' = n2 }
  }
  on Shutdown {
    require role != shutdown else reject "shut-down"
    role' = shutdown
  }

  invariant leader-was-candidate: role is leader implies wasCandidate
  invariant leader-voted-for-itself: role is leader || role is candidate implies votedFor is itself
}
