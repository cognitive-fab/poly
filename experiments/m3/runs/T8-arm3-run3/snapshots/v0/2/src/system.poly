// T8: a consensus node's role and term.
module consensus

type Role = Follower | Candidate | Leader | Shutdown

machine Node {
  state {
    role : Role = Follower
    term : 0..3 = 0
    wasCandidate : bool = false   // the node was a candidate in its current term
  }
  action ElectionTimeout()
  action ElectionWon()
  action NewerTermSeen(t: int check { 0, 1, 2, 3, 4 })
  action QuorumLost()
  action Shutdown()

  terminal role is Shutdown

  on ElectionTimeout {
    require role != Shutdown else reject "shut-down"
    require role != Leader else reject "is-leader"
    require term < 3 else reject "last-term"
    role' = Candidate
    term' = term + 1
    wasCandidate' = true
  }
  on ElectionWon {
    require role != Shutdown else reject "shut-down"
    require role is Candidate else reject "not-candidate"
    role' = Leader
  }
  on NewerTermSeen(t) {
    require role != Shutdown else reject "shut-down"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t > term else reject "term-not-newer"
    role' = Follower
    term' = t
    wasCandidate' = false
  }
  on QuorumLost {
    require role != Shutdown else reject "shut-down"
    require role is Leader else reject "not-leader"
    role' = Follower
  }
  on Shutdown {
    require role != Shutdown else reject "shut-down"
    role' = Shutdown
  }

  invariant leader-was-candidate: role is Leader implies wasCandidate
}
