// Checkout across carts, one inventory and one payment service, talking by messages.
module checkout

service machine Inventory {
  state {
    available : 0..2 = 2
    reserved  : 0..2 = 0
  }
  action Reserve(from: Ref<Cart>, qty: 1..2)
  action Release(qty: 1..2)

  on Reserve(from, qty) {
    if qty <= available {
      available' = available - qty
      reserved' = reserved + qty
      send from <- Reserved()
    } else {
      send from <- OutOfStock()
    }
  }
  on Release(qty) {
    require qty <= reserved else reject "not-reserved"
    reserved' = reserved - qty
    available' = available + qty
  }
}

service machine Payments {
  state {
    charged   : 0..4 = 0
    declining : bool = false
  }
  action Charge(from: Ref<Cart>, amount: 1..2)
  action DeclineCards()
  action AcceptCards()
  action Refund(amount: 1..2)

  on Charge(from, amount) {
    if !declining && charged + amount <= 4 {
      charged' = charged + amount
      send from <- Charged()
    } else {
      send from <- Declined()
    }
  }
  on Refund(amount) {
    require amount <= charged else reject "not-charged"
    charged' = charged - amount
  }
  on DeclineCards {
    require !declining else reject "already-declining"
    declining' = true
  }
  on AcceptCards {
    require declining else reject "already-accepting"
    declining' = false
  }
}

type Status = fresh | open | reserving | paying | paid | failed | cancelling | cancelled | returned

machine Cart {
  state {
    status : Status = fresh
    items  : 0..2 = 0
    inv    : Ref<Inventory> = none
    pay    : Ref<Payments> = none
  }
  terminal status in { failed, cancelled, returned }

  action Open()
  action Add()
  action Checkout()
  action Cancel()
  action Reserved()
  action OutOfStock()
  action Charged()
  action Declined()
  action Return()

  on Open {
    require status == fresh else reject "exists"
    status' = open
  }
  on Add {
    require status == open else reject "not-open"
    require items < 2 else reject "cart-full"
    items' = items + 1
  }
  on Checkout {
    require status == open else reject "not-open"
    require items > 0 else reject "empty-cart"
    status' = reserving
    send inv <- Reserve(from: self, qty: items)
  }
  on Cancel {
    require status in { open, reserving } else reject "cannot-cancel"
    if status == open {
      status' = cancelled
    } else {
      status' = cancelling
    }
  }
  on Reserved {
    require status in { reserving, cancelling } else reject "not-reserving"
    if status == reserving {
      status' = paying
      send pay <- Charge(from: self, amount: items)
    } else {
      status' = cancelled
      send inv <- Release(qty: items)
    }
  }
  on OutOfStock {
    require status in { reserving, cancelling } else reject "not-reserving"
    if status == reserving {
      status' = failed
    } else {
      status' = cancelled
    }
  }
  on Charged {
    require status == paying else reject "not-paying"
    status' = paid
  }
  on Declined {
    require status == paying else reject "not-paying"
    status' = failed
    send inv <- Release(qty: items)
  }
}

configuration shop {
  inv     : Inventory
  pay     : Payments
  cart[2] : Cart { inv: inv, pay: pay }
  inputs  { cart[*].Open, cart[*].Add, cart[*].Checkout, cart[*].Cancel, pay.DeclineCards, pay.AcceptCards }
  bounds  { transit 4 }
  invariant charged-within-reserved: pay.charged <= inv.reserved
  invariant stock-conserved: inv.available + inv.reserved <= init(inv.available) + init(inv.reserved)
  invariant paid-within-stock: count(cart[*] is paid) <= init(inv.available)
}
