// Electing a leader among three nodes: one election round, term 1.
module election

type Role = follower | candidate | leader | down

// A service: a node answers RequestVote for the life of the round, and the round may end with no leader.
service machine Node {
  state {
    role     : Role      = follower
    term     : 0..1      = 0        // term, votedFor and knownLeader are written down: they survive a crash
    votedFor : Ref<Node> = none
    votes    : 0..3      = 0
    me       : Ref<Node> = none     // this node's own address, set by the host
    p1       : Ref<Node> = none     // the other two nodes
    p2       : Ref<Node> = none
    knownLeader : Ref<Node> = none  // the leader this node knows in its term
  }
  action Timeout()
  action RequestVote(from: Ref<Node>, term: 1..1)
  action VoteReply(term: 1..1, granted: bool)
  action Leader(from: Ref<Node>, term: 1..1)
  action GiveUp()
  action Crash()
  action Recover()

  // a candidate that gives up keeps its vote for itself, and so grants no other vote in the term
  on GiveUp {
    require role is candidate else reject "not-a-candidate"
    role' = follower
  }

  // the votes counted are not written down, so a crash loses them
  on Crash {
    require !(role is down) else reject "down"
    role'  = down
    votes' = 0
  }

  on Recover {
    require role is down else reject "not-down"
    role' = follower
  }

  on Timeout {
    require !(role is down) else reject "down"
    require role is follower && pre.term == 0 else reject "not-a-follower-in-term-0"
    role'     = candidate
    term'     = 1
    votedFor' = me
    votes'    = 1
    send p1 <- RequestVote(from: self, term: 1)
    send p2 <- RequestVote(from: self, term: 1)
  }

  on RequestVote(from, term) {
    require !(role is down) else reject "down"
    if pre.term == 0 {
      term'     = 1
      votedFor' = from
      send from <- VoteReply(term: 1, granted: true)
    } else {
      if role is follower && (votedFor == none || votedFor == from) {
        votedFor' = from
        send from <- VoteReply(term: 1, granted: true)
      } else {
        send from <- VoteReply(term: 1, granted: false)
      }
    }
  }

  on VoteReply(term, granted) {
    require role is candidate && term == pre.term && granted else reject "ignored"
    votes' = votes + 1
    if votes + 1 >= 2 {
      role'        = leader
      knownLeader' = me
      send p1 <- Leader(from: self, term: 1)
      send p2 <- Leader(from: self, term: 1)
    }
  }

  on Leader(from, term) {
    require !(role is down) else reject "down"
    require !(role is leader) else reject "already-leader"
    knownLeader' = from
    if pre.term == 0 { term' = 1 }
    if role is candidate { role' = follower }
  }

  invariant leader-has-majority: role is leader implies votes >= 2
  invariant leader-knows-itself: role is leader implies knownLeader == me
  invariant term-1-once-moved: role is candidate | leader implies term == 1
  step property votes-once: pre.votedFor != none implies post.votedFor == pre.votedFor
}

configuration three-nodes {
  a : Node { me: a, p1: b, p2: c }
  b : Node { me: b, p1: a, p2: c }
  c : Node { me: c, p1: a, p2: b }
  inputs { a.Timeout, b.Timeout, c.Timeout, a.GiveUp, b.GiveUp, c.GiveUp,
           a.Crash, b.Crash, c.Crash, a.Recover, b.Recover, c.Recover }
  bounds { transit 6 }
  invariant one-leader:
    !(a.role is leader && b.role is leader) && !(a.role is leader && c.role is leader) && !(b.role is leader && c.role is leader)
  invariant leader-holds-majority:
    (a.role is leader implies (b.votedFor == a.me || c.votedFor == a.me))
    && (b.role is leader implies (a.votedFor == b.me || c.votedFor == b.me))
    && (c.role is leader implies (a.votedFor == c.me || b.votedFor == c.me))
  // a node that has led knows itself as leader for the rest of the term, crash or not
  invariant one-node-ever-led:
    !(a.knownLeader == a.me && b.knownLeader == b.me) && !(a.knownLeader == a.me && c.knownLeader == c.me)
    && !(b.knownLeader == b.me && c.knownLeader == c.me)
  invariant known-leader-led:
    ((a.knownLeader == b.me || c.knownLeader == b.me) implies b.knownLeader == b.me)
    && ((a.knownLeader == c.me || b.knownLeader == c.me) implies c.knownLeader == c.me)
    && ((b.knownLeader == a.me || c.knownLeader == a.me) implies a.knownLeader == a.me)
  invariant leader-is-known-leader:
    (a.role is leader implies a.knownLeader == a.me) && (b.role is leader implies b.knownLeader == b.me)
    && (c.role is leader implies c.knownLeader == c.me)
}
