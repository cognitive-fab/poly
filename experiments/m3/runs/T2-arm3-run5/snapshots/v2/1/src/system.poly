module shop

// The one inventory: available plus reserved never exceeds 3.
service machine Inventory {
  state {
    available : 0..3 = 1
    reserved  : 0..3 = 0
    open      : bool = true    // closed for a stocktake when false
  }
  action Restock()
  action Close()
  action Open()
  action Reserve(from: Ref<Order>, qty: 1..2)
  action Release(qty: 1..2)

  on Restock {
    require open else reject "inventory-closed"
    require available + reserved < 3 else reject "inventory-full"
    available' = available + 1
  }
  on Close {
    require open else reject "already-closed"
    open' = false
  }
  on Open {
    require !open else reject "already-open"
    open' = true
  }
  on Reserve(from, qty) {
    if open && available >= qty {
      available' = available - qty
      reserved' = reserved + qty
      send from <- Reserved()
    } else {
      send from <- OutOfStock()
    }
  }
  on Release(qty) {
    require reserved >= qty else reject "not-reserved"
    reserved' = reserved - qty
    available' = available + qty
  }

  invariant within-capacity: available + reserved <= 3
}

enum Status { idle, pending, confirmed, rejected, cancelling, cancelled, expired }

// An order: placed, then confirmed or rejected by the inventory's answer, or cancelled.
machine Order {
  state {
    status : Status = idle
    qty    : 0..2 = 0
    inv    : Ref<Inventory> = none
    held   : 0..2 = 0    // the units reserved for this order while it is confirmed
  }
  terminal status in { rejected, cancelled, expired }

  action Place(qty: int check { 1, 2 } strict)
  action Cancel()
  action Expire()
  action Reserved()
  action OutOfStock()

  on Place(qty) {
    require status == idle else reject "order-exists"
    status' = pending
    qty' = qty
    send inv <- Reserve(from: self, qty: qty)
  }
  on Reserved {
    require status in { pending, cancelling } else reject "not-waiting"
    if status == pending {
      status' = confirmed
      held' = qty
    } else {
      status' = cancelled
      send inv <- Release(qty: qty)
    }
  }
  on OutOfStock {
    require status in { pending, cancelling } else reject "not-waiting"
    if status == pending {
      status' = rejected
    } else {
      status' = cancelled
    }
  }
  on Cancel {
    require status in { pending, confirmed } else reject "not-cancellable"
    if status == confirmed {
      status' = cancelled
      held' = 0
      send inv <- Release(qty: qty)
    } else {
      status' = cancelling
    }
  }
  on Expire {
    require status == confirmed else reject "not-confirmed"
    status' = expired
    held' = 0
    send inv <- Release(qty: qty)
  }

  invariant placed-has-qty: status != idle implies qty > 0
  invariant held-iff-confirmed: (status == confirmed implies held == qty) && (status != confirmed implies held == 0)
}

configuration two-orders {
  inv      : Inventory
  order[2] : Order { inv: inv }
  inputs   { order[*].Place, order[*].Cancel, order[*].Expire, inv.Restock }
  bounds   { transit 4 }
  invariant units-conserved: inv.available + inv.reserved <= 3
  invariant confirmed-reserved: sum(order[*].held) <= inv.reserved
}
