// T10: a lease with fencing tokens. The service grants at most 2 leases (tokens 1 and 2) and takes at most
// 2 writes; two clients talk to it by messages that may arrive in any order.
module fencing

type Status = idle | requesting | holding

service machine Lease {
  state {
    holder : Ref<Client> = none
    token  : 0..2 = 0          // the last token granted; also the number of leases granted
    writes : 0..2 = 0
    wrote  : bool = false      // a write was taken since the last grant
  }
  action Acquire(from: Ref<Client>)
  action Release(from: Ref<Client>, token: 0..2)
  action Write(from: Ref<Client>, token: 0..2)
  action Expire()

  on Acquire(from) {
    if holder == none && pre.token < 2 {
      holder' = from
      token' = pre.token + 1
      wrote' = false
      send from <- Granted(token: pre.token + 1)
    } else {
      send from <- Denied()
    }
  }
  on Release(from, token) {
    if holder != none && holder == from && token == pre.token { holder' = none }
    send from <- Released()
  }
  on Write(from, token) {
    if holder != none && holder == from && token == pre.token && !wrote && writes < 2 {
      writes' = writes + 1
      wrote' = true
      send from <- WriteDone()
    } else {
      send from <- WriteRefused()
    }
  }
  on Expire {
    require holder != none else reject "no-holder"
    holder' = none
    send holder <- Revoked(token: token)
  }
}

machine Client {
  state {
    status  : Status = idle
    token   : 0..2 = 0          // the last token granted to this client
    writing : bool = false
    revoked : 0..2 = 0          // the newest token revoked while not holding
    svc     : Ref<Lease> = none
  }
  action Acquire()
  action Release()
  action Write()
  action Granted(token: 0..2)
  action Denied()
  action Revoked(token: 0..2)
  action WriteDone()
  action WriteRefused()

  on Acquire {
    require status is idle else reject "not-idle"
    status' = requesting
    send svc <- Acquire(from: self)
  }
  on Release {
    require status is holding else reject "not-holding"
    status' = releasing
    send svc <- Release(from: self, token: pre.token)
  }
  on Write {
    require status is holding else reject "not-holding"
    require !writing else reject "writing"
    writing' = true
    send svc <- Write(from: self, token: pre.token)
  }
  on Granted(token) {
    require status is requesting else reject "not-requesting"
    token' = token
    if token <= revoked { status' = idle } else { status' = holding }
  }
  on Denied {
    require status is requesting else reject "not-requesting"
    status' = idle
  }
  on Revoked(token) {
    if status is holding {
      require token == pre.token else reject "stale-revoke"
      status' = idle
    } else {
      require token > revoked else reject "stale-revoke"
      revoked' = token
    }
  }
  on WriteDone {
    require writing else reject "not-writing"
    writing' = false
  }
  on WriteRefused {
    require writing else reject "not-writing"
    writing' = false
  }
}

configuration two-clients {
  lease : Lease
  c[2]  : Client { svc: lease }
  inputs { c[*].Acquire, c[*].Release, c[*].Write, lease.Expire }
  bounds { transit 10 }
  invariant one-current-holder: count(c[*].status == holding && c[*].token == lease.token) <= 1
}
