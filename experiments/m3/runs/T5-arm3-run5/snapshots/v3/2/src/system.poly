// Workflow run status: one Run per run id, three tasks, and the run's status derived from them.
// A failed task may be retried, so only a completed or cancelled run is final.
module workflow

enum Status { queued, running, evicted, completed, failed, cancelled }

machine Run {
  state {
    status  : Status = queued
    task0   : Status = queued
    task1   : Status = queued
    task2   : Status = queued
    started : bool   = false
    paused  : bool   = false
  }
  terminal status in { completed, cancelled }

  action Start()
  action TaskStarted(task: int check { 0, 1, 2 } strict)
  action TaskCompleted(task: int check { 0, 1, 2 } strict)
  action TaskFailed(task: int check { 0, 1, 2 } strict)
  action TaskEvicted(task: int check { 0, 1, 2 } strict)
  action TaskRequeued(task: int check { 0, 1, 2 } strict)
  action TaskRetried(task: int check { 0, 1, 2 } strict)
  action Cancel()
  action CancelTask(task: int check { 0, 1, 2 } strict)
  action Pause()
  action Resume()

  on Start {
    require !started else reject "run-exists"
    started' = true
  }

  // In each handler below, the task's new status is in flight unless it is completed or failed, so the run's
  // status follows from the other two: theirs if they share it, failed if one of them failed, else running.

  // A queued task becomes running.
  on TaskStarted(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 == queued else reject "task-not-queued"
      task0' = running
      if task1 == running && task2 == running { status' = running }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == queued else reject "task-not-queued"
        task1' = running
        if task0 == running && task2 == running { status' = running }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == queued else reject "task-not-queued"
        task2' = running
        if task0 == running && task1 == running { status' = running }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // A running task becomes completed; with no other task failed or in flight, the run is completed or cancelled.
  on TaskCompleted(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 == running else reject "task-not-running"
      task0' = completed
      if task1 == completed && task2 == completed { status' = completed }
      else { if task1 == failed || task2 == failed { status' = failed }
      else { if task1 in { queued, running, evicted } || task2 in { queued, running, evicted } { status' = running }
      else { status' = cancelled } } }
    } else {
      if task == 1 {
        require task1 == running else reject "task-not-running"
        task1' = completed
        if task0 == completed && task2 == completed { status' = completed }
        else { if task0 == failed || task2 == failed { status' = failed }
        else { if task0 in { queued, running, evicted } || task2 in { queued, running, evicted } { status' = running }
        else { status' = cancelled } } }
      } else {
        require task2 == running else reject "task-not-running"
        task2' = completed
        if task0 == completed && task1 == completed { status' = completed }
        else { if task0 == failed || task1 == failed { status' = failed }
        else { if task0 in { queued, running, evicted } || task1 in { queued, running, evicted } { status' = running }
        else { status' = cancelled } } }
      }
    }
  }

  // A running task fails, and so does the run.
  on TaskFailed(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 == running else reject "task-not-running"
      task0' = failed
    } else {
      if task == 1 {
        require task1 == running else reject "task-not-running"
        task1' = failed
      } else {
        require task2 == running else reject "task-not-running"
        task2' = failed
      }
    }
    status' = failed
  }

  // A running task is evicted.
  on TaskEvicted(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 == running else reject "task-not-running"
      task0' = evicted
      if task1 == evicted && task2 == evicted { status' = evicted }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == running else reject "task-not-running"
        task1' = evicted
        if task0 == evicted && task2 == evicted { status' = evicted }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == running else reject "task-not-running"
        task2' = evicted
        if task0 == evicted && task1 == evicted { status' = evicted }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // An evicted task is queued again.
  on TaskRequeued(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 == evicted else reject "task-not-evicted"
      task0' = queued
      if task1 == queued && task2 == queued { status' = queued }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == evicted else reject "task-not-evicted"
        task1' = queued
        if task0 == queued && task2 == queued { status' = queued }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == evicted else reject "task-not-evicted"
        task2' = queued
        if task0 == queued && task1 == queued { status' = queued }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // A failed task is queued again.
  on TaskRetried(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 == failed else reject "task-not-failed"
      task0' = queued
      if task1 == queued && task2 == queued { status' = queued }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == failed else reject "task-not-failed"
        task1' = queued
        if task0 == queued && task2 == queued { status' = queued }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == failed else reject "task-not-failed"
        task2' = queued
        if task0 == queued && task1 == queued { status' = queued }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // One task in flight is cancelled; with no other task failed or in flight, the run is cancelled.
  on CancelTask(task) {
    require started else reject "unknown-run"
    if task == 0 {
      require task0 in { queued, running, evicted } else reject "task-final"
      task0' = cancelled
      if task1 == failed || task2 == failed { status' = failed }
      else { if task1 in { queued, running, evicted } || task2 in { queued, running, evicted } { status' = running }
      else { status' = cancelled } }
    } else {
      if task == 1 {
        require task1 in { queued, running, evicted } else reject "task-final"
        task1' = cancelled
        if task0 == failed || task2 == failed { status' = failed }
        else { if task0 in { queued, running, evicted } || task2 in { queued, running, evicted } { status' = running }
        else { status' = cancelled } }
      } else {
        require task2 in { queued, running, evicted } else reject "task-final"
        task2' = cancelled
        if task0 == failed || task1 == failed { status' = failed }
        else { if task0 in { queued, running, evicted } || task1 in { queued, running, evicted } { status' = running }
        else { status' = cancelled } }
      }
    }
  }

  // Every task in flight is cancelled; none is left in flight, so the run is failed if a task failed, else cancelled.
  on Cancel {
    require started else reject "unknown-run"
    require task0 in { queued, running, evicted } || task1 in { queued, running, evicted } || task2 in { queued, running, evicted } else reject "nothing-in-flight"
    if task0 in { queued, running, evicted } { task0' = cancelled }
    if task1 in { queued, running, evicted } { task1' = cancelled }
    if task2 in { queued, running, evicted } { task2' = cancelled }
    if task0 == failed || task1 == failed || task2 == failed { status' = failed } else { status' = cancelled }
  }

  // The run's status is the brief's derivation from its three tasks.
  invariant status-derived:
    (task0 == task1 && task1 == task2 implies status == task0)
    && (!(task0 == task1 && task1 == task2) && (task0 == failed || task1 == failed || task2 == failed) implies status == failed)
    && (!(task0 == task1 && task1 == task2) && !(task0 == failed || task1 == failed || task2 == failed)
        && (task0 in { queued, running, evicted } || task1 in { queued, running, evicted } || task2 in { queued, running, evicted })
        implies status == running)
    && (!(task0 == task1 && task1 == task2) && !(task0 == failed || task1 == failed || task2 == failed)
        && !(task0 in { queued, running, evicted } || task1 in { queued, running, evicted } || task2 in { queued, running, evicted })
        implies status == cancelled)
  invariant unstarted-is-queued: !started implies (status == queued && task0 == queued && task1 == queued && task2 == queued)
}
