// T6: jobs with retries and cancellation. One Job instance per job id, created by submit.
module jobs

enum Status { unsubmitted, queued, running, cancelling, succeeded, failed, cancelled, held }

machine Job {
  state {
    status   : Status = unsubmitted
    tries    : 0..3   = 0
    maxTries : 0..3   = 0
  }
  terminal status is succeeded | failed | cancelled

  action Submit(max: int check { 0, 1, 2, 3, 4 })
  action Claim()
  action Succeed()
  action Fail()
  action FailPermanently()
  action Lost()
  action Cancel()
  action Hold()
  action Release()

  on Submit(max) {
    require status is unsubmitted else reject "exists"
    require max == 1 || max == 2 || max == 3 else reject "bad-max-tries"
    status' = queued
    maxTries' = max
  }
  on Claim {
    require status is queued else reject "not-queued"
    require tries < maxTries else reject "no-tries-left"
    status' = running
    tries' = tries + 1
  }
  on Succeed {
    require status is running || status is cancelling else reject "not-running"
    status' = succeeded
  }
  on Fail {
    match status {
      running    => if tries < maxTries { status' = queued } else { status' = failed }
      cancelling => status' = cancelled
      _          => reject "not-running"
    }
  }
  on FailPermanently {
    match status {
      running    => status' = failed
      cancelling => status' = cancelled
      _          => reject "not-running"
    }
  }
  on Lost {
    match status {
      running    => if tries < maxTries { status' = queued } else { status' = failed }
      cancelling => status' = cancelled
      _          => reject "not-running"
    }
  }
  on Cancel {
    match status {
      queued  => status' = cancelled
      held    => status' = cancelled
      running => status' = cancelling
      _       => reject "not-cancellable"
    }
  }

  on Hold {
    require status is queued else reject "not-queued"
    status' = held
  }
  on Release {
    require status is held else reject "not-held"
    status' = queued
  }

  invariant tries-within-limit: tries <= maxTries
  invariant failed-only-after-a-try: status is failed implies tries >= 1
  invariant submitted-has-limit: !(status is unsubmitted) implies maxTries >= 1
  invariant active-was-tried: (status is running || status is cancelling) implies tries >= 1
  invariant queued-has-tries-left: (status is queued || status is held) implies tries < maxTries
}
