// T8: a consensus node's role, term and vote.
// The constructors are lowercase so the host query returns them as the interface names them.
module consensus

type Role = follower | candidate | leader | shutdown
type Vote = nobody | itself | n1 | n2

machine Node {
  state {
    role     : Role = follower
    term     : 0..3 = 0
    votedFor : Vote = nobody      // the node's vote in its current term
  }
  terminal role is shutdown

  action ElectionTimeout()
  action ElectionWon()
  action ElectionLost()
  action NewerTermSeen(t: int check { 0, 1, 2, 3, 4 })
  action QuorumLost()
  action Shutdown()
  action VoteRequested(c: Vote, t: int check { 0, 1, 2, 3, 4 })

  on ElectionTimeout {
    require role != shutdown else reject "shut-down"
    require role != leader else reject "is-leader"
    require term < 3 else reject "last-term"
    role' = candidate
    term' = term + 1
    votedFor' = itself
  }
  on ElectionWon {
    require role != shutdown else reject "shut-down"
    require role == candidate else reject "not-candidate"
    role' = leader
  }
  on ElectionLost {
    require role != shutdown else reject "shut-down"
    require role == candidate else reject "not-candidate"
    role' = follower                // keeps its vote for itself in this term
  }
  on NewerTermSeen(t) {
    require role != shutdown else reject "shut-down"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t > term else reject "term-not-newer"
    role' = follower
    term' = t
    votedFor' = nobody
  }
  on QuorumLost {
    require role != shutdown else reject "shut-down"
    require role == leader else reject "not-leader"
    role' = follower
  }
  on Shutdown {
    require role != shutdown else reject "shut-down"
    role' = shutdown
  }
  on VoteRequested(c, t) {
    require role != shutdown else reject "shut-down"
    require c == n1 || c == n2 else reject "unknown-candidate"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t >= term else reject "term-stale"
    if t > term {
      role' = follower
      term' = t
      votedFor' = c
    } else {
      require role == follower else reject "not-follower"
      require votedFor == nobody || votedFor == c else reject "already-voted"
      votedFor' = c
    }
  }

  invariant no-vote-in-term-0: term == 0 implies votedFor == nobody
  invariant candidate-and-leader-voted-for-itself:
    (role == candidate || role == leader) implies votedFor == itself
  step property term-never-decreases: post.term >= pre.term
  step property term-changes-only-by-election-newer-term-or-vote:
    post.term != pre.term implies
      (action == ElectionTimeout || action == NewerTermSeen || action == VoteRequested)
  step property leader-was-candidate:
    (post.role == leader && pre.role != leader) implies (pre.role == candidate && pre.term == post.term)
  step property shutdown-is-final: pre.role == shutdown implies post.role == shutdown
  step property votes-at-most-once-per-term:
    (post.term == pre.term && pre.votedFor != nobody) implies post.votedFor == pre.votedFor
}
