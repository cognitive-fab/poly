module shop

// The status names are the ones the host interface shows; fresh is an instance not yet created by Create.
enum Status { fresh, draft, placed, paid, shipped, cancelling, cancelled, declined, failed }

machine Order {
  state {
    status  : Status = fresh
    items   : 0..3   = 0
    charges : 0..2   = 0
    refunds : 0..1   = 0
  }
  terminal status in { shipped, cancelled, failed }

  action Create()
  action AddItem()
  action RemoveItem()
  action Place()
  action Ship()
  action Cancel()
  action ChargeOk()
  action ChargeFailed()
  action RetryPayment()

  on Create {
    require status == fresh else reject "exists"
    status' = draft
  }
  on AddItem {
    require status == draft else reject "not-draft"
    require items < 3 else reject "full"
    items' = items + 1
  }
  on RemoveItem {
    require status == draft else reject "not-draft"
    require items > 0 else reject "empty"
    items' = items - 1
  }
  on Place {
    require status == draft else reject "not-draft"
    require items > 0 else reject "empty"
    require charges == 0 else reject "charged"
    status' = placed
    charges' = charges + 1
    emit charge(items)
  }
  on Ship {
    require status == paid else reject "not-paid"
    status' = shipped
  }
  on Cancel {
    require status in { draft, placed, paid } else reject "not-cancellable"
    require refunds == 0 else reject "refunded"
    if status == placed {
      // the charge is in progress: its answer decides whether a refund is owed
      status' = cancelling
    } else {
      status' = cancelled
      if status == paid {
        refunds' = refunds + 1
        emit refund(items)
      }
    }
  }
  on ChargeOk {
    require status in { placed, cancelling } else reject "not-placed"
    require refunds == 0 else reject "refunded"
    if status == placed {
      status' = paid
    } else {
      status' = cancelled
      refunds' = refunds + 1
      emit refund(items)
    }
  }
  on ChargeFailed {
    require status in { placed, cancelling } else reject "not-placed"
    if status == cancelling {
      status' = cancelled
    } else {
      if charges == 1 { status' = declined } else { status' = failed }
    }
  }
  on RetryPayment {
    require status == declined else reject "not-declined"
    require charges == 1 else reject "retried"
    status' = placed
    charges' = charges + 1
    emit charge(items)
  }

  effect charge(amount: int) {
    kind "payment.charge"
    labels { egress:external }
    class irreversible
    ok -> ChargeOk()
    failed -> ChargeFailed()
  }
  effect refund(amount: int) {
    kind "payment.refund"
    labels { egress:external }
    class irreversible
  }

  invariant shipped-was-paid: status == shipped implies charges >= 1
  invariant refund-only-after-charge: refunds <= charges
  invariant declined-after-one-charge: status == declined implies charges == 1
  path property charge-at-most-twice: count("payment.charge") <= 2
  path property refund-at-most-once: count("payment.refund") <= 1
  path property refund-after-charge: before("payment.charge", "payment.refund")
}
