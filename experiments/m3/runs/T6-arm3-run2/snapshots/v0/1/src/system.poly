module jobs

enum Status { none, queued, running, cancelling, succeeded, failed, cancelled }

machine Job {
  state {
    status   : Status = none
    tries    : 0..3   = 0
    maxTries : 0..3   = 0
  }
  terminal status in { succeeded, failed, cancelled }

  action Submit(maxTries: int check { 0, 1, 2, 3, 4 })
  action Claim()
  action Succeed()
  action Fail()
  action Cancel()

  on Submit(m) {
    require status == none else reject "job-exists"
    require m >= 1 && m <= 3 else reject "max-tries-out-of-range"
    status' = queued
    tries' = 0
    maxTries' = m
  }
  on Claim {
    require status == queued else reject "not-queued"
    require tries < maxTries else reject "no-tries-left"
    status' = running
    tries' = tries + 1
  }
  on Succeed {
    require status == running || status == cancelling else reject "not-running"
    status' = succeeded
  }
  on Fail {
    require status == running || status == cancelling else reject "not-running"
    if status == cancelling { status' = cancelled }
    else if tries < maxTries { status' = queued }
    else { status' = failed }
  }
  on Cancel {
    require status == queued || status == running else reject "not-cancellable"
    if status == queued { status' = cancelled }
    else { status' = cancelling }
  }

  invariant tries-within-limit: tries <= maxTries
  invariant submitted-has-limit: status != none implies maxTries >= 1
  invariant failed-only-on-last-try: status == failed implies tries == maxTries
  invariant running-has-tried: (status == running || status == cancelling) implies tries >= 1
  step property cancel-keeps-work: pre.status == cancelling && post.status != cancelling implies (post.status == succeeded || post.status == cancelled)
}
