// Electing a leader among three nodes: one election round, term 1.
module election

// Lowercase, so the host interface reads the roles as they are lowered.
type Role = follower | candidate | leader | down

service machine Node {
  state {
    role     : Role      = follower
    term     : 0..1      = 0
    votedFor : Ref<Node> = none
    votes    : 0..3      = 0          // votes counted as a candidate, its own included
    me       : Ref<Node> = none       // this node's own address
    peerA    : Ref<Node> = none
    peerB    : Ref<Node> = none
    knownLeader : Ref<Node> = none    // the leader this node knows in its term
    won      : bool      = false      // this node was elected leader in its term; survives a crash
  }
  action Timeout()
  action GiveUp()
  action Crash()
  action Recover()
  action RequestVote(from: Ref<Node>, term: 1..1)
  action VoteReply(term: 1..1, granted: bool)
  action Leader(from: Ref<Node>, term: 1..1)

  on Timeout {
    require role is follower && pre.term == 0 else reject "not-a-follower-in-term-0"
    role' = candidate
    term' = 1
    votedFor' = me
    votes' = 1
    send peerA <- RequestVote(from: me, term: 1)
    send peerB <- RequestVote(from: me, term: 1)
  }

  // The candidate keeps its vote for itself, so it grants no other vote in the term.
  on GiveUp {
    require role is candidate else reject "not-a-candidate"
    role' = follower
  }

  // Term, vote and known leader survive the crash; only the role is lost.
  on Crash {
    require !(role is down) else reject "down"
    role' = down
  }

  on Recover {
    require role is down else reject "not-down"
    role' = follower
  }

  on RequestVote(from, term) {
    require !(role is down) else reject "down"
    if pre.term == 0 {
      term' = 1
      votedFor' = from
      send from <- VoteReply(term: 1, granted: true)
    } else {
      if role is follower && (votedFor == none || votedFor == from) {
        votedFor' = from
        send from <- VoteReply(term: 1, granted: true)
      } else {
        send from <- VoteReply(term: 1, granted: false)
      }
    }
  }

  on VoteReply(term, granted) {
    require !(role is down) else reject "down"
    require role is candidate && pre.term == term else reject "not-a-candidate-in-term"
    require granted else reject "vote-not-granted"
    votes' = votes + 1
    if votes + 1 >= 2 {
      role' = leader
      won' = true
      knownLeader' = me
      send peerA <- Leader(from: me, term: 1)
      send peerB <- Leader(from: me, term: 1)
    }
  }

  on Leader(from, term) {
    require !(role is down) else reject "down"
    require !(role is leader) else reject "already-leader"
    term' = 1
    role' = follower
    knownLeader' = from
  }
}

configuration three-nodes {
  n0 : Node { me: n0, peerA: n1, peerB: n2 }
  n1 : Node { me: n1, peerA: n0, peerB: n2 }
  n2 : Node { me: n2, peerA: n0, peerB: n1 }
  inputs { n0.Timeout, n1.Timeout, n2.Timeout, n0.GiveUp, n1.GiveUp, n2.GiveUp,
           n0.Crash, n1.Crash, n2.Crash, n0.Recover, n1.Recover, n2.Recover }
  bounds { transit 6 }
  invariant one-leader:
    !(n0.role is leader && n1.role is leader) && !(n0.role is leader && n2.role is leader)
      && !(n1.role is leader && n2.role is leader)
  invariant one-elected:
    !(n0.won && n1.won) && !(n0.won && n2.won) && !(n1.won && n2.won)
  invariant leader-was-elected:
    (n0.role is leader implies n0.won) && (n1.role is leader implies n1.won)
      && (n2.role is leader implies n2.won)
  invariant elected-has-majority:
    (n0.won implies n0.votes >= 2) && (n1.won implies n1.votes >= 2) && (n2.won implies n2.votes >= 2)
  invariant elected-voted-for-itself:
    (n0.won implies n0.votedFor == n0.me) && (n1.won implies n1.votedFor == n1.me)
      && (n2.won implies n2.votedFor == n2.me)
  invariant leader-knows-itself:
    (n0.role is leader implies n0.knownLeader == n0.me) && (n1.role is leader implies n1.knownLeader == n1.me)
      && (n2.role is leader implies n2.knownLeader == n2.me)
  invariant known-leader-was-elected:
    (n0.knownLeader == none || (n0.knownLeader == n0.me && n0.won)
      || (n0.knownLeader == n1.me && n1.won) || (n0.knownLeader == n2.me && n2.won))
    && (n1.knownLeader == none || (n1.knownLeader == n0.me && n0.won)
      || (n1.knownLeader == n1.me && n1.won) || (n1.knownLeader == n2.me && n2.won))
    && (n2.knownLeader == none || (n2.knownLeader == n0.me && n0.won)
      || (n2.knownLeader == n1.me && n1.won) || (n2.knownLeader == n2.me && n2.won))
}
