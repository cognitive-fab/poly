module shop

// The inventory: one product, at most 3 units in all (available plus reserved).
service machine Inventory {
  state {
    available : 0..3 = 1
    reserved  : 0..3 = 0
    open      : bool = true
  }
  action Restock()
  action Close()
  action Open()
  action Reserve(from: Ref<Order>, qty: 1..2)
  action Release(qty: 1..2)

  on Restock {
    require open else reject "inventory-closed"
    require available + reserved < 3 else reject "inventory-full"
    available' = available + 1
  }
  on Close {
    require open else reject "inventory-closed"
    open' = false
  }
  on Open {
    require !open else reject "inventory-open"
    open' = true
  }
  on Reserve(from, qty) {
    if open && available >= qty {
      available' = available - qty
      reserved' = reserved + qty
      send from <- Reserved()
    } else {
      send from <- OutOfStock()
    }
  }
  on Release(qty) {
    require reserved >= qty else reject "not-reserved"
    reserved' = reserved - qty
    available' = available + qty
  }

  invariant within-capacity: available + reserved <= 3
}

type OrderStatus = new | pending | confirmed | rejected | cancelling | cancelled | expired

machine Order {
  state {
    status : OrderStatus = new
    qty    : 0..2 = 0
    inv    : Ref<Inventory> = none
  }
  terminal status is rejected | cancelled | expired

  action Place(qty: int check { 1, 2 } strict)
  action Cancel()
  action Expire()
  action Reduce()
  action Reserved()
  action OutOfStock()

  on Place(qty) {
    require status is new else reject "order-exists"
    require qty == 1 || qty == 2 else reject "invalid-qty"
    status' = pending
    qty' = qty
    send inv <- Reserve(from: self, qty: qty)
  }
  on Cancel {
    require status is confirmed | pending else reject "not-cancellable"
    if status is confirmed {
      status' = cancelled
      send inv <- Release(qty: qty)
    } else {
      status' = cancelling
    }
  }
  on Expire {
    require status is confirmed else reject "not-confirmed"
    status' = expired
    send inv <- Release(qty: qty)
  }
  on Reduce {
    require status is confirmed && qty == 2 else reject "not-reducible"
    qty' = 1
    send inv <- Release(qty: 1)
  }
  on Reserved {
    require status is pending | cancelling else reject "not-waiting"
    if status is pending {
      status' = confirmed
    } else {
      status' = cancelled
      send inv <- Release(qty: qty)
    }
  }
  on OutOfStock {
    require status is pending | cancelling else reject "not-waiting"
    if status is pending {
      status' = rejected
    } else {
      status' = cancelled
    }
  }
}

configuration shop-two-orders {
  inv      : Inventory
  order[2] : Order { inv: inv }
  inputs   { order[*].Place, order[*].Cancel, order[*].Expire, order[*].Reduce, inv.Restock, inv.Close, inv.Open }
  bounds   { transit 4 }
  invariant capacity: inv.available + inv.reserved <= 3
}
