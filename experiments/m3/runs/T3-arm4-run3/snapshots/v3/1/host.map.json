{
  "$schema": "./host.map.schema.json",
  "module": "payments",
  "instances": {
    "payments": { "machine": "Payment", "createdBy": "authorize", "keyArgument": "payment" }
  },
  "methods": {
    "authorize": { "instance": "payments", "key": "$arg:payment", "action": "Authorize", "params": { "amount": "$arg:amount" } },
    "timedOut": { "instance": "payments", "key": "$arg:payment", "action": "TimedOut" },
    "capture": { "instance": "payments", "key": "$arg:payment", "action": "Capture", "params": { "amount": "$arg:amount" } },
    "void": { "instance": "payments", "key": "$arg:payment", "action": "Void" },
    "increase": { "instance": "payments", "key": "$arg:payment", "action": "Increase" },
    "expire": { "instance": "payments", "key": "$arg:payment", "action": "Expire" },
    "refund": { "instance": "payments", "key": "$arg:payment", "action": "Refund", "params": { "amount": "$arg:amount" } }
  },
  "queries": {
    "payment": {
      "instance": "payments",
      "key": "$arg:payment",
      "fields": { "status": "status", "authorized": "authorizedAmount", "captured": "capturedAmount", "refunded": "refundedAmount", "requests": "requests" }
    }
  }
}
