module system

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status : RunStatus  = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
  }
  terminal status is RunStatus.completed | RunStatus.failed | RunStatus.cancelled

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus)

  on Start {
    require status is RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status is RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 is TaskStatus.assigned { send w0 <- Abort() }
    if task1 is TaskStatus.assigned { send w1 <- Abort() }
  }

  on Report(task, outcome) {
    require status is RunStatus.running | RunStatus.cancelling else reject "not-active"
    require outcome is TaskStatus.completed | TaskStatus.failed | TaskStatus.cancelled else reject "bad-outcome"
    if task == 0 {
      require task0 is TaskStatus.assigned else reject "already-reported"
      task0' = outcome
      if !(task1 is TaskStatus.assigned) {
        if outcome is TaskStatus.completed && task1 is TaskStatus.completed {
          status' = RunStatus.completed
        } else {
          if outcome is TaskStatus.failed || task1 is TaskStatus.failed {
            status' = RunStatus.failed
          } else {
            status' = RunStatus.cancelled
          }
        }
      }
    } else {
      require task1 is TaskStatus.assigned else reject "already-reported"
      task1' = outcome
      if !(task0 is TaskStatus.assigned) {
        if outcome is TaskStatus.completed && task0 is TaskStatus.completed {
          status' = RunStatus.completed
        } else {
          if outcome is TaskStatus.failed || task0 is TaskStatus.failed {
            status' = RunStatus.failed
          } else {
            status' = RunStatus.cancelled
          }
        }
      }
    }
  }

  invariant completed-means-both: status is RunStatus.completed implies (task0 is TaskStatus.completed && task1 is TaskStatus.completed)
  invariant ended-means-reported: status is RunStatus.completed | RunStatus.failed | RunStatus.cancelled implies (!(task0 is TaskStatus.assigned) && !(task1 is TaskStatus.assigned))
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }

  action Assign()
  action Abort()
  action Done()
  action Fail()

  on Assign {
    require status is WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status is WorkerStatus.busy else reject "idle"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled)
  }

  on Done {
    require status is WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed)
  }

  on Fail {
    require status is WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed)
  }
}

configuration one-run {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, worker0.Done, worker0.Fail, worker1.Done, worker1.Fail }
  bounds  { transit 4 }
  invariant completed-only-when-both: run.status is RunStatus.completed implies (run.task0 is TaskStatus.completed && run.task1 is TaskStatus.completed)
  invariant ends-only-when-both-reported: run.status is RunStatus.completed | RunStatus.failed | RunStatus.cancelled implies (!(run.task0 is TaskStatus.assigned) && !(run.task1 is TaskStatus.assigned))
  invariant reported-task-is-not-in-progress: (!(run.task0 is TaskStatus.assigned) implies worker0.status is WorkerStatus.idle) && (!(run.task1 is TaskStatus.assigned) implies worker1.status is WorkerStatus.idle)
}
