module system

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status : RunStatus  = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
    retried0 : bool = false
    retried1 : bool = false
    processed : 0..4 = 0
  }
  terminal status is completed | failed | cancelled

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus, items: 0..2)
  action Timeout(task: int check 0..1 strict)

  // the task is recorded as failed for the last time, and its worker is told to stop
  on Timeout(task) {
    require status is running | cancelling else reject "not-active"
    if task == 0 {
      require task0 is assigned else reject "not-assigned"
      task0' = TaskStatus.failed
      if !(task1 is assigned) { status' = RunStatus.failed }
      send w0 <- Abort()
    } else {
      require task1 is assigned else reject "not-assigned"
      task1' = TaskStatus.failed
      if !(task0 is assigned) { status' = RunStatus.failed }
      send w1 <- Abort()
    }
  }

  on Start {
    require status is idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status is running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 is assigned { send w0 <- Abort() }
    if task1 is assigned { send w1 <- Abort() }
  }

  on Report(task, outcome, items) {
    require status is running | cancelling else reject "not-active"
    require outcome is completed | failed | cancelled else reject "bad-outcome"
    if task == 0 {
      require task0 is assigned else reject "already-reported"
      if outcome is failed && status is running && !retried0 {
        // the first failure while running: the task is assigned again
        retried0' = true
        send w0 <- Assign()
      } else {
        task0' = outcome
        if outcome is completed { processed' = processed + items }
        if !(task1 is assigned) {
          if outcome is completed && task1 is completed {
            status' = RunStatus.completed
          } else {
            if outcome is failed || task1 is failed {
              status' = RunStatus.failed
            } else {
              status' = RunStatus.cancelled
            }
          }
        }
      }
    } else {
      require task1 is assigned else reject "already-reported"
      if outcome is failed && status is running && !retried1 {
        retried1' = true
        send w1 <- Assign()
      } else {
        task1' = outcome
        if outcome is completed { processed' = processed + items }
        if !(task0 is assigned) {
          if outcome is completed && task0 is completed {
            status' = RunStatus.completed
          } else {
            if outcome is failed || task0 is failed {
              status' = RunStatus.failed
            } else {
              status' = RunStatus.cancelled
            }
          }
        }
      }
    }
  }

  invariant completed-means-both: status is completed implies (task0 is completed && task1 is completed)
  invariant ended-means-reported: status is completed | failed | cancelled implies (!(task0 is assigned) && !(task1 is assigned))
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }

  action Assign()
  action Abort()
  action Done(items: int check 1..2 strict)
  action Fail()

  on Assign {
    require status is idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status is busy else reject "idle"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled, items: 0)
  }

  on Done(items) {
    require status is busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed, items: items)
  }

  on Fail {
    require status is busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed, items: 0)
  }
}

configuration one-run {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, run.Timeout, worker0.Done, worker0.Fail, worker1.Done, worker1.Fail }
  bounds  { transit 8 }
  invariant completed-only-when-both: run.status is completed implies (run.task0 is completed && run.task1 is completed)
  invariant ends-only-when-both-reported: run.status is completed | failed | cancelled implies (!(run.task0 is assigned) && !(run.task1 is assigned))
  invariant counts-only-completions: (!(run.task0 is completed) && !(run.task1 is completed)) implies run.processed == 0
  invariant counts-one-to-two-per-completion: ((run.task0 is completed && run.task1 is completed) implies run.processed >= 2) && (!(run.task0 is completed && run.task1 is completed) implies run.processed <= 2)
  invariant completed-task-is-not-in-progress: (run.task0 is completed implies worker0.status is idle) && (run.task1 is completed implies worker1.status is idle)
}
