// Workflow run status: one Run per run id, three tasks, and the run's status derived from them.
module workflow

// idle is the state of a run before start; the adapter never shows it, since a refused start leaves no run.
enum Status { idle, queued, running, evicted, completed, failed, cancelled }

machine Run {
  state {
    status : Status = idle
    task0  : Status = queued
    task1  : Status = queued
    task2  : Status = queued
  }
  // A failed run can retry its failed task, so only completed and cancelled are final.
  terminal status in { completed, cancelled }

  action Start()
  action TaskStarted(task: int check 0..2 strict)
  action TaskCompleted(task: int check 0..2 strict)
  action TaskFailed(task: int check 0..2 strict)
  action TaskEvicted(task: int check 0..2 strict)
  action TaskRequeued(task: int check 0..2 strict)
  action TaskRetried(task: int check 0..2 strict)
  action Cancel()

  on Start {
    require status == idle else reject "run-exists"
    status' = queued
  }

  // Each task move derives the status from the moved task's new value and the other two (a, b), by the
  // brief's rules: all the same, else any failed, else any in flight, else cancelled. The invariants below
  // check every derivation against the rules.

  // queued -> running: running when no other task failed (all running included), failed otherwise.
  on TaskStarted(task) {
    require status != idle else reject "unknown-run"
    if task == 0 {
      require task0 == queued else reject "task-not-queued"
      task0' = running
      if task1 == failed || task2 == failed { status' = failed } else { status' = running }
    } else {
      if task == 1 {
        require task1 == queued else reject "task-not-queued"
        task1' = running
        if task0 == failed || task2 == failed { status' = failed } else { status' = running }
      } else {
        require task2 == queued else reject "task-not-queued"
        task2' = running
        if task0 == failed || task1 == failed { status' = failed } else { status' = running }
      }
    }
  }

  // running -> completed.
  on TaskCompleted(task) {
    require status != idle else reject "unknown-run"
    if task == 0 {
      require task0 == running else reject "task-not-running"
      task0' = completed
      if task1 == completed && task2 == completed { status' = completed }
      else { if task1 == failed || task2 == failed { status' = failed }
      else { if task1 in { queued, running, evicted } || task2 in { queued, running, evicted } { status' = running }
      else { status' = cancelled } } }
    } else {
      if task == 1 {
        require task1 == running else reject "task-not-running"
        task1' = completed
        if task0 == completed && task2 == completed { status' = completed }
        else { if task0 == failed || task2 == failed { status' = failed }
        else { if task0 in { queued, running, evicted } || task2 in { queued, running, evicted } { status' = running }
        else { status' = cancelled } } }
      } else {
        require task2 == running else reject "task-not-running"
        task2' = completed
        if task0 == completed && task1 == completed { status' = completed }
        else { if task0 == failed || task1 == failed { status' = failed }
        else { if task0 in { queued, running, evicted } || task1 in { queued, running, evicted } { status' = running }
        else { status' = cancelled } } }
      }
    }
  }

  // running -> failed; a failed task fails the run.
  on TaskFailed(task) {
    require status != idle else reject "unknown-run"
    if task == 0 {
      require task0 == running else reject "task-not-running"
      task0' = failed
    } else {
      if task == 1 {
        require task1 == running else reject "task-not-running"
        task1' = failed
      } else {
        require task2 == running else reject "task-not-running"
        task2' = failed
      }
    }
    status' = failed
  }

  // running -> evicted: evicted when all are, else failed when another failed, else running.
  on TaskEvicted(task) {
    require status != idle else reject "unknown-run"
    if task == 0 {
      require task0 == running else reject "task-not-running"
      task0' = evicted
      if task1 == evicted && task2 == evicted { status' = evicted }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == running else reject "task-not-running"
        task1' = evicted
        if task0 == evicted && task2 == evicted { status' = evicted }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == running else reject "task-not-running"
        task2' = evicted
        if task0 == evicted && task1 == evicted { status' = evicted }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // evicted -> queued: queued when all are, else failed when another failed, else running.
  on TaskRequeued(task) {
    require status != idle else reject "unknown-run"
    if task == 0 {
      require task0 == evicted else reject "task-not-evicted"
      task0' = queued
      if task1 == queued && task2 == queued { status' = queued }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == evicted else reject "task-not-evicted"
        task1' = queued
        if task0 == queued && task2 == queued { status' = queued }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == evicted else reject "task-not-evicted"
        task2' = queued
        if task0 == queued && task1 == queued { status' = queued }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // failed -> queued: queued when all are, else failed when another failed, else running.
  on TaskRetried(task) {
    require status != idle else reject "unknown-run"
    if task == 0 {
      require task0 == failed else reject "task-not-failed"
      task0' = queued
      if task1 == queued && task2 == queued { status' = queued }
      else { if task1 == failed || task2 == failed { status' = failed } else { status' = running } }
    } else {
      if task == 1 {
        require task1 == failed else reject "task-not-failed"
        task1' = queued
        if task0 == queued && task2 == queued { status' = queued }
        else { if task0 == failed || task2 == failed { status' = failed } else { status' = running } }
      } else {
        require task2 == failed else reject "task-not-failed"
        task2' = queued
        if task0 == queued && task1 == queued { status' = queued }
        else { if task0 == failed || task1 == failed { status' = failed } else { status' = running } }
      }
    }
  }

  // Every task in flight is cancelled, so at least one is; the run is failed when a task failed, else cancelled.
  on Cancel {
    require status != idle else reject "unknown-run"
    require task0 in { queued, running, evicted } || task1 in { queued, running, evicted } || task2 in { queued, running, evicted } else reject "nothing-in-flight"
    if task0 in { queued, running, evicted } { task0' = cancelled }
    if task1 in { queued, running, evicted } { task1' = cancelled }
    if task2 in { queued, running, evicted } { task2' = cancelled }
    if task0 == failed || task1 == failed || task2 == failed { status' = failed } else { status' = cancelled }
  }

  // The brief's derivation, rule by rule, in every started run.
  invariant rule-same: (status != idle && task0 == task1 && task1 == task2) implies status == task0
  invariant rule-failed: (status != idle && !(task0 == task1 && task1 == task2) && (task0 == failed || task1 == failed || task2 == failed)) implies status == failed
  invariant rule-running: (status != idle && !(task0 == task1 && task1 == task2) && !(task0 == failed || task1 == failed || task2 == failed) && (task0 in { queued, running, evicted } || task1 in { queued, running, evicted } || task2 in { queued, running, evicted })) implies status == running
  invariant rule-cancelled: (status != idle && !(task0 == task1 && task1 == task2) && !(task0 == failed || task1 == failed || task2 == failed) && !(task0 in { queued, running, evicted } || task1 in { queued, running, evicted } || task2 in { queued, running, evicted })) implies status == cancelled
  invariant idle-all-queued: status == idle implies (task0 == queued && task1 == queued && task2 == queued)
  invariant tasks-never-idle: task0 != idle && task1 != idle && task2 != idle
}
