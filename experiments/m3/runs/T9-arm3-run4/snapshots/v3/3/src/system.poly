module election

type Role = follower | candidate | leader

// A node never terminates: after the election it keeps answering, so it is a service.
service machine Node {
  state {
    role        : Role      = follower
    term        : 0..1      = 0
    votedFor    : Ref<Node> = none
    votes       : 0..3      = 0
    me          : Ref<Node> = none
    peerA       : Ref<Node> = none
    peerB       : Ref<Node> = none
    knownLeader : Ref<Node> = none        // the leader this node knows in its term (`leader` in the host)
  }

  action Timeout()
  action GiveUp()
  action RequestVote(from: Ref<Node>, term: 1..1)
  action VoteReply(term: 1..1, granted: bool)
  action Leader(from: Ref<Node>, term: 1..1)

  on Timeout {
    require !(role is down) else reject "down"
    require role is follower && pre.term == 0 else reject "not-a-follower-in-term-0"
    role' = candidate
    term' = 1
    votedFor' = me
    votes' = 1
    send peerA <- RequestVote(from: me, term: 1)
    send peerB <- RequestVote(from: me, term: 1)
  }

  // A candidate gives up: a follower in the same term that keeps its vote for itself, so it grants no other
  // vote and, no longer a candidate, ignores later replies.
  on GiveUp {
    require role is candidate else reject "not-a-candidate"
    role' = follower
  }

  // A node crashes; its term, vote and known leader are on disk and survive. A down node ignores (rejects)
  // every message delivered to it.
  on Crash {
    require !(role is down) else reject "down"
    role' = down
  }

  // A down node comes back as a follower in the same term, with the same vote and known leader.
  on Recover {
    require role is down else reject "not-down"
    role' = follower
    votes' = 0
  }

  // A node votes at most once in term 1: for the first candidate that asks, unless it is a candidate itself.
  on RequestVote(from, term) {
    require !(role is down) else reject "down"
    if pre.term == 0 {
      term' = 1
      votedFor' = from
      send from <- VoteReply(term: 1, granted: true)
    } else {
      if role is follower && votedFor == none {
        votedFor' = from
        send from <- VoteReply(term: 1, granted: true)
      } else {
        send from <- VoteReply(term: 1, granted: role is follower && votedFor == from)
      }
    }
  }

  // A candidate counts a granted vote; any other reply is ignored (rejected, changing nothing).
  // On its second vote it leads, and announces itself to the other two nodes.
  on VoteReply(term, granted) {
    require role is candidate && pre.term == 1 else reject "not-a-candidate"
    require granted else reject "vote-not-granted"
    require votes < 3 else reject "votes-full"
    votes' = votes + 1
    if votes + 1 >= 2 {
      role' = leader
      knownLeader' = me
      send peerA <- Leader(from: me, term: 1)
      send peerB <- Leader(from: me, term: 1)
    }
  }

  // The announced leader is recorded; a node in term 0 joins term 1 without voting, a candidate steps down
  // and keeps its vote for itself.
  on Leader(from, term) {
    require !(role is down) else reject "down"
    require !(role is leader) else reject "already-leader"
    knownLeader' = from
    if pre.term == 0 { term' = 1 }
    if role is candidate { role' = follower }
  }

  invariant leader-in-term-1: role is leader implies term == 1
  invariant leader-knows-itself: role is leader implies knownLeader == me
}

configuration three-nodes {
  n0 : Node { me: n0, peerA: n1, peerB: n2 }
  n1 : Node { me: n1, peerA: n0, peerB: n2 }
  n2 : Node { me: n2, peerA: n0, peerB: n1 }
  inputs { n0.Timeout, n1.Timeout, n2.Timeout, n0.GiveUp, n1.GiveUp, n2.GiveUp }
  bounds { transit 8 }
  invariant one-leader: !(n0.role is leader && n1.role is leader) && !(n0.role is leader && n2.role is leader) && !(n1.role is leader && n2.role is leader)
  invariant leader-has-majority: (n0.role is leader implies (n1.votedFor == n0.me || n2.votedFor == n0.me)) && (n1.role is leader implies (n0.votedFor == n1.me || n2.votedFor == n1.me)) && (n2.role is leader implies (n0.votedFor == n2.me || n1.votedFor == n2.me))
  invariant leader-voted-for-itself: (n0.role is leader implies n0.votedFor == n0.me) && (n1.role is leader implies n1.votedFor == n1.me) && (n2.role is leader implies n2.votedFor == n2.me)
  invariant known-leader-leads: (n0.knownLeader == n1.me implies n1.role is leader) && (n0.knownLeader == n2.me implies n2.role is leader) && (n1.knownLeader == n0.me implies n0.role is leader) && (n1.knownLeader == n2.me implies n2.role is leader) && (n2.knownLeader == n0.me implies n0.role is leader) && (n2.knownLeader == n1.me implies n1.role is leader)
}
