module workflow

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

service machine Run {
  state {
    status  : RunStatus = RunStatus.idle
    task0   : TaskStatus = TaskStatus.idle
    task1   : TaskStatus = TaskStatus.idle
    worker0 : Ref<Worker> = none
    worker1 : Ref<Worker> = none
  }
  terminal status is RunStatus.completed | RunStatus.failed | RunStatus.cancelled
  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus)

  on Start {
    require status is RunStatus.idle else reject "already-started"
    status' = running
    task0' = assigned
    task1' = assigned
    send worker0 <- Assign()
    send worker1 <- Assign()
  }
  on Cancel {
    require status is running else reject "not-running"
    status' = cancelling
    if task0 is assigned { send worker0 <- Abort() }
    if task1 is assigned { send worker1 <- Abort() }
  }
  on Report(task, outcome) {
    require status is running | cancelling else reject "run-ended"
    require outcome is TaskStatus.completed | TaskStatus.failed | TaskStatus.cancelled else reject "bad-outcome"
    if task == 0 {
      require task0 is assigned else reject "already-reported"
      task0' = outcome
      if task1 is assigned {
      } else {
        if outcome is TaskStatus.completed && task1 is TaskStatus.completed {
          status' = RunStatus.completed
        } else {
          if outcome is TaskStatus.failed || task1 is TaskStatus.failed { status' = RunStatus.failed } else { status' = RunStatus.cancelled }
        }
      }
    } else {
      require task1 is assigned else reject "already-reported"
      task1' = outcome
      if task0 is assigned {
      } else {
        if outcome is TaskStatus.completed && task0 is TaskStatus.completed {
          status' = RunStatus.completed
        } else {
          if outcome is TaskStatus.failed || task0 is TaskStatus.failed { status' = RunStatus.failed } else { status' = RunStatus.cancelled }
        }
      }
    }
  }

  invariant completed-means-both: status is RunStatus.completed implies (task0 is TaskStatus.completed && task1 is TaskStatus.completed)
  invariant ended-means-both-reported: status is RunStatus.completed | RunStatus.failed | RunStatus.cancelled implies (!(task0 is TaskStatus.assigned) && !(task1 is TaskStatus.assigned))
}

machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }
  action Assign()
  action Abort()
  action Done()
  action Failed()

  on Assign {
    require status is WorkerStatus.idle else reject "busy"
    status' = busy
  }
  on Abort {
    require status is busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled)
  }
  on Done {
    require status is busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed)
  }
  on Failed {
    require status is busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed)
  }
}

configuration system {
  run     : Run { worker0: worker0, worker1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, worker0.Done, worker0.Failed, worker1.Done, worker1.Failed }
  bounds  { transit 4 }
  invariant completed-only-when-both-done: run.status is RunStatus.completed implies (run.task0 is TaskStatus.completed && run.task1 is TaskStatus.completed)
  invariant ended-workers-idle: run.status is RunStatus.completed | RunStatus.failed | RunStatus.cancelled implies (worker0.status is WorkerStatus.idle && worker1.status is WorkerStatus.idle)
}
