module workflow

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status  : RunStatus = RunStatus.idle
    task0   : TaskStatus = TaskStatus.idle
    task1   : TaskStatus = TaskStatus.idle
    retried0 : bool = false
    retried1 : bool = false
    processed : 0..4 = 0
    worker0 : Ref<Worker> = none
    worker1 : Ref<Worker> = none
  }
  terminal status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled }
  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus, items: 0..2)
  action Timeout(task: int check 0..1 strict)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send worker0 <- Assign()
    send worker1 <- Assign()
  }
  on Cancel {
    require status == RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 == TaskStatus.assigned { send worker0 <- Abort() }
    if task1 == TaskStatus.assigned { send worker1 <- Abort() }
  }
  // a timeout records the task as failed for the last time, and aborts its worker
  on Timeout(task) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "not-running"
    require task == 0 || task == 1 else reject "unknown-task"
    if task == 0 {
      require task0 == TaskStatus.assigned else reject "not-assigned"
      task0' = TaskStatus.failed
      if task1 != TaskStatus.assigned { status' = RunStatus.failed }
      send worker0 <- Abort()
    } else {
      require task1 == TaskStatus.assigned else reject "not-assigned"
      task1' = TaskStatus.failed
      if task0 != TaskStatus.assigned { status' = RunStatus.failed }
      send worker1 <- Abort()
    }
  }
  on Report(task, outcome) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "run-ended"
    require outcome in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled } else reject "bad-outcome"
    if task == 0 {
      require task0 == TaskStatus.assigned else reject "already-reported"
      if outcome == TaskStatus.failed && status == RunStatus.running && !retried0 {
        // the first failure while running: one more chance, the task stays assigned
        retried0' = true
        send worker0 <- Assign()
      } else {
      task0' = outcome
      if outcome == TaskStatus.completed { processed' = processed + items }
      if task1 != TaskStatus.assigned {
        if outcome == TaskStatus.completed && task1 == TaskStatus.completed {
          status' = RunStatus.completed
        } else {
          if outcome == TaskStatus.failed || task1 == TaskStatus.failed { status' = RunStatus.failed } else { status' = RunStatus.cancelled }
        }
      }
      }
    } else {
      require task1 == TaskStatus.assigned else reject "already-reported"
      if outcome == TaskStatus.failed && status == RunStatus.running && !retried1 {
        retried1' = true
        send worker1 <- Assign()
      } else {
      task1' = outcome
      if outcome == TaskStatus.completed { processed' = processed + items }
      if task0 != TaskStatus.assigned {
        if outcome == TaskStatus.completed && task0 == TaskStatus.completed {
          status' = RunStatus.completed
        } else {
          if outcome == TaskStatus.failed || task0 == TaskStatus.failed { status' = RunStatus.failed } else { status' = RunStatus.cancelled }
        }
      }
      }
    }
  }

  invariant completed-means-both: status == RunStatus.completed implies (task0 == TaskStatus.completed && task1 == TaskStatus.completed)
  invariant ended-means-both-reported: status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled } implies (task0 != TaskStatus.assigned && task1 != TaskStatus.assigned)
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }
  action Assign()
  action Abort()
  action Done(items: int check 1..2 strict)
  action Failed()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }
  on Abort {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled, items: 0)
  }
  on Done(items) {
    require items == 1 || items == 2 else reject "bad-items"
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed, items: items)
  }
  on Failed {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed, items: 0)
  }
}

configuration system {
  run     : Run { worker0: worker0, worker1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, run.Timeout, worker0.Done, worker0.Failed, worker1.Done, worker1.Failed }
  bounds  { transit 6 }
  invariant completed-only-when-both-done: run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
  // with timeouts a worker may still turn busy after the run has ended: an Abort that overtakes its Assign is
  // ignored by the idle worker, as the brief says, so an ended run does not imply idle workers.
  invariant ended-run-both-reported: run.status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled } implies (run.task0 != TaskStatus.assigned && run.task1 != TaskStatus.assigned)
}
