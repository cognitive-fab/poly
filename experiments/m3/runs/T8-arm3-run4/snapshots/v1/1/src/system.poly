// T8: a consensus node's role and term.
module consensus

type Role = follower | candidate | leader | shutdown

machine Node {
  state {
    role : Role = follower
    term : 0..3 = 0
  }
  terminal role is shutdown

  action ElectionTimeout()
  action ElectionWon()
  action NewerTermSeen(t: int check { 0, 1, 2, 3, 4 })
  action QuorumLost()
  action Shutdown()

  on ElectionTimeout {
    require role != shutdown else reject "shut-down"
    require role != leader else reject "is-leader"
    require term < 3 else reject "last-term"
    role' = candidate
    term' = term + 1
  }
  on ElectionWon {
    require role != shutdown else reject "shut-down"
    require role == candidate else reject "not-candidate"
    role' = leader
  }
  on NewerTermSeen(t) {
    require role != shutdown else reject "shut-down"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t > term else reject "not-newer"
    role' = follower
    term' = t
  }
  on QuorumLost {
    require role != shutdown else reject "shut-down"
    require role == leader else reject "not-leader"
    role' = follower
  }
  on VoteRequested(c, t) {
    require role != shutdown else reject "shut-down"
    require c == "n1" || c == "n2" else reject "unknown-candidate"
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t >= term else reject "stale-term"
    if t > term {
      role' = follower
      term' = t
      if c == "n1" { votedFor' = n1 } else { votedFor' = n2 }
    } else {
      require role == follower else reject "not-follower"
      if c == "n1" {
        require votedFor == nobody || votedFor == n1 else reject "already-voted"
        votedFor' = n1
      } else {
        require votedFor == nobody || votedFor == n2 else reject "already-voted"
        votedFor' = n2
      }
    }
  }
  on Shutdown {
    require role != shutdown else reject "shut-down"
    role' = shutdown
  }

  invariant leader-has-term: role == leader implies term >= 1
  step property term-never-decreases: post.term >= pre.term
  step property term-changes-only-by-election-or-newer:
    post.term != pre.term implies (action == ElectionTimeout || action == NewerTermSeen)
  step property leader-was-candidate:
    (post.role == leader && pre.role != leader) implies (pre.role == candidate && pre.term == post.term)
  step property shutdown-is-final: pre.role == shutdown implies post.role == shutdown
}
