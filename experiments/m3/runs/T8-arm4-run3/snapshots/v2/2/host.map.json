{
  "module": "consensus",
  "instances": {
    "node": { "machine": "Node" }
  },
  "methods": {
    "electionTimeout": { "instance": "node", "action": "ElectionTimeout" },
    "electionWon": { "instance": "node", "action": "ElectionWon" },
    "newerTermSeen": { "instance": "node", "action": "NewerTermSeen", "params": { "newTerm": "$arg:term" } },
    "quorumLost": { "instance": "node", "action": "QuorumLost" },
    "shutdown": { "instance": "node", "action": "Shutdown" },
    "voteRequested": { "instance": "node", "action": "VoteRequested", "params": { "candidate": "$arg:candidate", "voteTerm": "$arg:term" } }
  },
  "queries": {
    "node": { "instance": "node", "fields": { "role": "role", "term": "term", "votedFor": "votedFor" } }
  }
}
