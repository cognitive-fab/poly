{
  "module": "shop",
  "instances": {
    "inventory": { "machine": "Inventory" },
    "payments": { "machine": "Payments" },
    "carts": {
      "machine": "Cart",
      "createdBy": "open",
      "keyArgument": "cart",
      "init": { "inv": "inventory", "pay": "payments" }
    }
  },
  "methods": {
    "open": { "instance": "carts", "key": "$arg:cart", "action": "Open" },
    "add": { "instance": "carts", "key": "$arg:cart", "action": "Add" },
    "checkout": { "instance": "carts", "key": "$arg:cart", "action": "Checkout" },
    "cancel": { "instance": "carts", "key": "$arg:cart", "action": "Cancel" },
    "returnCart": { "instance": "carts", "key": "$arg:cart", "action": "Return" },
    "retry": { "instance": "carts", "key": "$arg:cart", "action": "Retry" },
    "abandon": { "instance": "carts", "key": "$arg:cart", "action": "Abandon" },
    "declineCards": { "instance": "payments", "action": "DeclineCards" },
    "acceptCards": { "instance": "payments", "action": "AcceptCards" }
  },
  "queries": {
    "cart": { "instance": "carts", "key": "$arg:cart", "fields": { "status": "status", "items": "items" } },
    "stock": { "instance": "inventory", "fields": { "available": "available", "reserved": "reserved" } },
    "payments": { "instance": "payments", "fields": { "charged": "charged", "declining": "declining" } }
  }
}
