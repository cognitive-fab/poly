{
  "effects": {
    "payment.charge": {
      "payloadSchema": {
        "amount": {
          "type": "number",
          "required": true
        }
      },
      "labels": [
        "egress:external"
      ],
      "onSuccess": {
        "action": "ChargeOk"
      },
      "onFailure": {
        "action": "ChargeFailed"
      },
      "class": "irreversible"
    },
    "payment.refund": {
      "payloadSchema": {
        "amount": {
          "type": "number",
          "required": true
        }
      },
      "labels": [
        "egress:external"
      ],
      "onSuccess": {
        "action": "RefundAnswered"
      },
      "onFailure": {
        "action": "RefundAnswered"
      },
      "class": "irreversible"
    }
  }
}
