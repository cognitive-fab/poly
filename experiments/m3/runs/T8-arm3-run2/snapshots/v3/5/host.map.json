{
  "module": "consensus",
  "instances": { "node": { "machine": "Node" } },
  "methods": {
    "electionTimeout": { "instance": "node", "action": "ElectionTimeout" },
    "electionWon": { "instance": "node", "action": "ElectionWon" },
    "newerTermSeen": { "instance": "node", "action": "NewerTermSeen", "params": { "t": "$arg:term" } },
    "electionLost": { "instance": "node", "action": "ElectionLost" },
    "pause": { "instance": "node", "action": "Pause" },
    "resume": { "instance": "node", "action": "Resume" },
    "quorumLost": { "instance": "node", "action": "QuorumLost" },
    "shutdown": { "instance": "node", "action": "Shutdown" },
    "voteRequested": { "instance": "node", "action": "VoteRequested", "params": { "c": "$arg:candidate", "t": "$arg:term" } }
  },
  "queries": { "node": { "instance": "node", "fields": { "role": "role", "term": "term", "votedFor": "votedFor" } } }
}
