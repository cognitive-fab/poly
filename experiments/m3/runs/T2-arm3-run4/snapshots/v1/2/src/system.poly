module shop

enum Status { idle, pending, confirmed, rejected, cancelling, cancelled }

service machine Inventory {
  state {
    available : 0..3 = 1
    reserved  : 0..3 = 0
  }
  action Restock()
  action Reserve(from: Ref<Order>, qty: 1..2)
  action Release(qty: 1..2)

  on Restock {
    require available + reserved < 3 else reject "inventory-full"
    available' = available + 1
  }
  on Reserve(from, qty) {
    if available >= qty {
      available' = available - qty
      reserved' = reserved + qty
      send from <- Reserved()
    } else {
      send from <- OutOfStock()
    }
  }
  on Release(qty) {
    require reserved >= qty else reject "not-reserved"
    reserved' = reserved - qty
    available' = available + qty
  }

  invariant within-capacity: available + reserved <= 3
}

machine Order {
  state {
    status : Status = idle
    qty    : 0..2 = 0
    inv    : Ref<Inventory> = none
  }
  terminal status in { rejected, cancelled }
  action Place(qty: int check { 1, 2 } strict)
  action Cancel()
  action Expire()
  action Reserved()
  action OutOfStock()

  on Place(qty) {
    require status == idle else reject "order-exists"
    status' = pending
    qty' = qty
    send inv <- Reserve(from: self, qty: qty)
  }
  on Cancel {
    require status == pending || status == confirmed else reject "not-cancellable"
    if status == confirmed {
      status' = cancelled
      send inv <- Release(qty: qty)
    } else {
      status' = cancelling
    }
  }
  on Expire {
    require status == confirmed else reject "not-confirmed"
    status' = expired
    send inv <- Release(qty: qty)
  }
  on Reserved {
    require status == pending || status == cancelling else reject "not-waiting"
    if status == pending {
      status' = confirmed
    } else {
      status' = cancelled
      send inv <- Release(qty: qty)
    }
  }
  on OutOfStock {
    require status == pending || status == cancelling else reject "not-waiting"
    if status == pending {
      status' = rejected
    } else {
      status' = cancelled
    }
  }

  invariant placed-has-qty: status != idle implies qty > 0
}

configuration two-orders {
  inv      : Inventory
  order[2] : Order { inv: inv }
  inputs   { inv.Restock, order[*].Place, order[*].Cancel }
  bounds   { transit 4 }
  invariant confirmed-within-reserved: count(order[*] is confirmed) <= inv.reserved
  invariant confirmed-qty-reserved: forall i in order: order[i] is confirmed implies order[i].qty <= inv.reserved
}
