// T7: a run and its two workers, which talk by messages.
module system

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy
type Phase = waiting | working | finished

machine Run {
  state {
    status : RunStatus  = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
  }
  terminal status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled }

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status == RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 == TaskStatus.assigned { send w0 <- Abort() }
    if task1 == TaskStatus.assigned { send w1 <- Abort() }
  }

  on Report(task, outcome) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "ended"
    require outcome in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled } else reject "bad-outcome"
    if task == 0 {
      require task0 == TaskStatus.assigned else reject "already-reported"
      task0' = outcome
      if task1 != TaskStatus.assigned {
        if outcome == TaskStatus.completed && task1 == TaskStatus.completed { status' = RunStatus.completed }
        else { if outcome == TaskStatus.failed || task1 == TaskStatus.failed { status' = RunStatus.failed }
               else { status' = RunStatus.cancelled } }
      }
    } else {
      require task1 == TaskStatus.assigned else reject "already-reported"
      task1' = outcome
      if task0 != TaskStatus.assigned {
        if outcome == TaskStatus.completed && task0 == TaskStatus.completed { status' = RunStatus.completed }
        else { if outcome == TaskStatus.failed || task0 == TaskStatus.failed { status' = RunStatus.failed }
               else { status' = RunStatus.cancelled } }
      }
    }
  }

  invariant completed-when-both: status == RunStatus.completed implies (task0 == TaskStatus.completed && task1 == TaskStatus.completed)
  invariant ended-when-both-reported:
    (status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled })
      implies (task0 in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled }
               && task1 in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled })
}

machine Worker {
  state {
    phase  : Phase = waiting                    // a worker does its one task once, then it is finished
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }
  terminal phase == finished

  action Assign()
  action Abort()
  action WorkDone()
  action WorkFailed()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status == WorkerStatus.busy else reject "idle"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled)
  }

  on WorkDone {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed)
  }

  on WorkFailed {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed)
  }
}

configuration system {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 4 }
  invariant run-completed-only-when-both-done:
    run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
  invariant run-ends-only-when-workers-idle:
    run.status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled }
      implies (worker0.status == WorkerStatus.idle && worker1.status == WorkerStatus.idle)
}
