// T7: a run and its two workers, which talk by messages. A task that fails for the first time while the
// run is running is assigned once more.
module system

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status   : RunStatus  = RunStatus.idle
    task0    : TaskStatus = TaskStatus.idle
    task1    : TaskStatus = TaskStatus.idle
    retried0 : bool = false
    retried1 : bool = false
    processed : 0..4 = 0                         // the items of the completed reports recorded
    w0      : Ref<Worker> = none
    w1       : Ref<Worker> = none
  }
  terminal status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled }

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus, items: 0..2)
  action TaskTimeout(task: int check { 0, 1 } strict)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status == RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 == TaskStatus.assigned { send w0 <- Abort() }
    if task1 == TaskStatus.assigned { send w1 <- Abort() }
  }

  on Report(task, outcome, items) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "ended"
    require outcome in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled } else reject "bad-outcome"
    if task == 0 {
      require task0 == TaskStatus.assigned else reject "already-reported"
      if outcome == TaskStatus.failed && status == RunStatus.running && !retried0 {
        retried0' = true
        send w0 <- Assign()
      } else {
        task0' = outcome
        if outcome == TaskStatus.completed { processed' = processed + items }
        if task1 != TaskStatus.assigned {
          if outcome == TaskStatus.completed && task1 == TaskStatus.completed { status' = RunStatus.completed }
          else { if outcome == TaskStatus.failed || task1 == TaskStatus.failed { status' = RunStatus.failed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    } else {
      require task1 == TaskStatus.assigned else reject "already-reported"
      if outcome == TaskStatus.failed && status == RunStatus.running && !retried1 {
        retried1' = true
        send w1 <- Assign()
      } else {
        task1' = outcome
        if outcome == TaskStatus.completed { processed' = processed + items }
        if task0 != TaskStatus.assigned {
          if outcome == TaskStatus.completed && task0 == TaskStatus.completed { status' = RunStatus.completed }
          else { if outcome == TaskStatus.failed || task0 == TaskStatus.failed { status' = RunStatus.failed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    }
  }

  // A timeout fails the task for good, as a last failure would, and aborts its worker. A report that
  // arrives later for the task finds it no longer assigned, and is ignored.
  on TaskTimeout(task) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "ended"
    if task == 0 {
      require task0 == TaskStatus.assigned else reject "not-assigned"
      task0' = TaskStatus.failed
      if task1 != TaskStatus.assigned { status' = RunStatus.failed }
      send w0 <- Abort()
    } else {
      require task1 == TaskStatus.assigned else reject "not-assigned"
      task1' = TaskStatus.failed
      if task0 != TaskStatus.assigned { status' = RunStatus.failed }
      send w1 <- Abort()
    }
  }

  invariant completed-when-both: status == RunStatus.completed implies (task0 == TaskStatus.completed && task1 == TaskStatus.completed)
  invariant ended-when-both-reported:
    (status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled })
      implies (task0 in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled }
               && task1 in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled })
  step property retry-keeps-status:
    (action == Report && pre.task0 == TaskStatus.assigned && post.task0 == TaskStatus.assigned
       && pre.task1 == post.task1) implies pre.status == post.status
}

// A worker serves the run for as long as it lives, so it is a service and has no terminal state.
service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }

  action Assign()
  action Abort()
  action WorkDone(items: int check { 1, 2 } strict)
  action WorkFailed()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status == WorkerStatus.busy else reject "idle"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled, items: 0)
  }

  on WorkDone(items) {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed, items: items)
  }

  on WorkFailed {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed, items: 0)
  }
}

configuration system {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, run.TaskTimeout, worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 6 }
  invariant run-completed-only-when-both-done:
    run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
  // A timed-out task's worker may still be busy when the run ends, so only a run without a failed task
  // ends with both workers idle.
  invariant run-ends-only-when-workers-idle:
    (run.status in { RunStatus.completed, RunStatus.cancelled })
      implies (worker0.status == WorkerStatus.idle && worker1.status == WorkerStatus.idle)
  invariant processed-only-by-completed-tasks:
    (run.task0 != TaskStatus.completed && run.task1 != TaskStatus.completed) implies run.processed == 0
}
