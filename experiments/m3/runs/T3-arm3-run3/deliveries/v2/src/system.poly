// Card payments: one Payment instance per payment id, created by authorize.
// Status constructors share names with fields, so they are written qualified (Status.x).
module payments

type Status = fresh | authorizing | authorized | declined | failed | captured | voided | refunded | expired

machine Payment {
  state {
    status     : Status = Status.fresh
    authorized : 0..3   = 0
    captured   : 0..3   = 0
    refunded   : 0..3   = 0
    requests   : 0..3   = 0
  }
  terminal status in { Status.declined, Status.failed, Status.voided, Status.refunded, Status.expired }

  action Authorize(amount: int check { 1, 2 } strict)
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2, 3 } strict)
  action Void()
  action Increase()
  action Expire()
  action Refund(amount: int check { 1, 2 } strict)

  on Authorize(amount) {
    require status == Status.fresh else reject "exists"
    status' = Status.authorizing
    authorized' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == Status.authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(authorized)
    } else {
      status' = Status.failed
    }
  }
  // The first answer decides; a late answer finds the payment no longer authorizing.
  on Approved {
    require status == Status.authorizing else reject "not-authorizing"
    status' = Status.authorized
  }
  on Declined {
    require status == Status.authorizing else reject "not-authorizing"
    status' = Status.declined
  }
  on Capture(amount) {
    require status == Status.authorized else reject "not-authorized"
    require amount <= authorized else reject "exceeds-authorized"
    status' = Status.captured
    captured' = amount
  }
  on Increase {
    require status == Status.authorized else reject "not-authorized"
    require authorized < 3 else reject "at-most-three"
    authorized' = authorized + 1
  }
  // The hold lapsed: only an authorized payment that was not captured expires.
  on Expire {
    require status == Status.authorized else reject "not-authorized"
    status' = Status.expired
  }
  on Void {
    require status == Status.authorized else reject "not-authorized"
    status' = Status.voided
  }
  on Refund(amount) {
    require status == Status.captured else reject "not-captured"
    require refunded + amount <= captured else reject "exceeds-captured"
    refunded' = refunded + amount
    if refunded + amount == captured { status' = Status.refunded }
  }

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class compensable
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: captured <= authorized
  invariant refunded-within-captured: refunded <= captured
  invariant voided-captured-nothing: status == Status.voided implies captured == 0
  invariant expired-captured-nothing: status == Status.expired implies captured == 0
  invariant requests-bounded: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3
}
