{
  "module": "consensus",
  "instances": {
    "node": {
      "machine": "Node"
    }
  },
  "methods": {
    "electionTimeout": {
      "instance": "node",
      "action": "ElectionTimeout"
    },
    "electionWon": {
      "instance": "node",
      "action": "ElectionWon"
    },
    "electionLost": {
      "instance": "node",
      "action": "ElectionLost"
    },
    "pause": {
      "instance": "node",
      "action": "Pause"
    },
    "resume": {
      "instance": "node",
      "action": "Resume"
    },
    "newerTermSeen": {
      "instance": "node",
      "action": "NewerTermSeen",
      "params": {
        "term": "$arg:term"
      }
    },
    "quorumLost": {
      "instance": "node",
      "action": "QuorumLost"
    },
    "shutdown": {
      "instance": "node",
      "action": "Shutdown"
    },
    "voteRequested": {
      "instance": "node",
      "action": "VoteRequested",
      "params": {
        "from": "$arg:candidate",
        "term": "$arg:term"
      }
    }
  },
  "queries": {
    "node": {
      "instance": "node",
      "fields": {
        "role": "role",
        "term": "term",
        "votedFor": "votedFor",
        "paused": "paused"
      }
    }
  }
}
