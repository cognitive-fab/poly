{
  "module": "fencing",
  "instances": {
    "lease": { "machine": "Lease" },
    "c0": { "machine": "Client", "init": { "lease": "lease" } },
    "c1": { "machine": "Client", "init": { "lease": "lease" } }
  },
  "methods": {
    "acquire": { "instance": "$arg:client", "machine": "Client", "action": "RequestLease" },
    "release": { "instance": "$arg:client", "machine": "Client", "action": "ReleaseLease" },
    "cancelAcquire": { "instance": "$arg:client", "machine": "Client", "action": "CancelAcquire" },
    "write":{ "instance": "$arg:client", "machine": "Client", "action": "SendWrite" },
    "expire": { "instance": "lease", "action": "Expire" }
  },
  "queries": {
    "lease": { "instance": "lease", "fields": { "holder": "holder", "token": "lastToken", "writes": "writes" } },
    "client": { "instance": "$arg:client", "machine": "Client", "fields": { "status": "status", "token": "held", "writing": "writing" } }
  }
}
