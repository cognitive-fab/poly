// T8: a consensus node's role and term.
module consensus

type Role = follower | candidate | leader | shutdown

machine Node {
  state {
    role : Role = follower
    term : 0..3 = 0
  }
  terminal role is shutdown

  action ElectionTimeout()
  action ElectionWon()
  action NewerTermSeen(t: int check { 1, 2, 3 } strict)
  action QuorumLost()
  action Shutdown()

  on ElectionTimeout {
    require role is follower || role is candidate else reject "not-follower-or-candidate"
    require term < 3 else reject "last-term"
    role' = candidate
    term' = term + 1
  }
  on ElectionWon {
    require role is candidate else reject "not-candidate"
    role' = leader
  }
  on NewerTermSeen(t) {
    require t >= 1 && t <= 3 else reject "term-out-of-range"
    require t > term else reject "term-not-newer"
    role' = follower
    term' = t
  }
  on QuorumLost {
    require role is leader else reject "not-leader"
    role' = follower
  }
  on Shutdown {
    role' = shutdown
  }

  step property term-never-decreases: post.term >= pre.term
  step property term-changes-only-by-election-or-newer-term:
    post.term != pre.term implies (action == ElectionTimeout || action == NewerTermSeen)
  step property leader-was-candidate:
    (post.role == leader && pre.role != leader) implies (pre.role == candidate && pre.term == post.term)
  step property shutdown-is-final: pre.role == shutdown implies post.role == shutdown
}
