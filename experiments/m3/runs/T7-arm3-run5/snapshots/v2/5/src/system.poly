module system

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status : RunStatus = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
    retried0 : bool = false
    retried1 : bool = false
  }
  terminal status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled }

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus)
  action TaskTimeout(task: int check 0..1 strict)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = running
    task0' = assigned
    task1' = assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status == running else reject "not-running"
    status' = cancelling
    if task0 == assigned { send w0 <- Abort() }
    if task1 == assigned { send w1 <- Abort() }
  }

  // A timed-out task fails for the last time (no retry); a report that arrives for it later is rejected.
  on TaskTimeout(task) {
    require status in { running, cancelling } else reject "not-active"
    if task == 0 {
      require task0 == assigned else reject "not-assigned"
      task0' = TaskStatus.failed
      if task1 != assigned { status' = RunStatus.failed }
      send w0 <- Abort()
    } else {
      require task1 == assigned else reject "not-assigned"
      task1' = TaskStatus.failed
      if task0 != assigned { status' = RunStatus.failed }
      send w1 <- Abort()
    }
  }

  on Report(task, outcome) {
    require status in { running, cancelling } else reject "not-active"
    require outcome in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled } else reject "bad-outcome"
    if task == 0 {
      require task0 == assigned else reject "already-reported"
      if status == running && outcome == TaskStatus.failed && !retried0 {
        retried0' = true
        send w0 <- Assign()
      } else {
        task0' = outcome
        if task1 != assigned {
          if outcome == TaskStatus.completed && task1 == TaskStatus.completed { status' = RunStatus.completed }
          else { if outcome == TaskStatus.failed || task1 == TaskStatus.failed { status' = RunStatus.failed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    } else {
      require task1 == assigned else reject "already-reported"
      if status == running && outcome == TaskStatus.failed && !retried1 {
        retried1' = true
        send w1 <- Assign()
      } else {
        task1' = outcome
        if task0 != assigned {
          if outcome == TaskStatus.completed && task0 == TaskStatus.completed { status' = RunStatus.completed }
          else { if outcome == TaskStatus.failed || task0 == TaskStatus.failed { status' = RunStatus.failed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    }
  }
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }

  action Assign()
  action Abort()
  action WorkDone()
  action WorkFailed()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = busy
  }

  on Abort {
    require status == busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled)
  }

  on WorkDone {
    require status == busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed)
  }

  on WorkFailed {
    require status == busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed)
  }
}

configuration system {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, run.TaskTimeout, worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 8 }

  invariant completed-only-when-both: run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
  invariant ends-only-when-both-reported: run.status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled } implies (run.task0 != TaskStatus.assigned && run.task1 != TaskStatus.assigned)
  invariant failed-only-on-failure: run.status == RunStatus.failed implies (run.task0 == TaskStatus.failed || run.task1 == TaskStatus.failed)
}
