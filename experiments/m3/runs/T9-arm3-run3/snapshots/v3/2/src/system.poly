// Electing and announcing a leader among three nodes: one election round, term 1.
module election

type Role = follower | candidate | leader | down

// A node runs for as long as the cluster does, so a settled election is not a stuck one.
service machine Node {
  state {
    role        : Role      = follower
    term        : 0..1      = 0
    votedFor    : Ref<Node> = none
    votes       : 0..3      = 0         // votes counted as a candidate; not written down, so lost in a crash
    me          : Ref<Node> = none
    p1          : Ref<Node> = none
    p2          : Ref<Node> = none
    knownLeader : Ref<Node> = none      // the leader this node knows in its term
  }
  action Timeout()
  action GiveUp()
  action RequestVote(from: Ref<Node>, term: 1..1)
  action VoteReply(term: 1..1, granted: bool)
  action Leader(from: Ref<Node>, term: 1..1)

  // A follower in term 0 starts the one election it may start.
  on Timeout {
    require role is follower && pre.term == 0 else reject "not-a-follower-in-term-0"
    require me != none else reject "no-identity"          // a node always knows its own id
    role' = candidate
    term' = 1
    votedFor' = me
    votes' = 1
    send p1 <- RequestVote(from: self, term: 1)
    send p2 <- RequestVote(from: self, term: 1)
  }

  on RequestVote(from, term) {
    if pre.term == 0 {
      term' = 1
      votedFor' = from
      send from <- VoteReply(term: 1, granted: true)
    } else {
      if (role is follower && votedFor == none) || votedFor == from {
        votedFor' = from
        send from <- VoteReply(term: 1, granted: true)
      } else {
        send from <- VoteReply(term: 1, granted: false)
      }
    }
  }

  // Only a candidate counts a granted vote for its term; any other reply is ignored.
  // With 2 votes it leads, and announces itself to the other two.
  on VoteReply(term, granted) {
    require role is candidate && pre.term == term && granted else reject "ignored"
    votes' = votes + 1
    if votes + 1 >= 2 {
      role' = leader
      knownLeader' = me
      send p1 <- Leader(from: self, term: 1)
      send p2 <- Leader(from: self, term: 1)
    }
  }

  // A candidate gives up: a follower in the same term that keeps its vote for itself, so it grants no other
  // vote, and as a follower it ignores any later VoteReply.
  on GiveUp {
    require role is candidate else reject "not-a-candidate"
    role' = follower
  }

  // The announced leader is recorded; a node in term 0 joins term 1 without voting, a candidate steps down
  // and keeps its vote for itself.
  on Leader(from, term) {
    require !(role is leader) else reject "already-leader"
    knownLeader' = from
    if pre.term == 0 { term' = 1 }
    if role is candidate { role' = follower }
  }

  invariant leader-has-majority: role is leader implies votes >= 2
  invariant votes-only-as-candidate: votes > 0 implies votedFor == me
  invariant leader-knows-itself: role is leader implies knownLeader == me
}

configuration three-nodes {
  n0 : Node { me: n0, p1: n1, p2: n2 }
  n1 : Node { me: n1, p1: n0, p2: n2 }
  n2 : Node { me: n2, p1: n0, p2: n1 }
  inputs { n0.Timeout, n1.Timeout, n2.Timeout, n0.GiveUp, n1.GiveUp, n2.GiveUp }
  bounds { transit 8 }
  invariant one-leader: !(n0.role is leader && n1.role is leader) && !(n0.role is leader && n2.role is leader)
                        && !(n1.role is leader && n2.role is leader)
  invariant leader-holds-majority:
    (n0.role is leader implies (n1.votedFor == n0.me || n2.votedFor == n0.me))
    && (n1.role is leader implies (n0.votedFor == n1.me || n2.votedFor == n1.me))
    && (n2.role is leader implies (n0.votedFor == n2.me || n1.votedFor == n2.me))
  invariant one-known-leader:
    (n0.knownLeader == none || n1.knownLeader == none || n0.knownLeader == n1.knownLeader)
    && (n0.knownLeader == none || n2.knownLeader == none || n0.knownLeader == n2.knownLeader)
    && (n1.knownLeader == none || n2.knownLeader == none || n1.knownLeader == n2.knownLeader)
}
