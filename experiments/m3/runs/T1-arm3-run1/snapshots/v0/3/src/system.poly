// T1, order lifecycle: one Order machine per order id. The status members are spelled as the host
// interface reports them; `fresh` is the instance before `create` takes effect, never visible.
module shop

enum Status { fresh, draft, placed, paid, shipped, cancelled, failed }

machine Order {
  state {
    status  : Status = fresh
    items   : 0..3   = 0
    charges : 0..1   = 0
    refunds : 0..1   = 0
  }
  terminal status in { shipped, cancelled, failed }

  action Create()
  action AddItem()
  action RemoveItem()
  action Place()
  action Ship()
  action Cancel()
  action PaymentOk()
  action PaymentFailed()

  on Create {
    require status == fresh else reject "exists"
    status' = draft
  }
  on AddItem {
    require status == draft else reject "not-draft"
    require items < 3 else reject "order-full"
    items' = items + 1
  }
  on RemoveItem {
    require status == draft else reject "not-draft"
    require items > 0 else reject "order-empty"
    items' = items - 1
  }
  on Place {
    require status == draft else reject "not-draft"
    require items > 0 else reject "order-empty"
    require charges == 0 else reject "already-charged"
    status' = placed
    charges' = charges + 1
    emit charge(items)
  }
  on PaymentOk {
    require status == placed else reject "not-placed"
    status' = paid
  }
  on PaymentFailed {
    require status == placed else reject "not-placed"
    status' = failed
  }
  on Ship {
    require status == paid else reject "not-paid"
    status' = shipped
  }
  on Cancel {
    require status in { draft, paid } else reject "not-cancellable"
    require refunds == 0 else reject "already-refunded"
    if status == paid {
      refunds' = refunds + 1
      emit refund(items)
    }
    status' = cancelled
  }

  invariant paid-was-charged: status in { paid, shipped } implies charges == 1
  invariant refund-after-charge: refunds <= charges
  invariant draft-not-charged: status in { fresh, draft } implies charges == 0
  path property charge-at-most-once: count("payment.charge") <= 1
  path property refund-at-most-once: count("payment.refund") <= 1
  path property refund-after-charge-path: before("payment.charge", "payment.refund")

  effect charge(amount: int) {
    kind "payment.charge"
    labels { egress:external }
    class irreversible
    ok -> PaymentOk()
    failed -> PaymentFailed()
  }
  effect refund(amount: int) {
    kind "payment.refund"
    labels { egress:external }
    class irreversible
  }
}
