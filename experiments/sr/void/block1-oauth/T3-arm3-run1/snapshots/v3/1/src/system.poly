// Card payments: authorise, capture (in parts), void, raise, expire and refund, with the card provider's
// answers arriving as completions of the card.authorize effect.
module payments

enum Status { fresh, authorizing, authorized, declined, failed, captured, voided, refunded, expired }

machine Payment {
  state {
    status     : Status = fresh
    authorized : 0..3   = 0
    captured   : 0..3   = 0
    refunded   : 0..3   = 0
    requests   : 0..3   = 0
  }
  terminal status in { declined, failed, voided, refunded, expired }

  action Authorize(amount: 1..2)
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: 1..3)
  action Void()
  action Increase()
  action Expire()
  action Refund(amount: 1..2)

  on Authorize(amount) {
    require status == fresh else reject "exists"
    status' = authorizing
    authorized' = amount
    requests' = 1
    emit authorize(amount: amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(amount: authorized)
    } else {
      status' = failed
    }
  }
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized || (status == captured && refunded == 0) else reject "not-capturable"
    require captured + amount <= authorized else reject "over-authorized"
    status' = captured
    captured' = captured + amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Increase {
    require status == authorized else reject "not-authorized"
    require authorized < 3 else reject "at-limit"
    authorized' = authorized + 1
  }
  on Expire {
    require status == authorized else reject "not-authorized"
    status' = expired
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require refunded + amount <= captured else reject "over-captured"
    refunded' = refunded + amount
    if refunded + amount == captured { status' = refunded }
  }

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class reversible
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: captured <= authorized
  invariant refunded-within-captured: refunded <= captured
  invariant voided-captured-nothing: status == voided implies captured == 0
  invariant requests-at-most-three: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3
}
