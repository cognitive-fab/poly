// Card payments: authorise, capture (in parts), void, raise, expire and refund, with the card provider's
// answers arriving as completions of the card.authorize effect.
module payments

enum Status { fresh, authorizing, authorized, declined, failed, captured, voided, refunded, expired }

machine Payment {
  state {
    status   : Status = fresh
    held     : 0..3   = 0     // the amount authorised so far
    taken    : 0..3   = 0     // the amount captured so far
    returned : 0..3   = 0     // the amount refunded so far
    requests : 0..3   = 0     // authorisation requests sent to the provider
  }
  terminal status in { declined, failed, voided, refunded, expired }

  action Authorize(amount: 1..2)
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: 1..3)
  action Void()
  action Increase()
  action Expire()
  action Refund(amount: 1..2)

  on Authorize(amount) {
    require status == fresh else reject "exists"
    status' = authorizing
    held' = amount
    requests' = 1
    emit authorize(amount: amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(amount: held)
    } else {
      status' = failed
    }
  }
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized || (status == captured && returned == 0) else reject "not-capturable"
    require taken + amount <= held else reject "over-authorized"
    status' = captured
    taken' = taken + amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Increase {
    require status == authorized else reject "not-authorized"
    require held < 3 else reject "at-limit"
    held' = held + 1
  }
  on Expire {
    require status == authorized else reject "not-authorized"
    status' = expired
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require returned + amount <= taken else reject "over-captured"
    returned' = returned + amount
    if returned + amount == taken { status' = refunded }
  }

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class reversible
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: taken <= held
  invariant refunded-within-captured: returned <= taken
  invariant voided-captured-nothing: status == voided implies taken == 0
  path property at-most-three-requests: count("card.authorize") <= 3
}
