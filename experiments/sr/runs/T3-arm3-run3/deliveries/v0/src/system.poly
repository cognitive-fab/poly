// T3, card payments: one Payment instance per payment id, created by authorize.
// Status members are lowercase because the host shows them verbatim; the amount fields are
// named apart from the statuses (asked, taken, returned) and renamed by host.map.json.
module payments

enum Status { fresh, authorizing, authorized, declined, failed, captured, voided, refunded }

machine Payment {
  state {
    status   : Status = fresh
    asked    : 0..2   = 0    // the amount authorised, from the start
    taken    : 0..2   = 0    // the amount captured
    returned : 0..2   = 0    // the amount refunded so far
    requests : 0..3   = 0    // authorisation requests sent to the provider
  }
  terminal status in { declined, failed, voided, refunded }

  action Authorize(amount: 1..2)
  action TimedOut()
  action ProviderApproved()
  action ProviderDeclined()
  action Capture(amount: 1..2)
  action Void()
  action Refund(amount: 1..2)

  on Authorize(amount) {
    require status == fresh else reject "exists"
    status' = authorizing
    asked' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(asked)
    } else {
      status' = failed
    }
  }
  on ProviderApproved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on ProviderDeclined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized else reject "not-authorized"
    require amount <= asked else reject "exceeds-authorized"
    status' = captured
    taken' = amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require returned + amount <= taken else reject "exceeds-captured"
    returned' = returned + amount
    if returned + amount == taken { status' = refunded }
  }

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class reversible
    ok -> ProviderApproved()
    failed -> ProviderDeclined()
  }

  invariant captured-within-authorized: taken <= asked
  invariant refunded-within-captured: returned <= taken
  invariant voided-captured-nothing: status == voided implies taken == 0
  invariant requests-bounded: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3
}
