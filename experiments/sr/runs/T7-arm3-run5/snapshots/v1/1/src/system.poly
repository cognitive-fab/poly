module workflow

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status : RunStatus = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
  }
  terminal status == RunStatus.completed || status == RunStatus.failed || status == RunStatus.cancelled

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status == RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 == TaskStatus.assigned { send w0 <- Abort() }
    if task1 == TaskStatus.assigned { send w1 <- Abort() }
  }

  on Report(task, outcome) {
    require status == RunStatus.running || status == RunStatus.cancelling else reject "not-active"
    require outcome == TaskStatus.completed || outcome == TaskStatus.failed || outcome == TaskStatus.cancelled else reject "not-an-outcome"
    if task == 0 {
      require task0 == TaskStatus.assigned else reject "already-reported"
      if outcome == TaskStatus.failed && status == RunStatus.running && !retried0 {
        // the first failure of a running task: assign it again, once
        retried0' = true
        send w0 <- Assign()
      } else {
        task0' = outcome
        if task1 != TaskStatus.assigned {
          if outcome == TaskStatus.failed || task1 == TaskStatus.failed { status' = RunStatus.failed }
          else { if outcome == TaskStatus.completed && task1 == TaskStatus.completed { status' = RunStatus.completed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    } else {
      require task1 == TaskStatus.assigned else reject "already-reported"
      if outcome == TaskStatus.failed && status == RunStatus.running && !retried1 {
        retried1' = true
        send w1 <- Assign()
      } else {
        task1' = outcome
        if task0 != TaskStatus.assigned {
          if outcome == TaskStatus.failed || task0 == TaskStatus.failed { status' = RunStatus.failed }
          else { if outcome == TaskStatus.completed && task0 == TaskStatus.completed { status' = RunStatus.completed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    }
  }

  invariant completed-when-both-completed:
    status == RunStatus.completed implies (task0 == TaskStatus.completed && task1 == TaskStatus.completed)
  invariant ended-when-both-reported:
    (status == RunStatus.completed || status == RunStatus.failed || status == RunStatus.cancelled)
      implies (task0 != TaskStatus.assigned && task1 != TaskStatus.assigned)
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    run    : Ref<Run> = none
    task   : 0..1 = 0
  }

  action Assign()
  action Abort()
  action Done()
  action Fail()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled)
  }

  on Done {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed)
  }

  on Fail {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed)
  }
}

configuration system {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { run: run, task: 0 }
  worker1 : Worker { run: run, task: 1 }
  inputs  { run.Start, run.Cancel, worker0.Done, worker0.Fail, worker1.Done, worker1.Fail }
  bounds  { transit 4 }
  invariant completed-only-when-workers-completed:
    run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
}
