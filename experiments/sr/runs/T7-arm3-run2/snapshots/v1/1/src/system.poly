// T7: a run and its two workers, talking by messages.
module workflow

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type Outcome = completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status : RunStatus = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
  }
  terminal status is completed | failed | cancelled
  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: Outcome)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status == RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 == TaskStatus.assigned { send w0 <- Abort() }
    if task1 == TaskStatus.assigned { send w1 <- Abort() }
  }

  on Report(task, outcome) {
    require status == RunStatus.running || status == RunStatus.cancelling else reject "run-ended"
    require (task == 0 && task0 == TaskStatus.assigned) || (task == 1 && task1 == TaskStatus.assigned) else reject "already-reported"
    if task == 0 {
      if outcome == Outcome.failed && status == RunStatus.running && !retried0 {
        // the first failure of a running task: assign it once more
        retried0' = true
        send w0 <- Assign()
      } else {
        match outcome {
          Outcome.completed => task0' = TaskStatus.completed
          Outcome.failed => task0' = TaskStatus.failed
          Outcome.cancelled => task0' = TaskStatus.cancelled
        }
        if task1 != TaskStatus.assigned {
          if outcome == Outcome.completed && task1 == TaskStatus.completed { status' = RunStatus.completed }
          else { if outcome == Outcome.failed || task1 == TaskStatus.failed { status' = RunStatus.failed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    } else {
      if outcome == Outcome.failed && status == RunStatus.running && !retried1 {
        retried1' = true
        send w1 <- Assign()
      } else {
        match outcome {
          Outcome.completed => task1' = TaskStatus.completed
          Outcome.failed => task1' = TaskStatus.failed
          Outcome.cancelled => task1' = TaskStatus.cancelled
        }
        if task0 != TaskStatus.assigned {
          if outcome == Outcome.completed && task0 == TaskStatus.completed { status' = RunStatus.completed }
          else { if outcome == Outcome.failed || task0 == TaskStatus.failed { status' = RunStatus.failed }
                 else { status' = RunStatus.cancelled } }
        }
      }
    }
  }

  invariant completed-means-both: status == RunStatus.completed implies (task0 == TaskStatus.completed && task1 == TaskStatus.completed)
  invariant ended-means-reported: (status == RunStatus.completed || status == RunStatus.failed || status == RunStatus.cancelled) implies (task0 != TaskStatus.assigned && task1 != TaskStatus.assigned)
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    run    : Ref<Run> = none
    task   : 0..1 = 0
  }
  action Assign()
  action Abort()
  action WorkDone()
  action WorkFailed()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status == WorkerStatus.busy else reject "idle"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: Outcome.cancelled)
  }

  on WorkDone {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: Outcome.completed)
  }

  on WorkFailed {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: Outcome.failed)
  }
}

configuration system {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { run: run, task: 0 }
  worker1 : Worker { run: run, task: 1 }
  inputs  { run.Start, run.Cancel, worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 4 }
  invariant completed-only-when-both: run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
}
