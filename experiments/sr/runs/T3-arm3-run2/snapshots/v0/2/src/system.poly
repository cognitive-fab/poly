module payments

// Status names are the strings the host's query returns.
enum Status { idle, authorizing, authorized, declined, failed, captured, voided, refunded }

machine Payment {
  state {
    status   : Status = idle
    held     : 0..2   = 0   // the amount asked for at authorisation
    taken    : 0..2   = 0   // the amount captured
    returned : 0..2   = 0   // the amount refunded so far
    requests : 0..3   = 0   // authorisation requests sent to the provider
  }
  terminal status in { declined, failed, voided, refunded }

  action Authorize(amount: int check { 1, 2 })
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2 })
  action Void()
  action Refund(amount: int check { 1, 2 })

  on Authorize(amount) {
    require status == idle else reject "exists"
    status' = authorizing
    held' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(held)
    } else {
      status' = failed
    }
  }
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized else reject "not-authorized"
    require amount <= held else reject "exceeds-authorized"
    status' = captured
    taken' = amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require returned + amount <= taken else reject "exceeds-captured"
    returned' = returned + amount
    if returned + amount == taken {
      status' = refunded
    }
  }

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class reversible
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: taken <= held
  invariant refunded-within-captured: returned <= taken
  invariant voided-captured-nothing: status == voided implies taken == 0
  invariant requests-bounded: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3
}
