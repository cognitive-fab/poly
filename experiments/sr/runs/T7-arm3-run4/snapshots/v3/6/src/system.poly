// A run and its two workers, talking by messages.
module system

type RunStatus = idle | running | cancelling | completed | failed | cancelled
type TaskStatus = idle | assigned | completed | failed | cancelled
type WorkerStatus = idle | busy

machine Run {
  state {
    status : RunStatus  = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
    retried0 : bool = false
    retried1 : bool = false
    processed : 0..4 = 0
  }
  terminal status is completed | failed | cancelled

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus, items: 0..2)
  action TaskTimeout(task: 0..1)

  on Start {
    require status is idle else reject "already-started"
    status' = running
    task0' = assigned
    task1' = assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status is running else reject "not-running"
    status' = cancelling
    if task0 is assigned { send w0 <- Abort() }
    if task1 is assigned { send w1 <- Abort() }
  }

  // The other task's status decides the run's: completed when both completed, ended when both reported.
  on Report(task, outcome, items) {
    require status is running | cancelling else reject "not-active"
    require outcome is completed | failed | cancelled else reject "not-an-outcome"
    // A first failure while running is retried once: the task stays assigned and its worker is assigned again.
    if task == 0 {
      require task0 is assigned else reject "already-reported"
      if outcome is failed && status is running && !retried0 {
        retried0' = true
        send w0 <- Assign()
      } else {
        task0' = outcome
        if outcome is completed { processed' = processed + items }
        if outcome is completed && task1 is completed { status' = completed }
        else { if !(task1 is assigned) {
          if outcome is failed || task1 is failed { status' = failed } else { status' = cancelled }
        } }
      }
    } else {
      require task1 is assigned else reject "already-reported"
      if outcome is failed && status is running && !retried1 {
        retried1' = true
        send w1 <- Assign()
      } else {
        task1' = outcome
        if outcome is completed { processed' = processed + items }
        if outcome is completed && task0 is completed { status' = completed }
        else { if !(task0 is assigned) {
          if outcome is failed || task0 is failed { status' = failed } else { status' = cancelled }
        } }
      }
    }
  }

  // A timed-out task fails for good, as a last failure would, and its worker is told to stop.
  on TaskTimeout(task) {
    require status is running | cancelling else reject "not-active"
    if task == 0 {
      require task0 is assigned else reject "not-assigned"
      task0' = failed
      if !(task1 is assigned) { status' = failed }
      send w0 <- Abort()
    } else {
      require task1 is assigned else reject "not-assigned"
      task1' = failed
      if !(task0 is assigned) { status' = failed }
      send w1 <- Abort()
    }
  }

  invariant completed-only-when-both: status is completed implies (task0 is completed && task1 is completed)
  invariant ended-only-when-reported: (status is completed | failed | cancelled) implies (!(task0 is assigned) && !(task1 is assigned))
}

service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    run    : Ref<Run> = none
    task   : 0..1 = 0
  }

  action Assign()
  action Abort()
  action WorkDone(items: 1..2)
  action WorkFailed()

  on Assign {
    require status is idle else reject "not-idle"
    status' = busy
  }
  on Abort {
    require status is busy else reject "not-busy"
    status' = idle
    send run <- Report(task: task, outcome: cancelled, items: 0)
  }
  on WorkDone(items) {
    require status is busy else reject "not-busy"
    status' = idle
    send run <- Report(task: task, outcome: completed, items: items)
  }
  on WorkFailed {
    require status is busy else reject "not-busy"
    status' = idle
    send run <- Report(task: task, outcome: failed, items: 0)
  }
}

configuration one-run {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { run: run, task: 0 }
  worker1 : Worker { run: run, task: 1 }
  inputs  { run.Start, run.Cancel, run.TaskTimeout,worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 8 }
  invariant run-completed-only-when-both: run.status is completed implies (run.task0 is completed && run.task1 is completed)
}
