// A run and its workers: the run assigns one task to each worker, and records each worker's report.
module system

enum RunStatus { idle, running, cancelling, completed, failed, cancelled }
enum TaskStatus { idle, assigned, completed, failed, cancelled }
enum WorkerStatus { idle, busy }

machine Run {
  state {
    status : RunStatus  = RunStatus.idle
    task0  : TaskStatus = TaskStatus.idle
    task1  : TaskStatus = TaskStatus.idle
    w0     : Ref<Worker> = none
    w1     : Ref<Worker> = none
    retried0 : bool = false
    retried1 : bool = false
    processed : 0..4 = 0
  }
  terminal status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled }

  action Start()
  action Cancel()
  action Report(task: 0..1, outcome: TaskStatus, items: 0..2)
  action TaskTimeout(task: 0..1)

  on Start {
    require status == RunStatus.idle else reject "already-started"
    status' = RunStatus.running
    task0' = TaskStatus.assigned
    task1' = TaskStatus.assigned
    send w0 <- Assign()
    send w1 <- Assign()
  }

  on Cancel {
    require status == RunStatus.running else reject "not-running"
    status' = RunStatus.cancelling
    if task0 == TaskStatus.assigned { send w0 <- Abort() }
    if task1 == TaskStatus.assigned { send w1 <- Abort() }
  }

  // A timed-out task is failed for good (not retried), and its worker is told to stop. Its worker's
  // later report finds the task no longer assigned, and is ignored.
  on TaskTimeout(task) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "run-not-active"
    require (task == 0 && task0 == TaskStatus.assigned) || (task == 1 && task1 == TaskStatus.assigned) else reject "task-not-assigned"
    if task == 0 {
      task0' = TaskStatus.failed
      if task1 != TaskStatus.assigned { status' = RunStatus.failed }
      send w0 <- Abort()
    } else {
      task1' = TaskStatus.failed
      if task0 != TaskStatus.assigned { status' = RunStatus.failed }
      send w1 <- Abort()
    }
  }

  on Report(task, outcome, items) {
    require status in { RunStatus.running, RunStatus.cancelling } else reject "run-ended"
    require outcome in { TaskStatus.completed, TaskStatus.failed, TaskStatus.cancelled } else reject "bad-outcome"
    require (task == 0 && task0 == TaskStatus.assigned) || (task == 1 && task1 == TaskStatus.assigned) else reject "already-reported"
    // A first failure while running is retried once: the task stays assigned and its worker is assigned again.
    if outcome == TaskStatus.failed && status == RunStatus.running && task == 0 && !retried0 {
      retried0' = true
      send w0 <- Assign()
    } else { if outcome == TaskStatus.failed && status == RunStatus.running && task == 1 && !retried1 {
      retried1' = true
      send w1 <- Assign()
    } else {
    if outcome == TaskStatus.completed { processed' = processed + items }
    if task == 0 {
      task0' = outcome
      if outcome == TaskStatus.completed && task1 == TaskStatus.completed {
        status' = RunStatus.completed
      } else {
        if task1 != TaskStatus.assigned {
          if outcome == TaskStatus.failed || task1 == TaskStatus.failed { status' = RunStatus.failed }
          else { status' = RunStatus.cancelled }
        }
      }
    } else {
      task1' = outcome
      if outcome == TaskStatus.completed && task0 == TaskStatus.completed {
        status' = RunStatus.completed
      } else {
        if task0 != TaskStatus.assigned {
          if outcome == TaskStatus.failed || task0 == TaskStatus.failed { status' = RunStatus.failed }
          else { status' = RunStatus.cancelled }
        }
      }
    } } }
  }

  invariant completed-means-both: status == RunStatus.completed implies (task0 == TaskStatus.completed && task1 == TaskStatus.completed)
  invariant ended-means-reported: status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled } implies (task0 != TaskStatus.assigned && task1 != TaskStatus.assigned)
}

// A worker is never terminal: it waits for its next Assign.
service machine Worker {
  state {
    status : WorkerStatus = WorkerStatus.idle
    task   : 0..1 = 0
    run    : Ref<Run> = none
  }

  action Assign()
  action Abort()
  action WorkDone(items: 1..2)
  action WorkFailed()

  on Assign {
    require status == WorkerStatus.idle else reject "busy"
    status' = WorkerStatus.busy
  }

  on Abort {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.cancelled, items: 0)
  }

  on WorkDone(items) {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.completed, items: items)
  }

  on WorkFailed {
    require status == WorkerStatus.busy else reject "not-busy"
    status' = WorkerStatus.idle
    send run <- Report(task: task, outcome: TaskStatus.failed, items: 0)
  }
}

configuration system {
  run     : Run { w0: worker0, w1: worker1 }
  worker0 : Worker { task: 0, run: run }
  worker1 : Worker { task: 1, run: run }
  inputs  { run.Start, run.Cancel, run.TaskTimeout, worker0.WorkDone, worker0.WorkFailed, worker1.WorkDone, worker1.WorkFailed }
  bounds  { transit 8 }
  invariant completed-only-when-both-done: run.status == RunStatus.completed implies (run.task0 == TaskStatus.completed && run.task1 == TaskStatus.completed)
  invariant processed-only-completed: (run.task0 != TaskStatus.completed && run.task1 != TaskStatus.completed) implies run.processed == 0
  invariant ended-only-when-both-reported: run.status in { RunStatus.completed, RunStatus.failed, RunStatus.cancelled } implies (run.task0 != TaskStatus.assigned && run.task1 != TaskStatus.assigned)
}
