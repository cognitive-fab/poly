// T3, card payments: one Payment instance per payment id, created by authorize.
// Status members are lowercase, as the host interface shows them; they are always written qualified,
// since authorized, captured and refunded are also field names.
module payments

enum Status { fresh, authorizing, authorized, declined, failed, captured, voided, refunded }

machine Payment {
  state {
    status     : Status = Status.fresh
    authorized : 0..2   = 0
    captured   : 0..2   = 0
    refunded   : 0..2   = 0
    requests   : 0..3   = 0
  }
  terminal status in { Status.declined, Status.failed, Status.voided, Status.refunded }

  action Authorize(amount: int check { 1, 2 })
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2 })
  action Void()
  action Refund(amount: int check { 1, 2 })

  on Authorize(amount) {
    require status == Status.fresh else reject "exists"
    status' = Status.authorizing
    authorized' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == Status.authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(authorized)
    } else {
      status' = Status.failed
    }
  }
  // The provider's answers: the first decides, a later one finds the payment no longer authorizing.
  on Approved {
    require status == Status.authorizing else reject "not-authorizing"
    status' = Status.authorized
  }
  on Declined {
    require status == Status.authorizing else reject "not-authorizing"
    status' = Status.declined
  }
  on Capture(amount) {
    require status == Status.authorized else reject "not-authorized"
    require amount <= authorized else reject "exceeds-authorized"
    status' = Status.captured
    captured' = amount
  }
  on Void {
    require status == Status.authorized else reject "not-authorized"
    require captured == 0 else reject "captured"
    status' = Status.voided
  }
  on Refund(amount) {
    require status == Status.captured else reject "not-captured"
    require refunded + amount <= captured else reject "exceeds-captured"
    refunded' = refunded + amount
    if refunded + amount == captured { status' = Status.refunded }
  }

  invariant captured-within-authorized: captured <= authorized
  invariant refunded-within-captured: refunded <= captured
  invariant voided-captured-nothing: status == Status.voided implies captured == 0
  invariant at-most-three-requests: requests <= 3
  path property at-most-three-sends: count("card.authorize") <= 3

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class irreversible
    ok -> Approved()
    failed -> Declined()
  }
}
