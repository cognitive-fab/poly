module payments

enum Status { fresh, authorizing, authorized, declined, failed, captured, voided, refunded, expired }

machine Payment {
  state {
    status     : Status = fresh
    authorizedAmount : 0..3   = 0
    capturedAmount   : 0..3   = 0
    refundedAmount   : 0..3   = 0
    requests   : 0..3   = 0
  }
  terminal status in { declined, failed, voided, refunded, expired }

  action Authorize(amount: int check { 1, 2 })
  action TimedOut()
  action Approved()
  action Declined()
  action Capture(amount: int check { 1, 2, 3 })
  action Void()
  action Increase()
  action Expire()
  action Refund(amount: int check { 1, 2 })

  on Authorize(amount) {
    require status == fresh else reject "payment-exists"
    status' = authorizing
    authorizedAmount' = amount
    requests' = 1
    emit authorizeCard(amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorizeCard(authorizedAmount)
    } else {
      status' = failed
    }
  }
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized else reject "not-authorized"
    require amount <= authorizedAmount else reject "exceeds-authorized"
    status' = captured
    capturedAmount' = amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Increase {
    require status == authorized else reject "not-authorized"
    require authorizedAmount < 3 else reject "at-most-three"
    authorizedAmount' = authorizedAmount + 1
  }
  on Expire {
    require status == authorized else reject "not-authorized"
    status' = expired
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require refundedAmount + amount <= capturedAmount else reject "exceeds-captured"
    refundedAmount' = refundedAmount + amount
    if refundedAmount + amount == capturedAmount { status' = refunded }
  }

  effect authorizeCard(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class reversible
    ok -> Approved()
    failed -> Declined()
  }

  invariant captured-within-authorized: capturedAmount <= authorizedAmount
  invariant refunded-within-captured: refundedAmount <= capturedAmount
  invariant voided-captured-nothing: status == voided implies capturedAmount == 0
  invariant expired-captured-nothing: status == expired implies capturedAmount == 0
  invariant requests-bounded: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3
}
