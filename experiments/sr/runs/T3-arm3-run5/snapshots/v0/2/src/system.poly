// Card payments: one Payment instance per payment id, created by authorize.
module payments

enum Status { fresh, authorizing, authorized, declined, failed, captured, voided, refunded }

machine Payment {
  state {
    status     : Status = fresh
    authorized : 0..2   = 0     // the amount asked for
    captured   : 0..2   = 0
    refunded   : 0..2   = 0
    requests   : 0..3   = 0     // authorisation requests sent to the provider
  }
  terminal status in { declined, failed, voided, refunded }

  action Authorize(amount: 1..2)
  action TimedOut()
  action Capture(amount: 1..2)
  action Void()
  action Refund(amount: 1..2)
  action Approved()
  action Declined()

  on Authorize(amount) {
    require status == fresh else reject "exists"
    status' = authorizing
    authorized' = amount
    requests' = 1
    emit authorize(amount)
  }
  on TimedOut {
    require status == authorizing else reject "not-authorizing"
    if requests < 3 {
      requests' = requests + 1
      emit authorize(authorized)
    } else {
      status' = failed
    }
  }
  on Approved {
    require status == authorizing else reject "not-authorizing"
    status' = authorized
  }
  on Declined {
    require status == authorizing else reject "not-authorizing"
    status' = declined
  }
  on Capture(amount) {
    require status == authorized else reject "not-authorized"
    require amount <= authorized else reject "exceeds-authorized"
    status' = captured
    captured' = amount
  }
  on Void {
    require status == authorized else reject "not-authorized"
    status' = voided
  }
  on Refund(amount) {
    require status == captured else reject "not-captured"
    require refunded + amount <= captured else reject "exceeds-captured"
    refunded' = refunded + amount
    if refunded + amount == captured { status' = refunded }
  }

  invariant captured-within-authorized: captured <= authorized
  invariant refunded-within-captured: refunded <= captured
  invariant voided-captured-nothing: status == voided implies captured == 0
  invariant requests-bounded: requests <= 3
  path property at-most-three-requests: count("card.authorize") <= 3

  effect authorize(amount: int) {
    kind "card.authorize"
    labels { egress:external }
    class compensable
    ok -> Approved()
    failed -> Declined()
  }
}
