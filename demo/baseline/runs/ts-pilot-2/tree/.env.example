# Copy to .env and fill in.
PORT=3000

# Stripe secret key (use a restricted key with only "Refunds: write" if possible)
STRIPE_SECRET_KEY=sk_test_...

# WhatsApp Cloud API (Meta developer dashboard → your app → WhatsApp → API setup)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# App dashboard → Settings → Basic → App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=...
# Any string you choose; enter the same value when configuring the webhook in Meta
WHATSAPP_VERIFY_TOKEN=choose-a-random-string

# Optional
# GRAPH_API_VERSION=v21.0
# ORDERS_FILE=orders.json
# STATE_FILE=data/state.json
# REFUND_WINDOW_DAYS=30
