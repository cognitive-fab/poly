// expected: FINDING PL3002
// Flash controller, the seeded defect (docs/examples/flash-controller.md): Program no longer requires an erased block, so a
// block can be programmed whatever its state. The step property erased-before-program is violated in two steps.
module flash

enum State { Erased, Programming, Programmed, Verifying, Verified, Erasing, Bad }

machine Block {
  state {
    state   : State = Erased
    data    : 0..3 = 0
    retries : 0..2 = 0
  }

  terminal state == Bad

  action Program(value: 0..3)
  action ProgramDone()
  action ProgramFailed()
  action Verify()
  action VerifyPassed()
  action VerifyFailed()
  action Erase()
  action EraseDone()

  on Program(value) {
    state' = Programming
    data' = value
  }

  on ProgramDone {
    require state == Programming else reject "not-programming"
    state' = Programmed
  }

  on ProgramFailed {
    require state == Programming else reject "not-programming"
    state' = Programmed
  }

  on Verify {
    require state == Programmed else reject "not-programmed"
    state' = Verifying
  }

  on VerifyPassed {
    require state == Verifying else reject "not-verifying"
    state' = Verified
  }

  on VerifyFailed {
    require state == Verifying else reject "not-verifying"
    if retries < 2 {
      retries' = retries + 1
      state' = Erasing
    } else {
      state' = Bad
    }
  }

  on Erase {
    require state == Programmed || state == Verified else reject "nothing-to-erase"
    state' = Erasing
  }

  on EraseDone {
    require state == Erasing else reject "not-erasing"
    state' = Erased
  }

  step property erased-before-program: action == Program implies pre.state == Erased
  invariant bad-after-limit: state == Bad implies retries == 2
  step property data-written-only-by-program: action != Program implies post.data == pre.data
}
