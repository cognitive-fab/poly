// expected: CLEAN
// PR reviewer (docs/examples/pr-reviewer.md). A workflow: each effect is a work order for an agent's tool. The agent reads
// the diff, reviews it, posts the review as a comment and sets a label. The policy allows the comment and the label and
// denies the merge, which the agent has as a tool and the program never asks for; a budget caps what one review may cost.
// The path property never-merges is what the check proves; PL6804 asks a workflow's machine for a path property.
module reviewer

enum Phase { Idle, Reading, Reviewing, Commenting, Labelling, Merging, Done, Failed }

enum Verdict { Good, Bad }

machine Review {
  state {
    phase   : Phase = Idle
    number  : 1..3 = 1
    outcome : Verdict = Bad
  }

  terminal phase in { Done, Failed }

  action Start(pr: 1..3)
  action Fetched()
  action FetchFailed()
  action Reviewed(verdict: Verdict)
  action ReviewFailed()
  action Commented()
  action CommentFailed()
  action Labelled()
  action LabelFailed()
  action Merged()
  action MergeFailed()

  on Start(pr) {
    require phase == Idle else reject "started"
    phase' = Reading
    number' = pr
    emit fetch(pr: pr)
  }

  on Fetched {
    require phase == Reading else reject "not-reading"
    phase' = Reviewing
    emit analyze(pr: number)
  }

  on FetchFailed {
    require phase == Reading else reject "not-reading"
    phase' = Failed
  }

  on Reviewed(verdict) {
    require phase == Reviewing else reject "not-reviewing"
    phase' = Commenting
    outcome' = verdict
    emit comment(pr: number, verdict: verdict)
  }

  on ReviewFailed {
    require phase == Reviewing else reject "not-reviewing"
    phase' = Failed
  }

  on Commented {
    require phase == Commenting else reject "not-commenting"
    phase' = Labelling
    emit label(pr: number, verdict: outcome)
  }

  on CommentFailed {
    require phase == Commenting else reject "not-commenting"
    phase' = Failed
  }

  on Labelled {
    require phase == Labelling else reject "not-labelling"
    phase' = Done
  }

  on LabelFailed {
    require phase == Labelling else reject "not-labelling"
    phase' = Failed
  }

  on Merged {
    require phase == Merging else reject "not-merging"
    phase' = Done
  }

  on MergeFailed {
    require phase == Merging else reject "not-merging"
    phase' = Failed
  }

  path property comment-at-most-once: count("github.comment") <= 1
  path property never-merges: count("github.merge") <= 0

  effect fetch(pr: 1..3) {
    kind "github.diff"
    labels { read:repo }
    class none
    retry { attempts 3, base 1s, timeout 30s }
    ok -> Fetched()
    failed -> FetchFailed()
  }

  effect analyze(pr: 1..3) {
    kind "agent.review"
    labels { read:repo }
    class none
    retry { attempts 2, base 1s, timeout 60s }
    ok(r) -> Reviewed(verdict: r.verdict)
    failed -> ReviewFailed()
  }

  effect comment(pr: 1..3, verdict: Verdict) {
    kind "github.comment"
    labels { egress:external }
    class compensable
    retry { attempts 3, base 1s, timeout 30s }
    ok -> Commented()
    failed -> CommentFailed()
  }

  effect label(pr: 1..3, verdict: Verdict) {
    kind "github.label"
    labels { egress:external }
    class reversible
    retry { attempts 3, base 1s, timeout 30s }
    ok -> Labelled()
    failed -> LabelFailed()
  }

  effect merge(pr: 1..3) {
    kind "github.merge"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 1s, timeout 30s }
    ok -> Merged()
    failed -> MergeFailed()
  }
}

budget review_spend {
  cap usd 0.25 per run
  cap usd 0.45 per month
}

workflow review runs Review {
  input Start
  key "{pr}" where pr matches "^[1-3]$"
  tool "github.diff" -> gh_diff why "read the pull request's diff"
  tool "agent.review" -> reviewer why "review the diff"
  tool "github.comment" -> gh_comment why "post the review as a comment"
  tool "github.label" -> gh_label why "label the pull request"
  tool "github.merge" -> gh_merge why "merge the pull request"
  budget review_spend prices "prices/agent.json" order cap usd 0.05
}
