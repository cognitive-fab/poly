// expected: INCONCLUSIVE PL3901 (a bound is hit, PS13.5)
// The hashicorp/raft role-transition machine of the field study (conformance/field-studies/raft), in poly.
// Two differences from the hand-written reference, neither visible to replay, which compares states:
//   - Shutdown is declared terminal, so actions in Shutdown reject with "terminal" (PS3.2);
//   - `term` grows without limit in the real machine, so it is checked up to a bound (PS4.2a).
// NewerTermSeen's parameter is named `term`, like the field, because the corpus names it so;
// pre.term reads the field (S19, proposed).
module raft

type Role = Follower | Candidate | Leader | Shutdown

machine Node {
  state {
    role : Role = Follower
    term : int check 0..9 = 0
  }
  terminal role is Shutdown

  action ElectionTimeout()
  action ElectionWon()
  action NewerTermSeen(term: int check { 1, 2, 3, 5, 8 })
  action QuorumLost()
  action ShutdownRequested()

  // raft.go: the election timer fires in runFollower; the node becomes Candidate at term + 1.
  on ElectionTimeout {
    require role == Follower else reject "election-timeout-only-from-follower"
    role' = Candidate
    term' = term + 1
  }

  // runCandidate: a quorum of votes promotes a Candidate; the term does not change.
  on ElectionWon {
    require role == Candidate else reject "election-won-only-from-candidate"
    role' = Leader
  }

  // A Leader that loses its quorum steps down at the same term.
  on QuorumLost {
    require role == Leader else reject "quorum-lost-only-from-leader"
    role' = Follower
  }

  // Any role that sees a strictly newer term becomes Follower at that term.
  on NewerTermSeen(term) {
    require role != Shutdown else reject "shutdown-is-terminal"
    require term > pre.term else reject "stale-term-ignored"
    role' = Follower
    term' = term
  }

  on ShutdownRequested {
    require role != Shutdown else reject "already-shutdown"
    role' = Shutdown
  }

  invariant term-is-non-negative: term >= 0
  step property term-never-decreases: post.term >= pre.term
  step property shutdown-is-a-true-terminal-state: pre.role == Shutdown implies post.role == Shutdown
  step property only-newer-term-seen-can-change-term: post.term == pre.term || action == ElectionTimeout || action == NewerTermSeen
  step property election-won-cannot-skip-candidate: post.role != Leader || pre.role == post.role || pre.role == Candidate
}
