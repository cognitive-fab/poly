// expected: FINDING PL3102
// Act 1 of the demo (poly-agentlab PROPOSAL 3.2): the first draft of the desk, with only the per-request rules of the Lab's
// recipes and no read budget. Stop the export is kept (the program declares no effect for export_all_customers) and so is
// Protect the email (an email change is refused outright, as the gateway's Rego refuses it). Each of those looks at one
// request. The bound of desk.poly is kept: customersRead, the customers the server has returned to this Desk, is in 0..19,
// the most a Desk with a budget of 10 can reach. Nothing here refuses a read, so the field escapes its domain: the check
// finds the slow export, the searches that each pass every per-request rule and together read more customers than the bound
// (PT3.5, PL3102). desk.poly adds the budget and reads CLEAN.
module desk_per_request

enum Field { Phone, Address, Email }

// Which read tool a customer read is: find_customers(query) or read_customer(id). One effect carries both, so one kind counts them.
enum Tool { Find, Read }

// S450: the bound action's claims, a field of the webhook kind's Sender claims.
claims Caller {
  principal: Principal
}

channel gateway: webhook {
  adapter "webhook"
  thread "{source}"
  principal from principal
  starts Desk.Start on inbound
  Message -> Desk.Got
  Delivered -> Desk.Delivered
  Rejected -> Desk.SendRejected
  Failed -> Desk.SendFailed
}

// Desk: one per caller. customersRead is the customers the server has returned to this Desk, with the domain of desk.poly,
// 0..19. Nothing refuses a read on it. reading is a read issued and not yet completed (one at a time, as in desk.poly).
// writing is a write issued and not yet settled.
service machine Desk {
  state {
    started   : bool      = false
    caller    : Principal = none
    customersRead : 0..19 = 0
    reading   : bool      = false
    writing   : bool      = false
    arrivals  : bool      = false
    receipts  : bool      = false
  }

  action Start()
  action Got(body: Content)
  action Find(query: string check { "ada" })
  action Read(id: string check { "c1" })
  action Update(id: string check { "c1" }, field: Field, value: string check { "v1" })
  action Returned(n: 0..10)
  action ReadFailed()
  action Updated()
  action UpdateFailed()
  action Delivered()
  action SendRejected(reason: string check { "endpoint-disabled" })
  action SendFailed()

  on Start {
    require !started else reject "started"
    started' = true
  }

  // The verified arrival of a request from the gateway. The claims come from the adapter (K11), never from the body. The
  // Desk returns the request's own Content on the thread as the receipt of its arrival, so each arrival is answered and the
  // channel's rules (one send at a time, none to a disabled endpoint) are exercised by the program. The server's answer to the
  // tool call is the host's to return (the README says so). arrivals flips on each, as receipts does below: an arrival from the
  // same caller would otherwise emit and change nothing, which polyrun reports as PL2501.
  on Got(body) by c: Caller {
    caller' = c.principal
    arrivals' = !arrivals
    emit gateway.reply(body: body)
  }

  on Find(query) {
    require caller != none else reject "unverified"
    require !reading else reject "read-pending"
    reading' = true
    emit read(tool: Find, arg: query)
  }

  on Read(id) {
    require caller != none else reject "unverified"
    require !reading else reject "read-pending"
    reading' = true
    emit read(tool: Read, arg: id)
  }

  // The read's completion carries n, the number of customers the server returned, as a strict range 0..10: a server that
  // answers more is refused at dispatch (outside-check-domain), which is the safe side. The host sends n (see the README).
  on Returned(n) {
    require reading else reject "not-reading"
    reading' = false
    customersRead' = customersRead + n
  }

  // A read that failed returned nothing the agent saw, so nothing is counted.
  on ReadFailed {
    require reading else reject "not-reading"
    reading' = false
  }

  // Protect the email, per request: an email change is refused. A phone or address change runs, one write at a time.
  on Update(id, field, value) {
    require caller != none else reject "unverified"
    require field != Email else reject "email-protected"
    require !writing else reject "write-pending"
    writing' = true
    emit update(id: id, field: field, value: value)
  }

  on Updated {
    require writing else reject "not-writing"
    writing' = false
  }

  on UpdateFailed {
    require writing else reject "not-writing"
    writing' = false
  }

  // The webhook conversation's receipts. The Desk sends nothing through it (the host answers the agent), but the binding
  // is total (PL6813), so each receipt is taken. It flips `receipts`, because polyrun reports a receipt that emits (the
  // conversation's Ack) and changes nothing as PL2501, and a count of receipts would need a bound the Desk has no use for.
  on Delivered {
    receipts' = !receipts
  }

  on SendRejected(reason) {
    receipts' = !receipts
  }

  on SendFailed {
    receipts' = !receipts
  }

  // MCP carries a read as a POST, which class none refuses (PS23.10, PL6412), so a read is declared reversible. Both read tools are one effect.
  effect read(tool: Tool, arg: string) {
    kind "customers.read"
    labels { egress:external }
    class reversible
    ok(r) -> Returned(n: r.n)
    failed -> ReadFailed()
  }

  // One attempt only: a lost answer ends with the failed completion. No idempotent line: the server honours no key.
  effect update(id: string, field: Field, value: string) {
    kind "customers.write"
    labels { egress:external }
    class irreversible
    retry { attempts 1 }
    ok -> Updated()
    failed -> UpdateFailed()
  }
}
