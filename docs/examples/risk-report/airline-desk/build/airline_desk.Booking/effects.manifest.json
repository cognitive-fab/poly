        }
      },
      "labels": [
        "exec"
      ],
      "retry": {
        "maxAttempts": 3,
        "baseMs": 10,
        "timeoutMs": 1000
      },
      "onSuccess": {
        "action": "Worked"
      },
      "onFailure": {
        "action": "Gave"
      },
      "onExhausted": {
        "action": "Gave"
      },
      "class": "compensable"
    }
  }
