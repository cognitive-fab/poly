    "airline.change": {
      "payloadSchema": {
        "n": {
          "type": "number",
          "required": true
        }
      },
      "labels": [
        "exec"
      ],
      "retry": {
        "maxAttempts": 3,
        "baseMs": 10,
        "timeoutMs": 1000
