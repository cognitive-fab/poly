{
  "effects": {
    "route.triage.call": {
      "payloadSchema": {
        "tier": {
          "type": "number",
          "required": true
        }
      },
      "labels": [
        "egress:external",
        "read:private"
      ],
      "retry": {
        "maxAttempts": 1,
        "baseMs": 500,
        "timeoutMs": 800
      },
      "onSuccess": {
        "action": "Answer",
        "map": {
          "conf": "$.result.conf",
          "margin": "$.result.margin"
        }
      },
      "onFailure": {
        "action": "Fail"
      },
      "onExhausted": {
        "action": "Fail"
      },
      "class": "none"
    }
  }
}
