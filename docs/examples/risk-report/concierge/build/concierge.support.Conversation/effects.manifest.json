{
  "effects": {
    "channel.support.send": {
      "payloadSchema": {
        "body": {
          "type": "string",
          "required": true
        },
        "kind": {
          "type": "string",
          "required": true
        }
      },
      "retry": {
        "maxAttempts": 1,
        "baseMs": 500,
        "timeoutMs": 30000
      },
      "labels": [
        "egress:external"
      ],
      "onSuccess": {
        "action": "Sent"
      },
      "onFailure": {
        "action": "SendFailed"
      },
      "onExhausted": {
        "action": "SendFailed"
      },
      "class": "irreversible"
    }
  },
  "timerTargets": [
    "WindowExpired"
  ]
}
