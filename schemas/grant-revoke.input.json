{
  "type": "object",
  "properties": {
    "grant": {
      "type": "string",
      "description": "the grant's instance id"
    },
    "credential": {
      "type": "string",
      "description": "or the credential, whose one live grant in the store is revoked"
    },
    "db": {
      "type": "string",
      "description": "the store, read without being written, with credential"
    },
    "by": {
      "type": "string",
