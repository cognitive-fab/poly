// The grant of a delegated credential (PT22.2, S204, S209), written from RFC 6749 (OAuth 2.0) and RFC 7009 (token
// revocation). Each credential c of a module m has its own instance of this module, m.c, with c's scope set (PS16);
// this module is checked alone with two scopes. Tokens are not state: the vault adapter keeps them under the grant's
// id, and the machine keeps only the lifecycle and the scopes the holder granted (PT22.2d).
module std.credentials

type ScopeSet = { first: bool, second: bool }

enum GrantState { Requested, Granted, Refreshing, Expired, Revoked }

machine Grant {
  state {
    g       : GrantState = Requested
    scopes  : ScopeSet = { first: false, second: false }
    attempt : 0..3 = 0
  }

  terminal g == Revoked

  action Callback(granted: ScopeSet)
  action TokenExpiring()
  action Refreshed(valid: bool)
  action RefreshFailed()
  action Revoke()
  action Reauthorize()

  on Callback(granted) {
    require g == Requested else reject "not-requested"
    g' = Granted
    scopes' = granted
  }

  on TokenExpiring {
    require g == Granted else reject "not-granted"
    g' = Refreshing
    attempt' = 1
    emit refresh()
  }

  on Refreshed(valid) {
    require g == Refreshing else reject "not-refreshing"
    attempt' = 0
    if valid {
      g' = Granted
    } else {
      g' = Expired
    }
  }

  on RefreshFailed {
    require g == Refreshing else reject "not-refreshing"
    if attempt < 3 {
      attempt' = attempt + 1
      emit refresh()
    } else {
      g' = Expired
      attempt' = 0
    }
  }

  on Revoke {
    require g != Revoked else reject "revoked"
    emit revoke()
    g' = Revoked
    attempt' = 0
  }

  on Reauthorize {
    require g == Expired || g == Granted else reject "not-reauthorizable"
    g' = Requested
    scopes' = { first: false, second: false }
  }

  effect refresh() {
    kind "credential.refresh"
    labels { egress:external }
    retry { attempts 1, base 500ms, timeout 30s }
    class reversible
    ok(r) -> Refreshed(valid: r.valid)
    failed -> RefreshFailed()
    exhausted -> RefreshFailed()
  }

  effect revoke() {
    kind "credential.revoke"
    labels { egress:external }
    class irreversible
  }

  invariant attempt-only-while-refreshing: (g == Refreshing) == attempt > 0

  step property refresh-keeps-scopes: pre.g == Refreshing implies post.scopes == pre.scopes
  step property scopes-only-by-consent: post.scopes != pre.scopes implies (action == Callback || action == Reauthorize)
  step property invalid-grant-expires: (action == Refreshed && !valid) implies post.g == Expired
  step property refresh-bounded: (action == RefreshFailed && pre.g == Refreshing) implies (post.g == Expired) == (pre.attempt == 3)
  step property revoke-revokes-tokens: (action == Revoke && pre.g != Revoked) implies emits(revoke)

  liveness refresh-ends: g == Refreshing leads to g == Granted || g == Expired || g == Revoked
    under fair { Refreshed | RefreshFailed }
}
