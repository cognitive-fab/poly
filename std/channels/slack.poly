// The Slack conversation (PS15), written from Slack's documentation of chat.postMessage and of the channel_archive
// and channel_unarchive events. Each rule, its source and the date it was read are in slack/PROVENANCE.md. A thread is
// one Slack channel. Nothing is posted to an archived channel, and at most one message is posted per second: after a
// post, the next waits until a one-second timer has fired. A send the rules forbid is accepted, and the application
// is told why (Q1, S179).
//
// poly's own bounds, as in every std conversation: one slot holds a send, then its receipt, until the application's
// Ack (PS15.3), and a reply while it is held is refused "busy"; at most two messages wait for an answer, and a third
// is refused "backlog"; pending counts both, so its bound 3 is the transit bound (PS15.5).
module std.channels.slack

enum Event { Posted, Archived, Unarchived }

enum Slot { Free, Sending, Receipt }

// K11, PT21.4: the sender claims the adapter verified, which travel in the Inbound step's label and, by lineage,
// in every step it causes. An adapter's verified true is Verified; a provider event carries the provider's own
// (Verified).
enum Verification { Unverified, Verified }

claims Sender {
  verified: Verification
}

machine Peer {
  state {
  }

  action Message(body: Content)
  action Delivered()
  action Rejected(reason: string check { "channel-archived", "rate-limited" })
  action Failed()
}

service machine Conversation {
  state {
    archived : bool = false
    cooling  : bool = false
    waiting  : 0..2 = 0
    queued   : 0..2 = 0
    queue1   : Content = none
    queue2   : Content = none
    slot     : Slot = Free
    pending  : 0..3 = 0
    app      : Ref<Peer> = none
  }

  invariant obligations: (slot is Free implies pending == waiting + queued) && (!(slot is Free) implies pending == waiting + queued + 1)
  invariant queue-while-held: queued == 0 || !(slot is Free)

  action Open(app: Ref<Peer>)
  action Inbound(channel: string check { "C-1", "C-2" }, body: Content, event: Event)
  action Reply(body: Content)
  action Template(body: Content)
  action Sent()
  action Cooled()
  action SendFailed()
  action Ack()

  on Open(app) {
    require app != none else reject "no-app"
    app' = app
  }

  // The Events API reports an archive and an unarchive of the channel; only a posted message reaches the application.
  on Inbound(channel, body, event) by sender: Sender {
    if event is Archived {
      require !archived else reject "already-archived"
      archived' = true
    } else {
      if event is Unarchived {
        require archived else reject "not-archived"
        archived' = false
      } else {
        require waiting + queued < 2 else reject "backlog"
        waiting' = waiting + 1
        pending' = pending + 1
        send app <- Message(body: body)
      }
    }
  }

  // An answer, sent or refused, settles one waiting message and takes the slot, or waits for it in the queue.
  on Reply(body) {
    if slot is Free {
      if waiting > 0 {
        waiting' = waiting - 1
      } else {
        pending' = pending + 1
      }
      if archived {
        slot' = Receipt
        send app <- Rejected(reason: "channel-archived")
      } else {
        if cooling {
          slot' = Receipt
          send app <- Rejected(reason: "rate-limited")
        } else {
          slot' = Sending
          emit send(body: body)
        }
      }
    } else {
      // A reply that answers a waiting message waits for the slot, in order (at most two, within pending).
      require waiting > 0 else reject "busy"
      waiting' = waiting - 1
      queued' = queued + 1
      if queued == 0 {
        queue1' = body
      } else {
        queue2' = body
      }
    }
  }

  // Slack has no template of its own: a template is a message the application started, under the same rules.
  on Template(body) {
    require slot is Free else reject "busy"
    if waiting > 0 {
      waiting' = waiting - 1
    } else {
      pending' = pending + 1
    }
    if archived {
      slot' = Receipt
      send app <- Rejected(reason: "channel-archived")
    } else {
      if cooling {
        slot' = Receipt
        send app <- Rejected(reason: "rate-limited")
      } else {
        slot' = Sending
        emit send(body: body)
      }
    }
  }

  on Sent {
    require slot is Sending else reject "idle"
    slot' = Receipt
    cooling' = true
    after 1s -> Cooled() as cool
    send app <- Delivered()
  }

  on Cooled {
    require cooling else reject "idle"
    cooling' = false
  }

  // is_archived, not_in_channel, channel_not_found and rate_limited after its retries are a failed send.
  on SendFailed {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Failed()
  }

  // The application has consumed the receipt: the slot is free, or the next queued reply takes it.
  on Ack {
    require slot is Receipt else reject "no-receipt"
    if queued == 0 {
      slot' = Free
      pending' = pending - 1
    } else {
      // The first queued reply takes the slot, under the rules as they stand now.
      queued' = queued - 1
      queue1' = queue2
      queue2' = none
      pending' = pending - 1
      if archived {
        slot' = Receipt
        send app <- Rejected(reason: "channel-archived")
      } else {
        if cooling {
          slot' = Receipt
          send app <- Rejected(reason: "rate-limited")
        } else {
          slot' = Sending
          emit send(body: queue1)
        }
      }
    }
  }

  effect send(body: Content) {
    kind "channel.send"
    labels { egress:external }
    class irreversible
    ok -> Sent()
    failed -> SendFailed()
    exhausted -> SendFailed()
  }

  never no-post-to-archived: emit send while archived
  never one-message-per-second: emit send while cooling
  never one-send-at-a-time: emit send while slot is Sending
}
