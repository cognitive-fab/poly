// The SMS conversation (PS15), written from Twilio's documentation of opt-out keywords. Each rule, its source and the
// date it was read are in sms/PROVENANCE.md. A thread is one phone number. An opt-out keyword withdraws the number's
// consent and an opt-in keyword gives it back; no message is sent to a number without consent. The adapter classifies
// a message's keyword, matching the provider's lists without regard to case; the conversation reads only the class.
// A send the rules forbid is accepted, and the application is told why (Q1, S179).
//
// poly's own bounds, as in every std conversation: one slot holds a send, then its receipt, until the application's
// Ack (PS15.3), and a reply while it is held is refused "busy"; at most two messages wait for an answer, and a third
// is refused "backlog"; pending counts both, so its bound 3 is the transit bound (PS15.5).
module std.channels.sms

enum Keyword { Plain, OptOut, OptIn, Help, Reported }

enum Slot { Free, Sending, Receipt }

// K11, PT21.4: the sender claims the adapter verified, which travel in the Inbound step's label and, by lineage,
// in every step it causes. An adapter's verified true is Verified; a provider event carries the provider's own
// (Verified).
enum Verification { Unverified, Verified }

claims Sender {
  verified: Verification
}

machine Peer {
  state {
  }

  action Message(body: Content)
  action Delivered()
  action Rejected(reason: string check { "opted-out" })
  action Failed()
}

service machine Conversation {
  state {
    consent : bool = true
    waiting : 0..2 = 0
    queued  : 0..2 = 0
    queue1  : Content = none
    queue2  : Content = none
    slot    : Slot = Free
    pending : 0..3 = 0
    app     : Ref<Peer> = none
  }

  invariant obligations: (slot is Free implies pending == waiting + queued) && (!(slot is Free) implies pending == waiting + queued + 1)
  invariant queue-while-held: queued == 0 || !(slot is Free)

  action Open(app: Ref<Peer>)
  action Inbound(from: string check { "sms-1", "sms-2" }, body: Content, keyword: Keyword)
  action Reply(body: Content)
  action Template(body: Content)
  action Sent()
  action SendFailed()
  action Ack()

  on Open(app) {
    require app != none else reject "no-app"
    app' = app
  }

  // A keyword reaches the application too: the provider answers the keyword itself, and the application learns of the
  // opt-out from the message and from the refusal of its next send. A keyword changes consent even when two messages
  // already wait, so the backlog can never keep an opt-out from taking effect; only the message to the application is
  // then dropped. A plain message is refused "backlog".
  on Inbound(from, body, keyword) by sender: Sender {
    if keyword is Reported {
      // The provider refused a send because the number opted out (Twilio 21610): a provider event, no message.
      consent' = false
    } else {
      if keyword is OptOut {
        consent' = false
        if waiting + queued < 2 {
          waiting' = waiting + 1
          pending' = pending + 1
          send app <- Message(body: body)
        }
      } else {
        if keyword is OptIn {
          consent' = true
          if waiting + queued < 2 {
            waiting' = waiting + 1
            pending' = pending + 1
            send app <- Message(body: body)
          }
        } else {
          require waiting + queued < 2 else reject "backlog"
          waiting' = waiting + 1
          pending' = pending + 1
          send app <- Message(body: body)
        }
      }
    }
  }

  // An answer, sent or refused, settles one waiting message and takes the slot, or waits for it in the queue.
  on Reply(body) {
    if slot is Free {
      if waiting > 0 {
        waiting' = waiting - 1
      } else {
        pending' = pending + 1
      }
      if !consent {
        slot' = Receipt
        send app <- Rejected(reason: "opted-out")
      } else {
        slot' = Sending
        emit send(body: body)
      }
    } else {
      // A reply that answers a waiting message waits for the slot, in order (at most two, within pending).
      require waiting > 0 else reject "busy"
      waiting' = waiting - 1
      queued' = queued + 1
      if queued == 0 {
        queue1' = body
      } else {
        queue2' = body
      }
    }
  }

  // SMS has no template of its own: a template is a message the application started, under the same rules.
  on Template(body) {
    require slot is Free else reject "busy"
    if waiting > 0 {
      waiting' = waiting - 1
    } else {
      pending' = pending + 1
    }
    if !consent {
      slot' = Receipt
      send app <- Rejected(reason: "opted-out")
    } else {
      slot' = Sending
      emit send(body: body)
    }
  }

  on Sent {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Delivered()
  }

  on SendFailed {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Failed()
  }

  // The application has consumed the receipt: the slot is free, or the next queued reply takes it.
  on Ack {
    require slot is Receipt else reject "no-receipt"
    if queued == 0 {
      slot' = Free
      pending' = pending - 1
    } else {
      // The first queued reply takes the slot, under the rules as they stand now.
      queued' = queued - 1
      queue1' = queue2
      queue2' = none
      pending' = pending - 1
      if !consent {
        slot' = Receipt
        send app <- Rejected(reason: "opted-out")
      } else {
        slot' = Sending
        emit send(body: queue1)
      }
    }
  }

  effect send(body: Content) {
    kind "channel.send"
    labels { egress:external }
    class irreversible
    ok -> Sent()
    failed -> SendFailed()
    exhausted -> SendFailed()
  }

  step property consent-changes-only-by-keyword: pre.consent == post.consent || action == Inbound && !(keyword is Plain) && !(keyword is Help)

  reject property opt-keyword-never-refused: (action == Inbound && (keyword is OptOut || keyword is OptIn || keyword is Reported)) implies !rejected("backlog")

  // poly's own (review B-F4, M8b): the queue keeps the order the replies were given in.
  step property queue-shifts-in-order: !(pre.queued > post.queued) || post.queue1 == pre.queue2 && post.queue2 == none
  step property queue-appends-first: !(action == Reply && pre.queued == 0 && post.queued == 1 && post.queue1 != body)
  step property queue-appends-second: !(action == Reply && pre.queued == 1 && post.queued == 2 && (post.queue2 != body || post.queue1 != pre.queue1))

  never no-send-after-opt-out: emit send while !consent
  never one-send-at-a-time: emit send while slot is Sending
}
