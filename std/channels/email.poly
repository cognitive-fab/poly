// The email conversation (PS15), written from RFC 8058 (one-click unsubscribe) and Gmail's email sender guidelines.
// Each rule, its source and the date it was read are in email/PROVENANCE.md. A thread is one correspondent. A
// one-click unsubscribe ends bulk mail to the correspondent for good; a reply to their own message is still allowed.
// Two bounced messages suppress the address, and nothing is sent to it again. A send the rules forbid is accepted,
// and the application is told why (Q1, S179).
//
// poly's own bounds, as in every std conversation: one slot holds a send, then its receipt, until the application's
// Ack (PS15.3), and a reply while it is held is refused "busy"; at most two messages wait for an answer, and a third
// is refused "backlog"; pending counts both, so its bound 3 is the transit bound (PS15.5).
module std.channels.email

enum Event { Mail, Unsubscribe, Bounce }

enum Kind { Direct, Bulk }

enum Slot { Free, Sending, Receipt }

// K11, PT21.4: the sender claims the adapter verified, which travel in the Inbound step's label and, by lineage,
// in every step it causes. An adapter's verified true is Verified; a provider event carries the provider's own
// (Verified).
enum Verification { Unverified, Verified }

claims Sender {
  verified: Verification
}

machine Peer {
  state {
  }

  action Message(body: Content)
  action Delivered()
  action Rejected(reason: string check { "unsubscribed", "suppressed" })
  action Failed()
}

service machine Conversation {
  state {
    subscribed : bool = true
    bounces    : 0..2 = 0
    waiting    : 0..2 = 0
    queued     : 0..2 = 0
    queue1     : Content = none
    queue2     : Content = none
    slot       : Slot = Free
    pending    : 0..3 = 0
    app        : Ref<Peer> = none
  }

  invariant obligations: (slot is Free implies pending == waiting + queued) && (!(slot is Free) implies pending == waiting + queued + 1)
  invariant queue-while-held: queued == 0 || !(slot is Free)

  action Open(app: Ref<Peer>)
  action Inbound(from: string check { "mail-1", "mail-2" }, body: Content, event: Event)
  action Reply(body: Content)
  action Template(body: Content)
  action Sent()
  action SendFailed()
  action Ack()

  on Open(app) {
    require app != none else reject "no-app"
    app' = app
  }

  // The adapter turns a verified one-click POST (List-Unsubscribe=One-Click) into the event Unsubscribe, and the
  // provider's report of a permanent failure after the send was accepted into the provider event Bounce (PS15.4).
  // Neither carries a message for the application.
  on Inbound(from, body, event) by sender: Sender {
    if event is Unsubscribe {
      require subscribed else reject "unsubscribed"
      subscribed' = false
    } else {
      if event is Bounce {
        require bounces < 2 else reject "suppressed"
        bounces' = bounces + 1
      } else {
        require waiting + queued < 2 else reject "backlog"
        waiting' = waiting + 1
        pending' = pending + 1
        send app <- Message(body: body)
      }
    }
  }

  // A reply answers the correspondent's own message, so an unsubscribe does not stop it; suppression does. An answer,
  // sent or refused, settles one waiting message and takes the slot, or waits for it in the queue.
  on Reply(body) {
    if slot is Free {
      if waiting > 0 {
        waiting' = waiting - 1
      } else {
        pending' = pending + 1
      }
      if bounces == 2 {
        slot' = Receipt
        send app <- Rejected(reason: "suppressed")
      } else {
        slot' = Sending
        emit send(body: body, kind: Direct)
      }
    } else {
      // A reply that answers a waiting message waits for the slot, in order (at most two, within pending).
      require waiting > 0 else reject "busy"
      waiting' = waiting - 1
      queued' = queued + 1
      if queued == 0 {
        queue1' = body
      } else {
        queue2' = body
      }
    }
  }

  // A template is bulk mail: it needs a subscribed, unsuppressed address, and goes out with the one-click headers.
  on Template(body) {
    require slot is Free else reject "busy"
    if waiting > 0 {
      waiting' = waiting - 1
    } else {
      pending' = pending + 1
    }
    if bounces == 2 {
      slot' = Receipt
      send app <- Rejected(reason: "suppressed")
    } else {
      if !subscribed {
        slot' = Receipt
        send app <- Rejected(reason: "unsubscribed")
      } else {
        slot' = Sending
        emit send(body: body, kind: Bulk)
      }
    }
  }

  on Sent {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Delivered()
  }

  on SendFailed {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Failed()
  }

  // The application has consumed the receipt: the slot is free, or the next queued reply takes it.
  on Ack {
    require slot is Receipt else reject "no-receipt"
    if queued == 0 {
      slot' = Free
      pending' = pending - 1
    } else {
      // The first queued reply takes the slot, under the rules as they stand now.
      queued' = queued - 1
      queue1' = queue2
      queue2' = none
      pending' = pending - 1
      if bounces == 2 {
        slot' = Receipt
        send app <- Rejected(reason: "suppressed")
      } else {
        slot' = Sending
        emit send(body: queue1, kind: Direct)
      }
    }
  }

  effect send(body: Content, kind: Kind) {
    kind "channel.send"
    labels { egress:external }
    class irreversible
    ok -> Sent()
    failed -> SendFailed()
    exhausted -> SendFailed()
  }

  step property unsubscribe-holds: pre.subscribed || !post.subscribed
  // A bounce is the recipient's: the provider event Bounce, never a send's own failure (review B-F5).
  step property bounces-only-from-the-recipient: pre.bounces == post.bounces || action == Inbound && event is Bounce
  // poly's own (review B-F4, M8b): the queue keeps the order the replies were given in.
  step property queue-shifts-in-order: !(pre.queued > post.queued) || post.queue1 == pre.queue2 && post.queue2 == none
  step property queue-appends-first: !(action == Reply && pre.queued == 0 && post.queued == 1 && post.queue1 != body)
  step property queue-appends-second: !(action == Reply && pre.queued == 1 && post.queued == 2 && (post.queue2 != body || post.queue1 != pre.queue1))

  never no-bulk-after-unsubscribe: emit send(kind: Bulk) while !subscribed
  never no-send-to-suppressed: emit send while bounces == 2
  never one-send-at-a-time: emit send while slot is Sending
}
