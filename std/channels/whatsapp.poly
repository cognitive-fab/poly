// The WhatsApp conversation (PS15, PT21.3), written from the WhatsApp Cloud API documentation. Each rule, its source
// and the date it was read are in whatsapp/PROVENANCE.md. A thread is one customer. A customer's message opens the
// customer service window for 24 hours, and a later one resets it; a free-form reply goes out only inside the window,
// a template in or outside it. A send the rules forbid is accepted, and the application is told why (Q1, S179).
//
// poly's own bounds: one slot holds a send, then its receipt, until the application's Ack (PS15.3); a reply or a
// template while the slot is held is refused "busy". At most two customer messages wait for an answer; a third opens
// a closed window and is not passed to the application, and is refused "backlog" while the window is open. pending
// counts both, so its bound 3 is the transit bound of the configuration the channel generates (PS15.5): two waiting
// messages and one receipt.
module std.channels.whatsapp

enum Window { Closed, Open }

enum Kind { FreeForm, Templated }

enum Slot { Free, Sending, Receipt }

// K11, PT21.4: the sender claims the adapter verified, which travel in the Inbound step's label and, by lineage,
// in every step it causes. An adapter's verified true is Verified; a provider event carries the provider's own
// (Verified).
enum Verification { Unverified, Verified }

claims Sender {
  verified: Verification
}

machine Peer {
  state {
  }

  action Message(body: Content)
  action Delivered()
  action Rejected(reason: string check { "window-closed" })
  action Failed()
}

service machine Conversation {
  state {
    window  : Window = Closed
    waiting : 0..2 = 0
    queued  : 0..2 = 0
    queue1  : Content = none
    queue2  : Content = none
    slot    : Slot = Free
    pending : 0..3 = 0
    app     : Ref<Peer> = none
  }

  invariant obligations: (slot is Free implies pending == waiting + queued) && (!(slot is Free) implies pending == waiting + queued + 1)
  invariant queue-while-held: queued == 0 || !(slot is Free)

  action Open(app: Ref<Peer>)
  action Inbound(from: string check { "wa-1", "wa-2" } disclosed, body: Content)
  action WindowExpired()
  action Reply(body: Content)
  action Template(body: Content)
  action Sent()
  action SendFailed()
  action Ack()

  on Open(app) {
    require app != none else reject "no-app"
    app' = app
  }

  // The window starts on a customer's message and resets to 24 hours on the next one: the old timer is cancelled
  // before the new one is set (polyrun cancels before it inserts). A message the backlog has no room for still opens
  // a closed window (review B-F3), and only its message to the application is dropped. An open window it leaves as
  // it is, refused "backlog": a step that only re-armed the timer would change nothing else (PL4002). The module's
  // window then closes no later than the provider's, so the cost is a free-form reply refused that the provider
  // would have taken.
  on Inbound(from, body) by sender: Sender {
    if waiting + queued < 2 {
      waiting' = waiting + 1
      pending' = pending + 1
      window' = Open
      cancel w
      after 24h -> WindowExpired() as w
      send app <- Message(body: body)
    } else {
      require window is Closed else reject "backlog"
      window' = Open
      after 24h -> WindowExpired() as w
    }
  }

  on WindowExpired {
    require window is Open else reject "closed"
    window' = Closed
  }

  // An answer, sent or refused, settles one waiting message and takes the slot, or waits for it in the queue.
  on Reply(body) {
    if slot is Free {
      if waiting > 0 {
        waiting' = waiting - 1
      } else {
        pending' = pending + 1
      }
      if window is Closed {
        slot' = Receipt
        send app <- Rejected(reason: "window-closed")
      } else {
        slot' = Sending
        emit send(body: body, kind: FreeForm)
      }
    } else {
      // A reply that answers a waiting message waits for the slot, in order (at most two, within pending).
      require waiting > 0 else reject "busy"
      waiting' = waiting - 1
      queued' = queued + 1
      if queued == 0 {
        queue1' = body
      } else {
        queue2' = body
      }
    }
  }

  // A template is the one message allowed outside the window. Its body names the approved template and its values.
  on Template(body) {
    require slot is Free else reject "busy"
    if waiting > 0 {
      waiting' = waiting - 1
    } else {
      pending' = pending + 1
    }
    slot' = Sending
    emit send(body: body, kind: Templated)
  }

  on Sent {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Delivered()
  }

  on SendFailed {
    require slot is Sending else reject "idle"
    slot' = Receipt
    send app <- Failed()
  }

  // The application has consumed the receipt: the slot is free, or the next queued reply takes it.
  on Ack {
    require slot is Receipt else reject "no-receipt"
    if queued == 0 {
      slot' = Free
      pending' = pending - 1
    } else {
      // The first queued reply takes the slot, under the rules as they stand now.
      queued' = queued - 1
      queue1' = queue2
      queue2' = none
      pending' = pending - 1
      if window is Closed {
        slot' = Receipt
        send app <- Rejected(reason: "window-closed")
      } else {
        slot' = Sending
        emit send(body: queue1, kind: FreeForm)
      }
    }
  }

  effect send(body: Content, kind: Kind) {
    kind "channel.send"
    labels { egress:external }
    class irreversible
    ok -> Sent()
    failed -> SendFailed()
    exhausted -> SendFailed()
  }

  step property window-opens-on-inbound: (pre.window is Closed && post.window is Open) implies action == Inbound

  reject property message-always-opens-window: (action == Inbound && pre.window is Closed) implies !rejected("backlog")

  // poly's own (review B-F4, M8b): the queue keeps the order the replies were given in.
  step property queue-shifts-in-order: !(pre.queued > post.queued) || post.queue1 == pre.queue2 && post.queue2 == none
  step property queue-appends-first: !(action == Reply && pre.queued == 0 && post.queued == 1 && post.queue1 != body)
  step property queue-appends-second: !(action == Reply && pre.queued == 1 && post.queued == 2 && (post.queue2 != body || post.queue1 != pre.queue1))

  never free-form-outside-window: emit send(kind: FreeForm) while window is Closed
  never one-send-at-a-time: emit send while slot is Sending
}
