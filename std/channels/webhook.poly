// The webhook conversation (PS15), written from the Standard Webhooks specification. Each rule, its source and the
// date it was read are in webhook/PROVENANCE.md. A thread is one source: inbound webhooks arrive from it, their
// signatures verified by the adapter, and outbound deliveries go to its endpoint. A delivery succeeds on a 2xx answer
// and is retried with exponential backoff; when deliveries fail consistently the endpoint is disabled, and nothing is
// delivered to it until an operator enables it again. A send the rules forbid is accepted, and the application is
// told why (Q1, S179).
//
// poly's own bounds, as in every std conversation: one slot holds a delivery, then its receipt, until the
// application's Ack (PS15.3), and a reply while it is held is refused "busy"; at most two messages wait for an answer,
// and a third is refused "backlog"; pending counts both, so its bound 3 is the transit bound (PS15.5). Three failed
// deliveries in a row, each after its retries, count as consistent failure.
module std.channels.webhook

enum Slot { Free, Sending, Receipt }

// K11, PT21.4: the sender claims the adapter verified, which travel in the Inbound step's label and, by lineage,
// in every step it causes. An adapter's verified true is Verified; a provider event carries the provider's own
// (Verified).
enum Verification { Unverified, Verified }

// S450: the principal the host maps a verified sender to (rt.mapSenders), else the keyed digest of its address, which no
// source owns; a channel that declares principal from principal gives its thread that principal (PS15.0a).
claims Sender {
  verified: Verification
  principal: Principal
}

machine Peer {
  state {
  }

  action Message(body: Content)
  action Delivered()
  action Rejected(reason: string check { "endpoint-disabled" })
  action Failed()
}

service machine Conversation {
  state {
    enabled  : bool = true
    failures : 0..3 = 0
    waiting  : 0..2 = 0
    queued   : 0..2 = 0
    queue1   : Content = none
    queue2   : Content = none
    slot     : Slot = Free
    pending  : 0..3 = 0
    app      : Ref<Peer> = none
  }

  invariant obligations: (slot is Free implies pending == waiting + queued) && (!(slot is Free) implies pending == waiting + queued + 1)
  invariant queue-while-held: queued == 0 || !(slot is Free)
  invariant disabled-at-three: enabled == failures < 3

  action Open(app: Ref<Peer>)
  action Inbound(source: string check { "hook-1", "hook-2" } disclosed, body: Content)
  action Reply(body: Content)
  action Template(body: Content)
  action Sent()
  action Undelivered()
  action Enable()
  action Ack()

  on Open(app) {
    require app != none else reject "no-app"
    app' = app
  }

  on Inbound(source, body) by sender: Sender {
    require waiting + queued < 2 else reject "backlog"
    waiting' = waiting + 1
    pending' = pending + 1
    send app <- Message(body: body)
  }

  // An answer, sent or refused, settles one waiting message and takes the slot, or waits for it in the queue.
  on Reply(body) {
    if slot is Free {
      if waiting > 0 {
        waiting' = waiting - 1
      } else {
        pending' = pending + 1
      }
      if !enabled {
        slot' = Receipt
        send app <- Rejected(reason: "endpoint-disabled")
      } else {
        slot' = Sending
        emit send(body: body)
      }
    } else {
      // A reply that answers a waiting message waits for the slot, in order (at most two, within pending).
      require waiting > 0 else reject "busy"
      waiting' = waiting - 1
      queued' = queued + 1
      if queued == 0 {
        queue1' = body
      } else {
        queue2' = body
      }
    }
  }

  // A webhook has no template of its own: a template is a delivery the application started, under the same rules.
  on Template(body) {
    require slot is Free else reject "busy"
    if waiting > 0 {
      waiting' = waiting - 1
    } else {
      pending' = pending + 1
    }
    if !enabled {
      slot' = Receipt
      send app <- Rejected(reason: "endpoint-disabled")
    } else {
      slot' = Sending
      emit send(body: body)
    }
  }

  on Sent {
    require slot is Sending else reject "idle"
    slot' = Receipt
    failures' = 0
    send app <- Delivered()
  }

  // A delivery that failed after its retries. The third in a row disables the endpoint.
  on Undelivered {
    require slot is Sending else reject "idle"
    slot' = Receipt
    if failures < 2 {
      failures' = failures + 1
    } else {
      failures' = 3
      enabled' = false
    }
    send app <- Failed()
  }

  // An operator enables the endpoint again, once it answers; the count starts over.
  on Enable {
    require !enabled else reject "enabled"
    enabled' = true
    failures' = 0
  }

  // The application has consumed the receipt: the slot is free, or the next queued reply takes it.
  on Ack {
    require slot is Receipt else reject "no-receipt"
    if queued == 0 {
      slot' = Free
      pending' = pending - 1
    } else {
      // The first queued reply takes the slot, under the rules as they stand now.
      queued' = queued - 1
      queue1' = queue2
      queue2' = none
      pending' = pending - 1
      if !enabled {
        slot' = Receipt
        send app <- Rejected(reason: "endpoint-disabled")
      } else {
        slot' = Sending
        emit send(body: queue1)
      }
    }
  }

  effect send(body: Content) {
    kind "channel.send"
    retry { attempts 1, base 500ms, timeout 30s }
    labels { egress:external }
    class irreversible
    ok -> Sent()
    failed -> Undelivered()
    exhausted -> Undelivered()
  }

  step property disabled-only-after-failures: !(pre.enabled && !post.enabled) || pre.failures == 2
  // poly's own (review B-F4, M8b): the queue keeps the order the replies were given in.
  step property queue-shifts-in-order: !(pre.queued > post.queued) || post.queue1 == pre.queue2 && post.queue2 == none
  step property queue-appends-first: !(action == Reply && pre.queued == 0 && post.queued == 1 && post.queue1 != body)
  step property queue-appends-second: !(action == Reply && pre.queued == 1 && post.queued == 2 && (post.queue2 != body || post.queue1 != pre.queue1))

  never no-delivery-while-disabled: emit send while !enabled
  never one-send-at-a-time: emit send while slot is Sending
}
