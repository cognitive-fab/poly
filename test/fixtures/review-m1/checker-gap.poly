module sig3

enum Leg { Waiting, Moving }

machine Truck {
  state {
    leg : Leg = Waiting
  }
  action Go()
  on Go {
    require leg == Waiting else reject "moving"
    leg' = Moving
  }
}

machine Dispatch {
  state {
    poked : bool = false
    busy : bool = false
  }
  terminal poked

  action Plan()
  action Poke()

  on Plan {
    require !busy else reject "busy"
    busy' = true
    spawn Truck as t[1]
    spawn Truck as t[3]
    after 1h -> Poke() as late[1]
    after 1h -> Poke() as late[3]
  }
  on Poke {
    require busy else reject "idle"
    require !poked else reject "poked"
    poked' = true
    signal t[2] -> Go()
    cancel late[2]
  }
}
