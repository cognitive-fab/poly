module sig3

enum Leg { Waiting, Moving }

machine Truck {
  state {
    leg : Leg = Waiting
  }
  action Go()
  on Go {
    require leg == Waiting else reject "moving"
    leg' = Moving
  }
}

machine Dispatch {
  state {
    poked : bool = false
    busy : bool = false
  }
  terminal poked

  action Plan()
  action Poke()

  on Plan {
    require !busy else reject "busy"
    busy' = true
    for i in 1..2 {
      spawn Truck as t[i]
    }
  }
  on Poke {
    require busy else reject "idle"
    require !poked else reject "poked"
    poked' = true
    signal t[0] -> Go()
  }
}
