module cmp1

enum Size { Small, Large }
type Box = { size: Size, count: 0..2 }

machine Packer {
  state {
    done : bool = false
    box  : Box  = { size: Small, count: 0 }
  }
  terminal done
  action Seal()
  on Seal {
    require !done else reject "sealed"
    require { size: Small, count: 0 } != box else reject "empty"
    done' = true
  }
}
