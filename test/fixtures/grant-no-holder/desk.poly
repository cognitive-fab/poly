// S457 (PS16.2, PT10g): the runtime's desk. `payments` is a person's credential with no holder named, so it has one
// Grant instance at a time; `reports` is the service's own. The provider is the tests' test-oauth.
module nh

credential payments: oauth2 {
  provider "test-oauth"
  grant authorization_code pkce
  scopes { refunds.write, charges.read }
}

credential reports: oauth2 {
  provider "test-oauth"
  grant client_credentials
  scopes { reports.read }
}

machine Desk {
  state {
    n : 0..2 = 0
  }

  action Refund(amount: 0..2)
  action Report()

  on Refund(amount) {
    require n < 2 else reject "full"
    n' = n + 1
    emit refund(amount: amount)
  }
  on Report {
    require n > 0 else reject "empty"
    n' = 0
    emit report(n: n)
  }

  effect refund(amount: 0..2) {
    kind "payments.refund"
    labels { egress:external }
    targets { egress: "https://api.test-oauth.example/v1/refunds" }
    uses payments { refunds.write }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
  }
  effect report(n: 0..2) {
    kind "reports.fetch"
    labels { egress:external }
    targets { egress: "https://api.test-oauth.example/v1/reports" }
    uses reports { reports.read }
    class none
  }
}
