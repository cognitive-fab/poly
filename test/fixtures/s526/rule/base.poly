// The known-good base of the S526 tests: CLEAN on the tree before the feature. Tests change one clause of the effect.
module s526base

enum Phase { Idle, Working, Done, Failed }

machine Job {
  state { phase : Phase = Idle }
  terminal phase in { Done, Failed }

  action Go()
  action Worked()
  action Gave()

  on Go {
    require phase == Idle else reject "started"
    phase' = Working
    emit work(1)
  }
  on Worked {
    require phase == Working else reject "not-working"
    phase' = Done
  }
  on Gave {
    require phase == Working else reject "not-working"
    phase' = Failed
  }

  effect work(n: 0..1) {
    kind "s526.work"
    labels { egress:external }
    class irreversible
    ok -> Worked()
    failed -> Gave()
  }
}
