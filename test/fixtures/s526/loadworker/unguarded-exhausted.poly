// Variant E: unguarded with explicit exhausted completion observable.
// Default retry (bound 5), no idempotency, no acceptance.
// The exhausted completion is observable, unlike the base which only has ok/failed.
module s526base

enum Phase { Idle, Working, Done, Failed }

machine Job {
  state { phase : Phase = Idle }
  terminal phase in { Done, Failed }

  action Go()
  action Worked()
  action Gave()

  on Go {
    require phase == Idle else reject "started"
    phase' = Working
    emit work(1)
  }
  on Worked {
    require phase == Working else reject "not-working"
    phase' = Done
  }
  on Gave {
    require phase == Working else reject "not-working"
    phase' = Failed
  }

  effect work(n: 0..1) {
    kind "s526.work"
    labels { egress:external }
    class irreversible
    ok -> Worked()
    failed -> Gave()
    exhausted -> Gave()
  }
}
// scan: rule-input
