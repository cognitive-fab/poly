// Safe variant for CONTROL: irreversible effect with at-most-once guarantee via attempts 1.
// This protects the success path: handler succeeds once, Job ends Done.
// (attempts 1 only; the idempotent clause is not used here so that it admits today.)
module s526base

enum Phase { Idle, Working, Done, Failed }

machine Job {
  state { phase : Phase = Idle }
  terminal phase in { Done, Failed }

  action Go()
  action Worked()
  action Gave()

  on Go {
    require phase == Idle else reject "started"
    phase' = Working
    emit work(1)
  }
  on Worked {
    require phase == Working else reject "not-working"
    phase' = Done
  }
  on Gave {
    require phase == Working else reject "not-working"
    phase' = Failed
  }

  effect work(n: 0..1) {
    kind "s526.work"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 200ms, timeout 5s }
    ok -> Worked()
    failed -> Gave()
    exhausted -> Gave()
  }
}
