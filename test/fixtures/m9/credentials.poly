// M9 step 5 (PT10e, S203): a desk that refunds through a merchant's delegated credential, and fetches a report with
// the service's own. The provider is the tests' own, test-oauth, found under the test-only std.
module creds

credential payments: oauth2 {
  provider "test-oauth"
  grant authorization_code pkce
  scopes { refunds.write, charges.read }
  holder Principal
}

credential reports: oauth2 {
  provider "test-oauth"
  grant client_credentials
  scopes { reports.read }
}

machine Desk {
  state {
    n : 0..2 = 0
  }

  action Refund(merchant: Principal, amount: 0..2)
  action Report()
  action Note()

  on Refund(merchant, amount) {
    require n < 2 else reject "full"
    n' = n + 1
    emit refund(merchant: merchant, amount: amount)
  }
  on Report {
    require n > 0 else reject "empty"
    n' = 0
    emit report(n: n)
  }
  on Note {
    require n < 2 else reject "full"
    n' = n + 1
    emit note(n: n)
  }

  effect refund(merchant: Principal, amount: 0..2) {
    kind "payments.refund"
    labels { egress:external }
    targets { egress: "https://api.test-oauth.example/v1/refunds" }
    uses payments { refunds.write } for merchant
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
  }
  effect report(n: 0..2) {
    kind "reports.fetch"
    labels { egress:external }
    targets { egress: "https://api.test-oauth.example/v1/reports" }
    uses reports { reports.read }
    class none
  }
  effect note(n: 0..2) {
    kind "desk.note"
    labels { write:store }
    targets { store: ["notes"] }
    class reversible
  }
}
