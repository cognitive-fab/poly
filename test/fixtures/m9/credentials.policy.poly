// S199, E11 settled by test: a policy reads the field credential the runtime's grant check puts on a proposal. An
// effect proposed without it, the Grant's own revoke, reads it as unknown, and the rule denies it: the engine fails
// closed on a missing field.
module creds_policy

policy grants {
  scope "creds"
  obligation granted-credential "An effect runs only with a granted credential." rule {
    when proposal.kind == "effect"
    require effect.credential.grantState == "Granted" else deny
    on unknown deny
  }
}
