// F4 of the probe review of V1 to V5 (PS13.6, PT3.4a): Send's Go accepts 3, and sends it as Pay's a,
// which Recv's strict domain { 1, 2 } refuses outside-check-domain on delivery. PL5408 in the configuration.
module f4cfg

service machine Recv {
  state { paid : bool = false }
  action Pay(a: int check { 1, 2 })
  on Pay(a) { require !paid else reject "paid"  paid' = true }
}

enum S { Idle, Sent }

machine Send {
  state { s : S = Idle   r : Ref<Recv> = none }
  terminal s == Sent
  action Go(v: int check { 1, 2, 3 })
  on Go(v) { require s == Idle else reject "sent"  s' = Sent  send r <- Pay(a: v) }
}

configuration pair {
  rc : Recv
  sd : Send { r: rc }
  inputs { sd.Go }
  bounds { transit 1 }
  invariant paid-after-send: rc.paid implies sd.s == Sent
}
