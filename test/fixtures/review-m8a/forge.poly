// C-F2 repro: a completion whose Content is the constant none, so the manifest maps no reply field and polyrun's
// fallback spreads the handler's whole reply into the completion's data. A reply carrying $content forges the mark.
module forge

enum Phase { Idle, Waiting, Got, Failed }

machine Fetcher {
  state {
    phase : Phase = Idle
    body  : Content = none
  }
  terminal phase in { Got, Failed }

  action Start()
  action Got(c: Content)
  action Failed()

  on Start {
    require phase is Idle else reject "started"
    phase' = Waiting
    emit fetch()
  }
  on Got(c) {
    require phase is Waiting else reject "stale"
    phase' = Got
    body' = c
  }
  on Failed {
    require phase is Waiting else reject "stale"
    phase' = Failed
  }

  effect fetch() {
    kind "doc.fetch"
    labels { read:web }
    class none
    retry { attempts 1, base 1s, timeout 30s }
    ok -> Got(c: none)
    failed -> Failed()
    exhausted -> Failed()
  }
}
