module samekind

enum Level { Low, High }

machine M {
  state { done : bool = false }
  terminal done
  action Go()
  on Go {
    require !done else reject "done"
    done' = true
    emit notify(level: High)
  }
  effect alert(level: Level) {
    kind "ops.page"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
  }
  effect notify(level: Level) {
    kind "ops.page"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
  }
  never no-alert: emit alert
  never no-high-alert: emit alert(level: High)
}
