// M10 (S323): the concierge with memory, which asks, before it replies, a decision with a finite answer over the
// orders its answer cites: a declassification point the certificate lists. The program is CLEAN, since a finite answer
// carries no taint (PS17.2).
module concierge_memory

audience { public < customer < staff }

claims Customer {
  principal: Principal
}

source orders: records {
  adapter "postgres"
  audience customer owned
  freshness 1h
}

enum Phase { Idle, Looking, Answering, Judging }
enum Verdict { Late, OnTime }

machine Desk {
  state {
    phase    : Phase     = Idle
    customer : Principal = none
    question : Content   = none
    text     : Content   = none
    verdict  : Verdict   = OnTime
  }

  action Ask(question: Content)
  action Found(items: Items)
  action LookupFailed()
  action Answered(text: Content, cites: Items)
  action AnswerFailed()
  action Judged(v: Verdict)
  action JudgeFailed()

  on Ask(question) by c: Customer {
    require phase == Idle else reject "busy"
    phase' = Looking
    customer' = c.principal
    question' = question
    emit lookup(customer: c.principal)
  }

  on Found(items) {
    require phase == Looking else reject "not-looking"
    phase' = Answering
    decide answer(question: question, context: items)
  }

  on LookupFailed {
    require phase == Looking else reject "not-looking"
    phase' = Idle
  }

  on Answered(text, cites) {
    require phase == Answering else reject "not-answering"
    phase' = Judging
    text' = text
    decide late(context: cites)
  }

  on Judged(v) {
    require phase == Judging else reject "not-judging"
    phase' = Idle
    verdict' = v
    emit reply(customer: customer, body: text)
  }

  on JudgeFailed {
    require phase == Judging else reject "not-judging"
    phase' = Idle
  }

  on AnswerFailed {
    require phase == Answering else reject "not-answering"
    phase' = Idle
  }

  effect lookup(customer: Principal) {
    retrieve orders where owner == customer limit 2
    ok(r) -> Found(items: r.items)
    failed -> LookupFailed()
  }

  decision answer(question: Content, context: Items) -> Content {
    provider "flash"
    labels { egress:external, read:private }
    timeout 2s
    cites context
    ok(r) -> Answered(text: r.answer, cites: r.cites)
    failed -> AnswerFailed()
  }

  decision late(context: Items) -> Verdict {
    provider "flash"
    labels { egress:external, read:private }
    timeout 2s
    ok(r) -> Judged(v: r.answer)
    failed -> JudgeFailed()
  }

  effect reply(customer: Principal, body: Content) {
    kind "support.reply"
    labels { egress:external }
    to customer
    audience public
  }
}
