// M10 S322: the desk retrieves every customer's orders and arms a timer with its answer; the timer's firing sends
// the answer to no one in particular at class public, which breaks the flow rule (PS17.1, PS17.3).
module concierge_memory

audience { public < customer < staff }

claims Customer {
  principal: Principal
}

source orders: records {
  adapter "postgres"
  audience customer owned
  freshness 1h
}

enum Phase { Idle, Looking, Answering }

machine Desk {
  state {
    phase    : Phase     = Idle
    customer : Principal = none
    question : Content   = none
  }

  action Ask(question: Content)
  action Found(items: Items)
  action LookupFailed()
  action Answered(text: Content, cites: Items)
  action AnswerFailed()
  action Send(body: Content)

  on Ask(question) by c: Customer {
    require phase == Idle else reject "busy"
    phase' = Looking
    customer' = c.principal
    question' = question
    emit lookup(customer: c.principal)
  }

  on Found(items) {
    require phase == Looking else reject "not-looking"
    phase' = Answering
    decide answer(question: question, context: items)
  }

  on LookupFailed {
    require phase == Looking else reject "not-looking"
    phase' = Idle
  }

  on Answered(text, cites) {
    require phase == Answering else reject "not-answering"
    phase' = Idle
    after 1s -> Send(body: text) as late
  }

  on Send(body) {
    require phase == Idle else reject "early"
    phase' = Looking
    emit reply(customer: none, body: body)
  }

  on AnswerFailed {
    require phase == Answering else reject "not-answering"
    phase' = Idle
  }

  effect lookup(customer: Principal) {
    retrieve orders limit 2
    ok(r) -> Found(items: r.items)
    failed -> LookupFailed()
  }

  decision answer(question: Content, context: Items) -> Content {
    provider "flash"
    labels { egress:external, read:private }
    timeout 2s
    cites context
    ok(r) -> Answered(text: r.answer, cites: r.cites)
    failed -> AnswerFailed()
  }

  effect reply(customer: Principal, body: Content) {
    kind "support.reply"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
    to customer
    audience public
  }
}
