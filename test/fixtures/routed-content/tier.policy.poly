// S402: the control of taint.policy.poly. A policy of the route's scope that does not read the taint: it denies only
// the large tier, so the small tier answers a body of class customer.
module tier_policy

policy tier {
  scope "desk.triage"
  obligation no-large "The large tier is not asked." rule {
    when effect.kind == "route.triage.call" && effect.route.tier == "large"
    require false else deny
    on unknown deny
  }
}
