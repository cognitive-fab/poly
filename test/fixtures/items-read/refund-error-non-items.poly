// S462, PT10j: `one p` naming a parameter that is not Items is PL1201.
module refund_desk

audience { public < customer < staff }

claims Customer {
  principal: Principal
}

source orders: records {
  adapter "postgres"
  audience customer owned
  freshness 1h
  keys { order }
}

enum Phase { Idle, Looking, Answering }

machine Desk {
  state {
    phase    : Phase     = Idle
    customer : Principal = none
  }

  action Ask()
  action Answered()

  on Ask() by c: Customer {
    phase' = Answering
  }

  on Answered() {
    phase' = Idle
  }

  effect refund(customer: Principal) {
    one customer
    kind "support.refund"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
    to customer
    audience public
  }
}
