// S463, PS15.5: Extra ends the application while the answer is pending; the answer's completion then reaches an ended application and is rejected terminal, which leaves nothing waiting.
module rc

channel support: test {
  adapter "test"
  thread "{from}"
  starts Agent.Start on inbound
  Message -> Agent.Got
  Delivered -> Agent.Delivered
  Rejected -> Agent.SendRejected
  Failed -> Agent.SendFailed
}

enum Phase { Idle, Asking, Replied, Done }

service machine Agent {
  state {
    phase   : Phase = Idle
    started : bool  = false
  }
  terminal phase == Done

  action Start()
  action Got(body: Content)
  action Answered(answer: Content, conf: Conf)
  action AnswerFailed()
  action Extra(answer: Content)
  action ExtraFailed()
  action Delivered()
  action SendRejected(reason: string check { "window-closed" })
  action SendFailed()

  on Start {
    require !started else reject "started"
    started' = true
  }
  on Got(body) {
    require phase is Idle else reject "busy"
    phase' = Asking
    decide answer(question: body)
    decide extra(question: body)
  }
  on Answered(answer, conf) {
    require phase is Asking else reject "not-asking"
    if conf >= 0.5 {
      phase' = Replied
      emit support.reply(body: answer)
    } else {
      phase' = Done
    }
  }
  on Extra(answer) {
    phase' = Done
  }
  on ExtraFailed {
    phase' = Done
  }
  on AnswerFailed {
    require phase is Asking else reject "not-asking"
    phase' = Done
  }
  on Delivered {
    require started else reject "not-started"
  }
  on SendRejected(reason) {
    require started else reject "not-started"
  }
  on SendFailed {
    require started else reject "not-started"
  }

  decision extra(question: Content) -> Content {
    provider "flash"
    labels { egress:external }
    timeout 2s
    ok(r) -> Extra(answer: r.answer)
    failed -> ExtraFailed()
  }

  decision answer(question: Content) -> Content {
    provider "flash"
    labels { egress:external }
    timeout 2s
    ok(r) -> Answered(answer: r.answer, conf: r.conf)
    failed -> AnswerFailed()
  }
}
