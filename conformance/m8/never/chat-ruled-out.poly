// S178, PS5.2a: a witness that needs an environment nothing provides. Alone, Reply can arrive in any state, so Chat
// sends from a closed window at once; Reply is a message only App sends, so that witness is marked
// environment: unconstrained. In the configuration App replies only to a Message, which Chat sends when the window
// opens. Before S206 nothing closed it again there (Expired is a timer's completion, and the configuration did not fire
// timers), so the witness was ruled out. Since S206 the timer fires in every configuration (PS15.5): the window can
// close before the reply, the witness is reached, and it is a finding (ruled 2026-10-06). The ruled-out case without a
// timer is test/fixtures/m9/chat-ruled-out-plain.poly.
module chat

enum Window { Closed, Open }
enum Kind { FreeForm, Templated }

service machine Chat {
  state {
    window : Window = Closed
    app    : Ref<App> = none
    sent   : bool = false
  }

  action Inbound()
  action Expired()
  action Reply()

  on Inbound {
    require window is Closed else reject "open"
    window' = Open
    after 24h -> Expired() as w
    send app <- Message()
  }
  on Expired {
    require window is Open else reject "closed"
    window' = Closed
  }
  on Reply {
    require !sent else reject "sent"
    sent' = true
    emit send(kind: FreeForm)
  }

  effect send(kind: Kind) {
    kind "chat.send"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
  }

  never free-when-closed: emit send(kind: FreeForm) while window is Closed
}

service machine App {
  state {
    chat    : Ref<Chat> = none
    replied : bool = false
  }

  action Message()

  on Message {
    require !replied else reject "replied"
    replied' = true
    send chat <- Reply()
  }
}

configuration pair {
  chat : Chat { app: app }
  app  : App { chat: chat }
  inputs { chat.Inbound }
  bounds { transit 2 }
}
