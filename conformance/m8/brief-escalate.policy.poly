// M8a step 2 (S164, S173): a policy over AC5's customer-brief that escalates the public post, so its work order is
// issued only after a person's signed approval.
module brief_escalate

policy post-needs-person {
  scope "customer_brief"
  obligation post-person "A person approves the public post." rule {
    when effect.kind == "post_brief"
    require false else escalate
  }
}
