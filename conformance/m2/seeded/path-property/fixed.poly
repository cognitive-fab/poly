// AC3 seed, path property (PL4001): fixed: the Charging status records the charge.
module seeded

enum Status { Open, Charging, Paid }

machine Cart {
  state { status : Status = Open }
  terminal status == Paid
  action Pay()
  action Settled()
  on Pay { require status == Open else reject "not-open"   status' = Charging   emit charge(amount: 10) }
  on Settled { require status == Charging else reject "not-charging"   status' = Paid }
  effect charge(amount: 0..10) {
    kind "payment.charge"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
    ok -> Settled()
  }
  path property charge-once: count("payment.charge") <= 1
}
