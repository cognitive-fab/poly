// Conformance: require, let and arithmetic.
module conf
machine Counter {
  state {
    n    : 0..6 = 0
    last : 0..6 = 0
  }
  action Add(k: 1..3)
  action Reset()
  on Add(k) {
    require n + k <= 6 else reject "too-big"
    let m = n + k
    n' = m
    last' = k * 2
  }
  on Reset {
    require n > 0 else reject "already-zero"
    n' = 0
  }
  invariant last-even: last % 2 == 0
}
