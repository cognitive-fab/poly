// Conformance: records (S25). A record field in the state, a record parameter, a record literal,
// field reads r.f in a handler and a property, and structural equality.
module rec

enum Size { Small, Large }
type Box = { size: Size, count: 0..2 }

machine Packer {
  state {
    done : bool = false
    box  : Box  = { size: Small, count: 0 }
  }
  terminal done

  action Fill(with: Box)
  action Seal()

  on Fill(with) {
    require !done else reject "sealed"
    require with.count > box.count else reject "not-more"
    box' = with
  }
  on Seal {
    require !done else reject "sealed"
    require box != { size: Small, count: 0 } else reject "empty"
    done' = true
  }

  invariant sealed-has-content: done implies (box.count > 0 || box.size == Large)
  step property grows: post.box.count >= pre.box.count
}
