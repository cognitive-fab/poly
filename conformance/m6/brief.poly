// PT10, S166 (M6 step 2): a workflow over a machine. The machine gathers, then posts; the workflow maps each
// effect kind to the agent tool that fulfils it, and derives the run's key from the input's date.
module brief

enum Phase { Idle, Gathering, Posting, Posted }

machine Brief {
  state {
    phase : Phase = Idle
  }

  terminal phase == Posted

  action Start(date: string check { "2026-10-04", "2026-10-05" })
  action Gathered()
  action Done()

  on Start(date) {
    require phase == Idle else reject "busy"
    phase' = Gathering
    emit fetch(1)
  }

  on Gathered {
    require phase == Gathering else reject "not-gathering"
    phase' = Posting
    emit post(1)
  }

  on Done {
    require phase == Posting else reject "not-posting"
    phase' = Posted
  }

  path property one-post: count("brief.post") <= 1

  effect fetch(n: 0..1) {
    kind "brief.fetch"
    labels { read:store }
    class none
    ok -> Gathered()
  }

  effect post(n: 0..1) {
    kind "brief.post"
    labels { egress:external }
    class irreversible
    retry { attempts 1, base 500ms, timeout 30s }
    ok -> Done()
  }
}

workflow daily-brief runs Brief {
  input Start
  key "{date}" where date matches "^\\d{4}-\\d{2}-\\d{2}$"
  tool "brief.fetch" -> github_search_issues why "gather the day's tickets"
  tool "brief.post" -> slack_send target "#cs" why "publish the brief"
}
