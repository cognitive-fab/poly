// PS8.7, S160: a configuration assigns its instances different trust scopes, so the send between them crosses the
// gate. The configuration check explores allow, deny and escalate; a deny delivers SendDenied to the sender.
module xs

service machine Receiver {
  state { got : 0..1 = 0 }
  action Got()
  on Got {
    require got == 0 else reject "again"
    got' = 1
  }
}

service machine Sender {
  state {
    sent   : 0..1 = 0
    denied : bool = false
    peer   : Ref<Receiver> = none
  }
  action Send()
  action SendDenied(to: string check { "r" }, action: string check { "Got" }, reason: string check { "denied", "escalation-timeout" })
  on Send {
    require sent == 0 else reject "sent"
    sent' = 1
    send peer <- Got()
  }
  on SendDenied(to, action, reason) {
    denied' = true
  }
}

configuration split {
  s : Sender { peer: r } scope "front"
  r : Receiver scope "back"
  inputs { s.Send }
  bounds { transit 2 }
  invariant never-denied: s.denied == false
}
